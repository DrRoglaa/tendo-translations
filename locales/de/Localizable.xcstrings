    "tendoOnboardingStart5GetsYouMovingWhenYouKnowWhatTo": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start 5 gets you moving when you know what to do. What Fits Now helps you choose. I'm Stuck turns a blocked task into one physical next move. Welcome Back remembers your place after an interruption."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "5 starten bringt dich in Bewegung, wenn du weißt, was zu tun ist. Was passt jetzt hilft bei der Auswahl. Ich stecke fest macht aus einer blockierten Aufgabe eine konkrete nächste Handlung. Willkommen zurück merkt sich deinen Stand nach einer Unterbrechung."
          }
        }
      }
    },
    "tendoOnboardingStartFor5Minutes": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start for 5 minutes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für 5 Minuten starten"
          }
        }
      }
    },
    "tendoOnboardingStartSmallFocusGently": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start small. Focus gently."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein anfangen. Sanft fokussieren."
          }
        }
      }
    },
    "tendoOnboardingStartWith5MinutesChooseAGentle155Or": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, choose Soft ambient or Gentle rain, or use optional pink, white, or brown noise. If other audio starts, Tendo sound steps aside."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit 5 Minuten, wähle sanfte 15 / 5 oder klassische 25 / 5 und pausiere bei Bedarf. Mit Live-Aktivitäten und Apple Watch bleibt deine Sitzung sichtbar. Die Fokusumgebung ist standardmäßig still: Behalte deine aktuelle Wiedergabe bei, wähle Sanfte Atmosphäre oder Sanften Regen oder nutze optional rosa, weißes oder braunes Rauschen. Beginnt eine andere Wiedergabe, macht Tendo-Klang Platz."
          }
        }
      }
    },
    "tendoOnboardingStartWithOneRoutineOrganizeMoreWhenYouNeedIt": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one routine. Organize more only when your routine library grows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit einer Routine. Ordne erst mehr, wenn deine Routinenbibliothek wächst."
          }
        }
      }
    },
