    "tendoNotificationsTendoIsAuthorizedButIosIsNotSetToShow": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is authorized, but iOS is not set to show an alert while your iPhone is unlocked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo hat die Berechtigung, aber iOS zeigt bei entsperrtem iPhone keine Hinweise an."
          }
        }
      }
    },
    "tendoNotificationsTendoSchedulesRemindersOnThisIphoneReminderContentIsNot": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo schedules reminders on this iPhone. Reminder content is not sent to a Tendo server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo plant Erinnerungen auf diesem iPhone. Ihr Inhalt wird nicht an einen Tendo-Server gesendet."
          }
        }
      }
    },
    "tendoNotificationsTendoSchedulesRemindersOnThisIphoneTheSelectedSoundIs": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo schedules reminders on this iPhone. The selected sound is used for focus completion, task reminders, transition reminders, and test notifications. Reminder content is not sent to a Tendo server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo plant Erinnerungen auf diesem iPhone. Der gewählte Ton gilt für Fokusende, Aufgaben- und Wechselerinnerungen sowie Testmitteilungen. Erinnerungsinhalte werden nicht an einen Tendo-Server gesendet."
          }
        }
      }
    },
    "tendoNotificationsTendoSchedulesTheseLocallyOnYourDeviceItDoesNot": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo schedules these locally on your device. It does not read your calendar or guess when you should leave."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo plant diese lokal auf deinem Gerät. Es liest weder deinen Kalender noch schätzt es, wann du losgehen solltest."
          }
        }
      }
    },
    "tendoNotificationsTendoTestNotification": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo test notification"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo-Testmitteilung"
          }
        }
      }
    },
    "tendoNotificationsTestSent": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test sent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Test gesendet"
          }
        }
      }
    },
    "tendoNotificationsTheTimeAboveIsWhenTendoSendsThisExactNudge": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time above is when Tendo sends this exact nudge. For example, choose the time you want to see “Leave in 10 minutes” rather than an appointment time and expecting Tendo to calculate travel automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhrzeit oben bestimmt, wann Tendo genau diesen Anstoß sendet. Wähle zum Beispiel die Zeit, zu der du „In 10 Minuten losgehen“ sehen möchtest, statt die Terminzeit einzugeben und eine automatische Reisezeitberechnung zu erwarten."
          }
        }
      }
    },
    "tendoNotificationsThis": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "this"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "dies"
          }
        }
      }
    },
    "tendoNotificationsTransitionRemindersNeedNotificationPermissionYouCanEnableNotificationsIn": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transition reminders need notification permission. You can enable notifications in System Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen an Wechsel benötigen die Mitteilungsberechtigung. Du kannst Mitteilungen in den Systemeinstellungen aktivieren."
          }
        }
      }
    },
    "tendoNotificationsTransitions": {
