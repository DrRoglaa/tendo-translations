    "tendoOnboardingFiveMinutesIsEnoughToBeginOtherAudioAlwaysGets": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes is enough to begin. Other audio always gets priority."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Minuten reichen zum Anfangen. Andere Audiowiedergaben haben immer Vorrang."
          }
        }
      }
    },
    "tendoOnboardingFiveMinutesStillCountsTendoNeverNeedsToKnowWhat": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes still counts. Tendo never needs to know what you are listening to. If you get interrupted, Pick Up Where You Left Off gives you a direct way back, and Welcome Back keeps that return gentle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch fünf Minuten zählen. Tendo muss nie wissen, was du hörst. Wirst du unterbrochen, führt Dort weitermachen, wo du aufgehört hast direkt zurück. Willkommen zurück macht dir diesen Wiedereinstieg leicht."
          }
        }
      }
    },
    "tendoOnboardingFocusInAWayThatFitsYou": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus in a way that fits you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokussiere so, wie es zu dir passt."
          }
        }
      }
    },
