    "tendoGuideExploreIntro": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the next useful feature whenever you need it. No lessons to finish."
