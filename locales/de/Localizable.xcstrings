    "tendoGuideRescueExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a task that fits ten spare minutes or use I’m Stuck for a smaller step."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Aufgabe für zehn freie Minuten oder nutze Ich stecke fest für einen kleineren Schritt."
