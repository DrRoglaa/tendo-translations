    "tendoSettingsWidgetsIntentionallyDoNotReadYourPrivateTaskDatabaseIn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets intentionally do not read your private task database in the current version. They stay useful without requiring shared app-group storage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets lesen in der aktuellen Version bewusst nicht deine private Aufgabendatenbank. Sie bleiben nützlich, ohne gemeinsamen App-Gruppenspeicher zu benötigen."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndCompanion": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments & Companion"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolgsmomente & Begleiter"
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheCompanionStayQuietProgressStillReflects": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the companion stay quiet. Progress still reflects your real activity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolgsmomente und Begleiter bleiben still. Fortschritt spiegelt weiterhin deine tatsächliche Aktivität wider."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheOptionalMomentumCompanionAreLocalPresentation": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the optional Momentum companion are local presentation features. Today's Wins and companion milestones are derived from your existing tasks, Tiny Steps, Focus history, and routines; Tendo does not create a separate XP, currency, streak, or analytics profile. Your companion choice is stored locally and changing it never changes your progress."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolgsmomente und der optionale Schwung-Begleiter sind lokale Darstellungsfunktionen. Heutige Erfolge und Begleitermeilensteine ergeben sich aus deinen vorhandenen Aufgaben, kleinen Schritten, deinem Fokusverlauf und deinen Routinen. Tendo erstellt kein separates Erfahrungs-, Währungs-, Serien- oder Analyseprofil. Deine Begleiterwahl wird lokal gespeichert und verändert deinen Fortschritt nie."
          }
        }
      }
    },
    "tendoSettingsWriteAReview": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a Review"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewertung schreiben"
          }
        }
      }
    },
    "tendoSettingsYesterday": {
      "comment": "Settings interface. Keep terminology consistent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestern"
          }
        }
      }
    },
    "tendoSettingsYouCanPauseOrStopWheneverYouNeedToThe": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pause or stop whenever you need to. The time you already focused still counts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst pausieren oder aufhören, wann immer du musst. Deine bisherige Fokuszeit zählt trotzdem."
          }
        }
      }
    },
    "tendoSettingsYourOptionalPreferredNameIsStoredLocallyByTendoAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your optional preferred name is stored locally by Tendo and is used only to personalize greetings inside the app. It is included only when you choose to create an encrypted local Tendo backup. Tendo does not read your Contacts or Apple Account to obtain your name."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein optionaler Wunschname wird von Tendo lokal gespeichert und nur für persönliche Begrüßungen in der App genutzt. Er wird nur aufgenommen, wenn du ein verschlüsseltes lokales Tendo-Backup erstellst. Tendo liest weder deine Kontakte noch deinen Apple Account, um deinen Namen zu erfahren."
          }
        }
      }
    },
    "tendoSettingsYourOptionalPreferredNameIsStoredOnlyByTendoAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your optional preferred name is stored only by Tendo and is used to personalize the greeting on Now. Leave it blank to keep the standard greeting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein optionaler Wunschname wird nur von Tendo gespeichert und für die persönliche Begrüßung unter Jetzt genutzt. Lass das Feld leer für die Standardbegrüßung."
          }
        }
      }
    },
    "tendoSettingsYourPasswordIsUsedOnlyOnThisDeviceToUnlock": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is used only on this device to unlock the selected backup and is never stored by Tendo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Passwort wird nur auf diesem Gerät zum Entsperren des gewählten Backups verwendet und nie von Tendo gespeichert."
          }
        }
      }
    },
    "tendoSettingsYourTasksRoutinesFocusHistoryTinyStepsAndBrainDump": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, routines, focus history, Tiny Steps, and Brain Dump stay in Tendo’s private local app storage. Apple Watch sharing uses only compact snapshots and actions, not the full SwiftData database."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben, Routinen, Fokusverlauf, kleine Schritte und Gedankenablage bleiben in Tendos privatem lokalen App-Speicher. Für die Apple Watch werden nur kompakte Momentaufnahmen und Aktionen geteilt, nicht die gesamte SwiftData-Datenbank."
          }
        }
      }
    },
    "tendoSettingsYourTendoRecordsStayLocalUnlessYouExplicitlyExportAn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Tendo records stay local unless you explicitly export an encrypted backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tendo-Einträge bleiben lokal, außer du exportierst ausdrücklich ein verschlüsseltes Backup."
          }
        }
      }
    },
    "tendoShortcutsAddAtLeastOneStepToThatRoutineBeforeStarting": {
