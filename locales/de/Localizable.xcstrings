    },
    "tendoGuideRescueSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescue and What Fits Now help you find a workable next move when starting feels difficult."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rettungsmodus und Was passt jetzt helfen dir, einen machbaren nächsten Schritt zu finden, wenn der Anfang schwerfällt."
