    "tendoGentleQuietHoursDetail": {
      "comment": "Gentle interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No gentle reminders are scheduled inside quiet hours. If a daily check-in falls in this window, choose a different time. Matching start and end times mean no quiet window."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Ruhezeiten werden keine sanften Erinnerungen geplant. Fällt ein täglicher Gruß in diesen Zeitraum, wähle eine andere Uhrzeit. Gleiche Start- und Endzeiten bedeuten keine Ruhezeit."
          }
        }
      }
    },
