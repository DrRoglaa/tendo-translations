    "tendoNotificationsTransitionsCanBeHarderThanTheThingItselfPickThe": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transitions can be harder than the thing itself. Pick the exact nudge you want and the exact time you want it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsel können schwerer sein als die Sache selbst. Wähle genau den Anstoß und die Uhrzeit, die dir helfen."
          }
        }
      }
    },
