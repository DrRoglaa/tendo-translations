    "tendoFocusTendoAddsNoSoundOtherAudioIsNeverStoppedJust": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo adds no sound. Other audio is never stopped just because Focus starts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo fügt keinen Klang hinzu. Andere Audiowiedergaben werden durch den Fokusstart niemals gestoppt."
          }
        }
      }
    },
    "tendoFocusTendoNeverPausesAppleMusicSpotifyPodcastsYoutubeOrOther": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
