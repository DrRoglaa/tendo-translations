        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and What Fits Now. Find me a place can suggest a calm opening for a task, while Week helps you spread things out without treating every change like failure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute zeigt feste Zeiten, flexible Zeitfenster und Was passt jetzt. Finde einen Platz schlägt ruhige Lücken für Aufgaben vor. Woche hilft dir, Aufgaben zu verteilen, ohne jede Änderung als Scheitern zu sehen."
          }
        }
      }
    },
    "tendoOnboardingTodayShowsExactTimeAnchorsFlexibleWindowsAndWhatIs": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and what is still available — without turning a changed plan into failure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute zeigt feste Zeiten, flexible Zeitfenster und weiterhin verfügbare Aufgaben – ohne einen geänderten Plan zum Scheitern zu machen."
          }
        }
      }
    },
    "tendoOnboardingTue": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tue"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Di"
          }
        }
      }
    },
    "tendoOnboardingTurnOnOnlyWhatHelpsYouSoftAmbientAndGentle": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only what helps you. Soft ambient and Gentle rain are stored locally in Tendo, pink, white, and brown noise are generated on-device, backups are encrypted locally and never include Apple Calendar or Reminders data, and Tendo does not store listening history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere nur, was dir hilft. Sanfte Atmosphäre und Sanfter Regen sind lokal in Tendo gespeichert; rosa, weißes und braunes Rauschen werden auf dem Gerät erzeugt. Backups werden lokal verschlüsselt und enthalten nie Daten aus Apple Kalender oder Erinnerungen. Tendo speichert keinen Hörverlauf."
          }
        }
      }
    },
    "tendoOnboardingUseBrainDumpWhenYourHeadFeelsNoisyOrYou": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Brain Dump when your head feels noisy or you are worried you will forget something."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die Gedankenablage, wenn dir viel durch den Kopf geht oder du Angst hast, etwas zu vergessen."
          }
        }
      }
    },
    "tendoOnboardingUseNowWhenYouWantCalmGuidanceAClearNext": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Now when you want calm guidance, a clear next step, or a quick five-minute start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Jetzt für ruhige Orientierung, einen klaren nächsten Schritt oder einen schnellen Fünfminutenstart."
          }
        }
      }
    },
    "tendoOnboardingUsePlanTodayForAGentleShortlistFindMeA": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Plan today for a gentle shortlist. Find me a place schedules only inside Tendo; Apple Calendar changes remain a separate, explicit action."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Heute planen für eine lockere Vorauswahl. Finde einen Platz plant nur in Tendo; Änderungen an Apple Kalender bleiben eine separate, ausdrückliche Aktion."
          }
        }
      }
    },
