      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Progress to review your recent wins and Focus history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Fortschritt, um deine letzten Erfolge und deinen Fokusverlauf anzusehen."
