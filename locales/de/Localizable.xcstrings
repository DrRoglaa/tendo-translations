      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo provides actions to pause, resume, or finish the current focus session from Shortcuts, Siri, Spotlight, and supported system surfaces."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo bietet über Kurzbefehle, Siri, Spotlight und unterstützte Systemoberflächen Aktionen zum Pausieren, Fortsetzen und Beenden der aktuellen Fokus-Sitzung."
          }
