      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let Now suggest one manageable action from your current tasks instead of scanning everything at once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dir unter Jetzt eine machbare Handlung aus deinen aktuellen Aufgaben vorschlagen, statt alles auf einmal zu durchsehen."
