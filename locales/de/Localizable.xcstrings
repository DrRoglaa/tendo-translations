    "tendoSettingsCarryForwardTestingTip": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While simulating yesterday, create tasks and schedule them for that day. Leave some unfinished, then switch to the real date or tomorrow and open Today."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle beim Simulieren von gestern Aufgaben und plane sie für diesen Tag. Lass einige offen, wechsle dann zum echten Datum oder zu morgen und öffne Heute."
          }
        }
      }
    },
