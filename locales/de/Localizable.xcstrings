          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ruhigeres Tendo"
          }
        }
      }
    },
    "tendoWhatsNewCarryForwardDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished tasks from an earlier day no longer have to become today’s backlog. Review them and choose what you actually want to carry forward."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unerledigte Aufgaben von einem früheren Tag müssen heute keinen Aufgabenstau mehr bilden. Prüfe sie und wähle, was du wirklich mitnehmen möchtest."
          }
        }
      }
    },
    "tendoWhatsNewCarryForwardTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what comes with you"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, was du mitnimmst"
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an optional morning reminder to start your day with intention, or an evening reflection to review your progress. Choose the times that suit you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte auf Wunsch eine morgendliche Erinnerung ein, um bewusst in den Tag zu starten, oder einen abendlichen Rückblick auf deine Fortschritte. Wähle passende Uhrzeiten."
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning Check-ins & Evening Reflections"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morgendlicher Check-in und abendlicher Rückblick"
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a friendly nudge after 1, 3, or 7 days away from Tendo. Your inactivity countdown resets automatically when you return."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte einen freundlichen Anstoß nach 1, 3 oder 7 Tagen ohne Tendo. Sobald du zurückkehrst, beginnt die Zählung automatisch von vorn."
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Inactivity Reminders"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanfte Erinnerungen bei Inaktivität"
          }
        }
      }
    },
    "tendoWhatsNewGentleQuietHoursDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize quiet hours and manage each reminder individually. Everything is optional, disabled by default, and scheduled locally on your device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe Ruhezeiten an und verwalte jede Erinnerung einzeln. Alles ist optional, standardmäßig deaktiviert und wird lokal auf deinem Gerät geplant."
          }
        }
      }
    },
    "tendoWhatsNewGentleQuietHoursTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
