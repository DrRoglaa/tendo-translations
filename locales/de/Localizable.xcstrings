    "tendoOnboardingNoAccountIsRequiredCalendarRemindersNotificationsWidgetsAppleWatch": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account is required. Calendar, Reminders, notifications, widgets, Apple Watch, and Focus Environment stay optional. Your task data is local-first, encrypted local backups are optional, and Tendo never inspects the song, podcast, audiobook, or video behind the system's generic other-audio signal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst kein Konto. Kalender, Erinnerungen, Mitteilungen, Widgets, Apple Watch und Fokusumgebung bleiben optional. Deine Aufgabendaten werden vorrangig lokal gespeichert, verschlüsselte lokale Backups sind optional. Tendo untersucht nie das Lied, den Podcast, das Hörbuch oder Video hinter dem allgemeinen Systemsignal für andere Audiowiedergaben."
          }
        }
      }
    },
    "tendoOnboardingNoAccountIsRequiredYourTasksRoutinesAndFocusHistory": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account is required. Your tasks, routines, and focus history stay on your device whenever practical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst kein Konto. Deine Aufgaben, Routinen und dein Fokusverlauf bleiben nach Möglichkeit auf deinem Gerät."
          }
        }
      }
    },
    "tendoOnboardingOnboardingProgress": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
