    "tendoOnboardingWhenYourHeadFeelsNoisyDumpItFirstYouCan": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your head feels noisy, dump it first. You can sort and refine things once the pressure is lower. For a few obvious everyday sequences, Tendo can also suggest what may come before or next without adding anything automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dir viel durch den Kopf geht, lege deine Gedanken zuerst ab. Sortieren und verfeinern kannst du sie, wenn der Druck nachlässt. Bei einigen typischen Alltagsabläufen schlägt Tendo auch mögliche vorherige oder nächste Schritte vor, ohne automatisch etwas hinzuzufügen."
          }
        }
      }
    },
