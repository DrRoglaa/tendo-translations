        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Sanfte Erinnerungen oder Mitteilungen & Erinnerungen in den Einstellungen."
          }
        }
      }
    },
    "tendoGuideNotificationsSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional notifications help with check-ins and Focus. Quiet hours protect your downtime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Mitteilungen unterstützen Grüße und Fokus. Ruhezeiten schützen deine Erholung."
