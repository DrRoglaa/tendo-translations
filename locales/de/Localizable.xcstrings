    "tendoOnboardingBrainDumpCapturesThoughtsFirstOneLineBecomesOneItem": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brain Dump captures thoughts first. One line becomes one item; organizing can wait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gedankenablage hält Gedanken zuerst fest. Jede Zeile wird ein Eintrag; Ordnen kann warten."
          }
        }
      }
    },
    "tendoOnboardingBrainDumpPreviewWithThreeCapturedThoughtsAndFollowUp": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brain Dump preview with three captured thoughts and follow-up options for tiny steps, estimates, and due dates"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau der Gedankenablage mit drei erfassten Gedanken und Optionen für kleine Schritte, Zeitschätzungen und Fälligkeiten"
          }
        }
      }
    },
    "tendoOnboardingBrainDumpPreviewWithThreeUnorganizedThoughts": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
