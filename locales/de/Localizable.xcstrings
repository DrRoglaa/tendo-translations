    "tendoGentleInactivityDetail": {
      "comment": "Gentle interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One gentle reminder after the selected number of days without opening Tendo. Returning resets the count. Opens Today."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sanfte Erinnerung, wenn du Tendo die gewählte Anzahl an Tagen nicht geöffnet hast. Bei deiner Rückkehr beginnt die Zählung neu. Öffnet Heute."
          }
        }
      }
    },
