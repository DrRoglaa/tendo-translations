    },
    "tendoWhatsNew131TipsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional contextual tips can be dismissed, turned off, or shown again whenever you choose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Tipps im passenden Kontext kannst du schließen, deaktivieren oder jederzeit wieder anzeigen lassen."
