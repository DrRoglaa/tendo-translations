        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$(taskTitle)@ etwas Aufmerksamkeit geschenkt. Du darfst hier aufhören."
          }
        }
      }
    },
    "tendoCommonYouGaveThisYourAttentionThatMatters": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
