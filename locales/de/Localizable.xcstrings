        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere nur, was dir hilft. Sanfte Atmosphäre sowie rosa, weißes und braunes Rauschen werden lokal erzeugt. Tendo speichert keinen Hörverlauf."
          }
        }
      }
    },
