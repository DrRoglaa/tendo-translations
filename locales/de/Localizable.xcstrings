    "tendoFocusStartWith5MinutesChooseAGentle155Or": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment can stay quiet, keep your own audio, or add optional local background noise. When you stop, Tendo can remember your next tiny step so returning later takes less effort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit 5 Minuten, wähle sanfte 15 / 5 oder klassische 25 / 5 und pausiere bei Bedarf. Mit Live-Aktivitäten und Apple Watch bleibt deine Sitzung sichtbar. Die Fokusumgebung kann still bleiben, deine eigene Wiedergabe beibehalten oder optional lokales Hintergrundrauschen ergänzen. Wenn du aufhörst, kann Tendo deinen nächsten kleinen Schritt merken, damit dir der Wiedereinstieg leichter fällt."
          }
        }
      }
    },
    "tendoFocusStartWith5MinutesChooseAGentle155OrVariant": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, choose Soft ambient, or use optional pink, white, or brown noise. If other audio starts, Tendo sound steps aside."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit 5 Minuten, wähle sanfte 15 / 5 oder klassische 25 / 5 und pausiere bei Bedarf. Mit Live-Aktivitäten und Apple Watch bleibt deine Sitzung sichtbar. Die Fokusumgebung ist standardmäßig still: Behalte deine aktuelle Wiedergabe bei, wähle Sanfte Atmosphäre oder nutze optional rosa, weißes oder braunes Rauschen. Beginnt eine andere Wiedergabe, macht Tendo-Klang Platz."
          }
        }
      }
    },
    "tendoFocusStartWith5MinutesChooseAGentle155OrVariant2": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, or choose optional pink, white, or brown noise. If other audio starts, Tendo noise steps aside."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit 5 Minuten, wähle sanfte 15 / 5 oder klassische 25 / 5 und pausiere bei Bedarf. Mit Live-Aktivitäten und Apple Watch bleibt deine Sitzung sichtbar. Die Fokusumgebung ist standardmäßig still: Behalte deine aktuelle Wiedergabe bei oder wähle optional rosa, weißes oder braunes Rauschen. Beginnt eine andere Wiedergabe, macht Tendo-Rauschen Platz."
          }
        }
      }
    },
