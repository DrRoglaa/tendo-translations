        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits eingeplante Tendo-Aufgaben: %1$(count)lld"
          }
        }
      }
    },
    "tendoCommonTendoWillStopLoadingRemindersAndForgetWhichListsYou": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo will stop loading reminders and forget which lists you selected. Your reminders stay unchanged in Apple Reminders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo lädt keine Erinnerungen mehr und vergisst deine Listenauswahl. Deine Erinnerungen bleiben in Apple Erinnerungen unverändert."
          }
        }
      }
    },
    "tendoCommonThatIsEnoughForNowYouDoNotNeedTo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is enough for now. You do not need to solve the rest yet."
