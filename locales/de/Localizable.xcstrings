    "tendoCommonTendoCanCreateAPasswordProtectedTendobackupFileTheBackup": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can create a password-protected .tendobackup file. The backup is created and encrypted locally on this device. Tendo does not upload, receive, store, or have access to your backup files or backup passwords. Demo/test data, Calendar and Reminders data, system permissions, account information, caches, diagnostics, and transient state are not included. If you export a backup, you choose where the encrypted file is stored or shared using Apple's system interfaces. Tendo cannot recover a backup if the password is lost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo kann eine passwortgeschützte .tendobackup-Datei erstellen. Das Backup wird lokal auf diesem Gerät erstellt und verschlüsselt. Tendo lädt deine Backup-Dateien und Backup-Passwörter weder hoch noch empfängt oder speichert es sie und hat keinen Zugriff darauf. Demo- und Testdaten, Kalender- und Erinnerungsdaten, Systemberechtigungen, Kontoinformationen, Caches, Diagnosedaten und vorübergehende Zustände sind nicht enthalten. Beim Export wählst du über Apples Systemoberflächen, wo die verschlüsselte Datei gespeichert oder geteilt wird. Tendo kann ein Backup bei verlorenem Passwort nicht wiederherstellen."
          }
        }
      }
    },
    "tendoCommonTendoCouldntCompleteTheRestoreSafelyPleaseRestartTendoBefore": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't complete the restore safely. Please restart Tendo before making changes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo konnte die Wiederherstellung nicht sicher abschließen. Starte Tendo neu, bevor du Änderungen vornimmst."
          }
        }
      }
    },
    "tendoCommonTendoCouldntReadTheSelectedBackup": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't read the selected backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo konnte das ausgewählte Backup nicht lesen."
          }
        }
      }
    },
    "tendoCommonTendoCouldntRestoreThisBackupYourExistingDataWasKept": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't restore this backup. Your existing data was kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo konnte dieses Backup nicht wiederherstellen. Deine vorhandenen Daten wurden beibehalten."
          }
        }
      }
    },
    "tendoCommonTendoReadsIncompleteRemindersDueTodayOrEarlierMarkingOne": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo reads incomplete reminders due today or earlier. Marking one done in Tendo completes the original Apple Reminder. Disconnecting never deletes reminders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo liest offene Erinnerungen, die heute oder früher fällig sind. Wenn du eine in Tendo abschließt, wird auch das Original in Apple Erinnerungen abgeschlossen. Beim Trennen werden niemals Erinnerungen gelöscht."
          }
        }
      }
    },
    "tendoCommonTendoTasksAlreadyPlaced": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
