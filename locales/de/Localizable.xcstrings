          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was passt jetzt in \\(.applicationName)"
          }
        }
      }
    },
    "tendoCommonWhen": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
