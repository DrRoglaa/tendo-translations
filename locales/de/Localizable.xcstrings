    "tendoGuideNowExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short reply can be your One Thing even when larger tasks are waiting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Antwort kann deine eine Sache sein, auch wenn größere Aufgaben warten."
          }
        }
      }
    },
    "tendoGuideNowNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Now and choose a small action to start."
