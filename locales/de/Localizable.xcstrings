    "tendoWhatsNew130ConsistentTaskViewsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task rows across Today, Week, and Now have been refined for a more consistent appearance, making everyday planning easier to follow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabenzeilen in Heute, Woche und Jetzt wurden für ein einheitlicheres Erscheinungsbild überarbeitet. So lässt sich die tägliche Planung leichter überblicken."
          }
        }
      }
    },
    "tendoWhatsNew130ConsistentTaskViewsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More Consistent Task Views"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einheitlichere Aufgabenansichten"
          }
        }
      }
    },
    "tendoWhatsNew130FocusTaskFinishDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a Focus session finishes naturally and is linked to a task, Tendo can ask whether you've finished it. Complete the task immediately or keep it open for later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine mit einer Aufgabe verknüpfte Fokus-Sitzung regulär endet, kann Tendo fragen, ob du die Aufgabe erledigt hast. Schließe sie sofort ab oder lass sie für später offen."
          }
        }
      }
    },
    "tendoWhatsNew130FocusTaskFinishTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smarter Focus Completion"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligenterer Fokus-Abschluss"
          }
        }
      }
    },
    "tendoWhatsNew130Subtitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little more support for your everyday routines, with gentler reminders, smarter Focus sessions, and a more consistent planning experience."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas mehr Unterstützung für deine täglichen Routinen, mit sanfteren Erinnerungen, intelligenteren Fokus-Sitzungen und einer einheitlicheren Planung."
          }
        }
      }
    },
    "tendoWhatsNew131GuideDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find short, practical explanations and examples for everyday features in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Einstellungen findest du kurze, praktische Erklärungen und Beispiele zu alltäglichen Funktionen."
          }
        }
      }
    },
