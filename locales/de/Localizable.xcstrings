    "tendoOnboardingWhatShouldTendoCallYou": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should Tendo call you?"
          }
