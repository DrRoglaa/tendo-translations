        }
      }
    },
    "tendoGuideRescueNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try What Fits Now from Today or I’m Stuck from Now."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere Was passt jetzt unter Heute oder Ich stecke fest unter Jetzt."
          }
        }
