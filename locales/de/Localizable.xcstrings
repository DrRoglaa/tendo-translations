    "tendoCommonWhenYourHeadFeelsNoisyDumpItFirstYouCan": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your head feels noisy, dump it first. You can sort and refine things once the pressure is lower."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dir viel durch den Kopf geht, lege deine Gedanken zuerst ab. Sortieren und verfeinern kannst du sie, wenn der Druck nachlässt."
          }
        }
      }
    },
    "tendoCommonWinMoments": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolgsmomente"
          }
        }
      }
    },
    "tendoCommonWinMomentsAreLocalCompletionFeedbackTheyDoNotCreate": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments are local completion feedback. They do not create scores, streaks, profiles, or analytics, and nothing about a Win Moment is sent off-device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolgsmomente sind lokale Rückmeldungen zum Abschluss. Sie erstellen weder Punkte, Serien, Profile noch Analysen. Keine Daten zu Erfolgsmomenten verlassen das Gerät."
          }
        }
      }
    },
    "tendoCommonWinsToday": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
