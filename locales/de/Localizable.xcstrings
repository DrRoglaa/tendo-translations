    "tendoGentlePermissionDetail": {
      "comment": "Gentle interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choices stay on this iPhone. All three reminders are off until you enable them. iOS Focus or Scheduled Summary may delay delivery."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auswahl bleibt auf diesem iPhone. Alle drei Erinnerungen sind aus, bis du sie aktivierst. iOS-Fokus oder die geplante Übersicht können die Zustellung verzögern."
          }
        }
      }
    },
