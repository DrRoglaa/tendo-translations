    "tendoSettingsDisconnectStopsTendoFromUsingCalendarAndForgetsYourSelected": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect stops Tendo from using Calendar and forgets your selected calendars. Apple’s Full Access permission is changed separately in iOS Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Trennen nutzt Tendo den Kalender nicht mehr und vergisst deine Kalenderauswahl. Apples Berechtigung für Vollzugriff wird separat in den iOS-Einstellungen geändert."
          }
        }
      }
    },
