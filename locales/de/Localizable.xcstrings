        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo berücksichtigt deine ausgewählten Kalender erst, wenn du sie verbindest."
          }
        }
      }
    },
    "tendoTasksTendoSuggestsThisFromTheTaskWordingOnDeviceNothing": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo suggests this from the task wording on-device. Nothing is added automatically. A follow-up reminder is scheduled only if you choose it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo schlägt dies anhand der Aufgabenbeschreibung direkt auf deinem Gerät vor. Nichts wird automatisch hinzugefügt. Eine Folgeerinnerung wird nur geplant, wenn du sie auswählst."
          }
        }
      }
    },
    "tendoTasksTendoSuggestsThisFromTheTaskWordingOnDeviceNothingVariant": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo suggests this from the task wording on-device. Nothing is added automatically. Mark this task done and Tendo can also offer a local follow-up reminder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo schlägt dies anhand der Aufgabenbeschreibung direkt auf deinem Gerät vor. Nichts wird automatisch hinzugefügt. Markiere diese Aufgabe als erledigt, dann kann Tendo auch eine lokale Folgeerinnerung anbieten."
          }
        }
      }
    },
