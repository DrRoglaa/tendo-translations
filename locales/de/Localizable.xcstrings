    "tendoMomentumTendoDerivesHomeGrowthFromYourRealTasksTinySteps": {
      "comment": "Momentum interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo derives home growth from your real tasks, Tiny Steps, Focus sessions, and routines. There is no XP, currency, daily quota, or streak to protect. Once a home detail appears, it stays. Demo data never changes your personal Companion Home."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo lässt das Zuhause anhand deiner echten Aufgaben, kleinen Schritte, Fokus-Sitzungen und Routinen wachsen. Es gibt keine Erfahrungspunkte, Währung, Tagesquote oder Serie, die du schützen musst. Einmal erschienene Details bleiben erhalten. Demodaten verändern dein persönliches Begleiterzuhause nie."
          }
        }
      }
    },
    "tendoMomentumTendoDerivesHomeGrowthFromYourRealTasksTinyStepsVariant": {
      "comment": "Momentum interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo derives home growth from your real tasks, Tiny Steps, Focus sessions, and routines. There is no XP, currency, daily quota, or streak to protect. Once a home detail appears, it stays. Demo data never permanently unlocks home details."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo lässt das Zuhause anhand deiner echten Aufgaben, kleinen Schritte, Fokus-Sitzungen und Routinen wachsen. Es gibt keine Erfahrungspunkte, Währung, Tagesquote oder Serie, die du schützen musst. Einmal erschienene Details bleiben erhalten. Demodaten schalten keine Details dauerhaft frei."
          }
        }
      }
    },
