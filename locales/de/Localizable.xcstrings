    "tendoGuideLiveActivitiesExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a Focus session, then check its progress without reopening the timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte eine Fokus-Sitzung und verfolge ihren Fortschritt, ohne den Timer erneut zu öffnen."
