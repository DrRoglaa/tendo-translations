    "tendoSettingsCreatesARealisticSyntheticWeekWith36MixedWorkAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, including follow-up nudge examples, Tiny Steps, three routines, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete Sample Data removes only records created here — your own data is left alone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt eine realistische künstliche Woche mit 36 Arbeits- und Haushaltsaufgaben, darunter Beispiele für Folgeanstöße, kleine Schritte, drei Routinen, verschiedene abgeschlossene und unterbrochene Fokus-Sitzungen und Gedanken in der Gedankenablage. Beispieldaten löschen entfernt nur hier erstellte Einträge. Deine eigenen Daten bleiben erhalten."
          }
        }
      }
    },
    "tendoSettingsCreatesARealisticSyntheticWeekWithRoutineFolders": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, Tiny Steps, 16 routines organized into four folders, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete Sample Data removes only records created here — your own data is left alone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt eine realistische künstliche Woche mit 36 Arbeits- und Haushaltsaufgaben, kleinen Schritten, 16 Routinen in vier Ordnern, verschiedenen abgeschlossenen und unterbrochenen Fokus-Sitzungen und Gedanken in der Gedankenablage. Beispieldaten löschen entfernt nur hier erstellte Einträge. Deine eigenen Daten bleiben erhalten."
          }
        }
      }
    },
