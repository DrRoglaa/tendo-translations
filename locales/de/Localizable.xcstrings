    "tendoWhatsNewCalmerSettingsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings are now organized into focused pages, with clearer status and less scrolling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen sind jetzt auf übersichtlichen Themenseiten organisiert, mit klareren Statusangaben und weniger Scrollen."
