          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolge heute: %1$(count)lld"
          }
        }
      }
    },
    "tendoCommonYouCanCreateAnotherTaskHereAtAnyTimeNew": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can create another task here at any time. New tasks are added automatically while there is room. Swipe left on an available task to delete the Tendo task."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst hier jederzeit eine weitere Aufgabe erstellen. Neue Aufgaben werden automatisch ergänzt, solange Platz ist. Wische auf einer verfügbaren Aufgabe nach links, um sie aus Tendo zu löschen."
          }
        }
      }
    },
    "tendoCommonYouGaveSomeAttentionYouCanStopHere": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You gave %1$(taskTitle)@ some attention. You can stop here."
