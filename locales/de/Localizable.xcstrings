    "tendoWhatsNewCalmerTendoDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks, Task details, Settings, and Focus Live Activities have been refined to feel cleaner and easier to scan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben, Aufgabendetails, Einstellungen und Fokus-Live-Aktivitäten wurden überarbeitet und sind jetzt klarer und leichter zu überblicken."
          }
        }
      }
    },
    "tendoWhatsNewCalmerTendoTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
