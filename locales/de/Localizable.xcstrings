    "tendoWhatsNew132TranslationsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Essential controls now have early translations in seven additional languages. Untranslated text still appears in English."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wichtige Bedienelemente sind erstmals in sieben weiteren Sprachen übersetzt. Noch nicht übersetzte Texte erscheinen weiterhin auf Englisch."
          }
        }
      }
    },
    "tendoWhatsNew132TranslationsTitle": {
