    "tendoSettingsCalendarContext": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar Context"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderkontext"
          }
        }
      }
    },
    "tendoSettingsCalendarContextIsOptionalAppleRequiresFullCalendarAccessTo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar Context is optional. Apple requires Full Calendar Access to read existing events. Find me a place can use busy Calendar events to suggest open time, but it never creates, moves, or deletes Calendar events. Block in Apple Calendar is a separate action and changes only the single Calendar block you explicitly confirm for a Tendo task. There is no automatic task-to-calendar sync. You can disconnect Calendar Context inside Tendo at any time; system permission is managed in iOS Settings. Event details are not copied into Tendo's SwiftData database."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderkontext ist optional. Apple verlangt vollen Kalenderzugriff, um vorhandene Termine zu lesen. Finde einen Platz kann belegte Kalenderzeiten nutzen, um freie Zeit vorzuschlagen, erstellt, verschiebt oder löscht aber nie Kalendertermine. In Apple Kalender blockieren ist eine separate Aktion und ändert nur den einzelnen Kalenderblock, den du ausdrücklich für eine Tendo-Aufgabe bestätigst. Es gibt keine automatische Synchronisierung zwischen Aufgaben und Kalender. Du kannst den Kalenderkontext jederzeit in Tendo trennen; die Systemberechtigung wird in den iOS-Einstellungen verwaltet. Termindetails werden nicht in Tendos SwiftData-Datenbank kopiert."
          }
        }
      }
    },
    "tendoSettingsCalendarNamesAreUsedOnlyToChooseWhatAppearsIn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar names are used only to choose what appears in Tendo. Event details stay in memory and are not copied into SwiftData."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendernamen dienen nur der Auswahl, was in Tendo erscheint. Termindetails bleiben im Arbeitsspeicher und werden nicht in SwiftData kopiert."
          }
        }
      }
    },
    "tendoSettingsCalendarPermission": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
