    "tendoGuideRoutineFoldersExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate Morning and Work routines only when the list becomes hard to scan."
