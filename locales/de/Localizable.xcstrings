    },
    "tendoSettingsTendoIsACalmFocusAndProductivityCompanionBuiltAround": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is a calm focus and productivity companion built around one question: what should I do right now?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ist ein ruhiger Begleiter für Fokus und Produktivität, der sich um eine Frage dreht: Was soll ich genau jetzt tun?"
          }
        }
      }
    },
    "tendoSettingsTendoIsCheckingYourAppleWatchConnection": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is checking your Apple Watch connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo prüft deine Apple Watch-Verbindung."
          }
        }
      }
    },
    "tendoSettingsTendoIsDesignedAroundChallengesSuchAsTaskInitiationOverwhelm": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is designed around challenges such as task initiation, overwhelm, transitions, and losing sight of the next useful action. It keeps the interface small, makes stopping valid, and avoids shame-based streaks or productivity scores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo berücksichtigt Herausforderungen wie Anfangen, Überforderung, Wechsel und das Verlieren des nächsten sinnvollen Schritts aus dem Blick. Die Oberfläche bleibt überschaubar, Aufhören ist erlaubt und auf beschämende Serien oder Produktivitätspunkte wird verzichtet."
          }
        }
      }
    },
    "tendoSettingsTendoIsIndependentlyBuiltAndShapedByThePeopleWho": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is independently built and shaped by the people who use it. Sharing feedback, joining the community, leaving a review, or simply telling someone about Tendo all help it grow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo wird unabhängig entwickelt und von seinen Nutzerinnen und Nutzern mitgestaltet. Rückmeldungen, die Teilnahme an der Community, Bewertungen oder einfach eine Empfehlung helfen Tendo beim Wachsen."
          }
        }
      }
    },
