    "tendoSettingsFollowUpNudgesUseASmallSetOfOnDevice": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow-up nudges use a small set of on-device rules to recognize obvious everyday task sequences, such as laundry or the dishwasher. Tendo may suggest a likely earlier or next step, but it never assumes the step happened and never creates a task or reminder until you choose it. Task wording is not sent anywhere for this feature."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgeanstöße erkennen mit wenigen Regeln auf dem Gerät typische Alltagsabläufe, etwa Wäsche oder Spülmaschine. Tendo kann einen wahrscheinlichen vorherigen oder nächsten Schritt vorschlagen, nimmt ihn aber nie als erledigt an und erstellt Aufgaben oder Erinnerungen erst nach deiner Auswahl. Der Aufgabentext wird dafür nirgendwohin gesendet."
          }
        }
      }
    },
