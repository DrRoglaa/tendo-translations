    "tendoFocusTurnOnOnlyWhatHelpsYouPinkWhiteAndBrown": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only what helps you. Pink, white, and brown noise are generated locally, and Tendo does not store listening history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere nur, was dir hilft. Rosa, weißes und braunes Rauschen werden lokal erzeugt. Tendo speichert keinen Hörverlauf."
          }
        }
      }
    },
    "tendoFocusTurnOnOnlyWhatHelpsYouSoftAmbientAndPink": {
