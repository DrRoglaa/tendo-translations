        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendertermine mit Status Beschäftigt und Tendo-Aufgaben mit genauer Uhrzeit zählen als belegt. Ganztägige Termine und als Frei markierte Termine blockieren den Tag nicht."
          }
        }
