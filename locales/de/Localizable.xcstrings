      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look back on completed tasks, Focus sessions, and small wins without daily targets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blicke auf abgeschlossene Aufgaben, Fokus-Sitzungen und kleine Erfolge zurück, ohne tägliche Ziele."
