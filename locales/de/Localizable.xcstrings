    "tendoFocusFiveFocusedMinutesBecameRealProgress": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five focused minutes became real progress."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus fünf Minuten Fokus wurde echter Fortschritt."
          }
        }
      }
    },
    "tendoFocusFiveMinutesStillCountsIfSoundHelpsFocusEnvironmentCan": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes still counts. If sound helps, Focus Environment can add pink, white, or brown noise without stopping your music or podcast. If you get interrupted, Pick Up Where You Left Off helps you return without rebuilding the whole plan in your head."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch fünf Minuten zählen. Wenn dir Klang hilft, kann die Fokusumgebung rosa, weißes oder braunes Rauschen ergänzen, ohne deine Musik oder deinen Podcast zu stoppen. Nach einer Unterbrechung hilft Dort weitermachen, wo du aufgehört hast beim Wiedereinstieg, ohne den ganzen Plan im Kopf neu aufzubauen."
          }
        }
      }
    },
    "tendoFocusFocusDurationSelectedminutesMinutes": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus duration, \\(selectedMinutes) minutes"
          }
        },
