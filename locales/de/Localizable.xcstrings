      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task can have notes, an icon, a next tiny step, timing, and follow-up actions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufgabe kann Notizen, ein Symbol, einen nächsten kleinen Schritt, eine Zeitplanung und Folgeaktionen haben."
