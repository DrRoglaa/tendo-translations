    "tendoCommonTryStart5WhenYouKnowWhatToDoWhat": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Start 5 when you know what to do, What Fits Now when you need guidance, and I'm Stuck when the first step feels blocked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze 5 starten, wenn du weißt, was zu tun ist, Was passt jetzt, wenn du Orientierung brauchst, und Ich stecke fest, wenn der erste Schritt blockiert scheint."
          }
        }
      }
    },
    "tendoCommonTurnOnOnlyTheIntegrationsThatHelpYouYouCan": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only the integrations that help you. You can change everything later in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere nur die Verbindungen, die dir helfen. Du kannst später alles in den Einstellungen ändern."
          }
        }
      }
    },
    "tendoCommonTurningCalendarContextOffImmediatelyStopsTendoFromLoadingCalendar": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning Calendar Context off immediately stops Tendo from loading calendar events. Apple’s system permission is managed separately in iOS Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Kalenderkontext ausschaltest, lädt Tendo sofort keine Kalendertermine mehr. Apples Systemberechtigung wird separat in den iOS-Einstellungen verwaltet."
          }
        }
      }
    },
