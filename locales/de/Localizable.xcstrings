    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIoss": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated noise can step aside. If other audio begins, Tendo fades or stops its own noise and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fokusumgebung ist optional und kostenlos. Tendo kann das allgemeine iOS-Signal für andere aktive Audiowiedergaben nutzen, damit sein selbst erzeugtes Rauschen Platz macht. Beginnt eine andere Wiedergabe, blendet Tendo sein Rauschen aus oder stoppt es. Danach startet es nicht automatisch erneut. Tendo weiß nicht, welche App, welches Lied, welcher Podcast, welches Hörbuch oder Video läuft, und speichert oder überträgt keinen Hörverlauf. Rosa, weißes und braunes Rauschen werden lokal erzeugt. Tendo aktiviert seine Audiositzung nur, während es Klang erzeugt."
          }
        }
      }
    },
    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIossVariant": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated sound can step aside. If other audio begins, Tendo fades or stops its own sound and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Soft ambient and pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fokusumgebung ist optional und kostenlos. Tendo kann das allgemeine iOS-Signal für andere aktive Audiowiedergaben nutzen, damit sein selbst erzeugter Klang Platz macht. Beginnt eine andere Wiedergabe, blendet Tendo seinen Klang aus oder stoppt ihn. Danach startet er nicht automatisch erneut. Tendo weiß nicht, welche App, welches Lied, welcher Podcast, welches Hörbuch oder Video läuft, und speichert oder überträgt keinen Hörverlauf. Sanfte Atmosphäre sowie rosa, weißes und braunes Rauschen werden lokal erzeugt. Tendo aktiviert seine Audiositzung nur, während es Klang erzeugt."
          }
        }
      }
    },
    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIossVariant2": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated sound can step aside. If other audio begins, Tendo fades or stops its own sound and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Soft ambient, Gentle rain, and pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fokusumgebung ist optional und kostenlos. Tendo kann das allgemeine iOS-Signal für andere aktive Audiowiedergaben nutzen, damit sein selbst erzeugter Klang Platz macht. Beginnt eine andere Wiedergabe, blendet Tendo seinen Klang aus oder stoppt ihn. Danach startet er nicht automatisch erneut. Tendo weiß nicht, welche App, welches Lied, welcher Podcast, welches Hörbuch oder Video läuft, und speichert oder überträgt keinen Hörverlauf. Sanfte Atmosphäre, sanfter Regen sowie rosa, weißes und braunes Rauschen werden lokal erzeugt. Tendo aktiviert seine Audiositzung nur, während es Klang erzeugt."
          }
        }
      }
    },
