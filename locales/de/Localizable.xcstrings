    "tendoFocusEnvironmentDefaultVolumeExplanation": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New installs start at %1$(text)@. This controls only Tendo's Focus Environment sound; your iPhone volume still controls the overall output. Tendo sound never starts automatically unless you turn this option on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Neuinstallationen ist %1$(text)@ voreingestellt. Dies steuert nur den Klang der Fokusumgebung in Tendo; die iPhone-Lautstärke bestimmt weiterhin die Gesamtausgabe. Tendo-Klänge starten nur automatisch, wenn du diese Option aktivierst."
          }
        }
      }
    },
