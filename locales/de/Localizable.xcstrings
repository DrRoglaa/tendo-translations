    "tendoCommonWhatFitsNow": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Fits Now"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was passt jetzt"
          }
        }
      }
    },
    "tendoCommonWhatFitsNowCanSuggestABestFitAQuick": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Fits Now can suggest a best fit, a quick win, and a stretch option. Rescue Mode helps when you know the task but feel stuck. Lock Screen actions can jump you straight in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was passt jetzt kann dir eine passende Aufgabe, einen schnellen Erfolg und eine anspruchsvollere Option vorschlagen. Der Rettungsmodus hilft, wenn du die Aufgabe kennst, aber feststeckst. Über Aktionen auf dem Sperrbildschirm kannst du direkt loslegen."
          }
        }
      }
    },
    "tendoCommonWhatFitsNowInApplicationname": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
