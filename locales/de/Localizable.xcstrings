      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect stops Tendo from using Reminders and forgets your selected lists. Apple’s Full Access permission is changed separately in iOS Settings."
          }
        },
        "de": {
