    "tendoSettingsChooseARhythmThatFeelsRealisticToBeginThenAdjust": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a rhythm that feels realistic to begin, then adjust the environment and reminders when you need them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
