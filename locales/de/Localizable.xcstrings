          "stringUnit": {
            "state": "translated",
            "value": "Five minutes still counts. If you get interrupted, Pick Up Where You Left Off helps you return without rebuilding the whole plan in your head."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch fünf Minuten zählen. Wenn du unterbrochen wirst, hilft dir „Dort weitermachen, wo du aufgehört hast“, zurückzufinden, ohne den ganzen Plan neu zusammenzusetzen."
          }
        }
      }
    },
    "tendoCommonFiveMinutesStillCountsTendoIsDesignedToHelpYou": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes still counts. Tendo is designed to help you begin, not punish you for stopping."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch fünf Minuten zählen. Tendo hilft dir beim Anfangen, statt dich fürs Aufhören zu bestrafen."
          }
        }
      }
    },
    "tendoCommonFlexible": {
      "comment": "Common action, label, or status. Keep terminology consistent.",
      "extractionState": "manual",
      "localizations": {
