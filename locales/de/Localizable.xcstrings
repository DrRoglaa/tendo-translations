    "tendoSettingsTendoDoesNotDiagnoseTreatOrCureAdhdOrAny": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo does not diagnose, treat, or cure ADHD or any other health condition. It is a productivity and focus tool designed with ADHD-related challenges in mind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo diagnostiziert, behandelt oder heilt weder ADHS noch andere Erkrankungen. Es ist ein Produktivitäts- und Fokuswerkzeug, das Herausforderungen im Zusammenhang mit ADHS berücksichtigt."
          }
        }
      }
    },
    "tendoSettingsTendoDoesNotRequireAnAccountTasksRoutinesFocusHistory": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo does not require an account. Tasks, routines, focus history, and other personal productivity information stay on your device whenever practical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo erfordert kein Konto. Aufgaben, Routinen, Fokusverlauf und andere persönliche Produktivitätsdaten bleiben nach Möglichkeit auf deinem Gerät."
          }
        }
      }
    },
    "tendoSettingsTendoIntegration": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
