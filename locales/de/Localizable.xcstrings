    "tendoCommonChooseSomethingBelowTendoWillKeepThePlanSmallThree": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose something below. Tendo will keep the plan small — three things at most."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle etwas unten aus. Tendo hält den Plan klein – höchstens drei Dinge."
          }
        }
      }
    },
    "tendoCommonChooseUpTo3OpenTasksTapOneToKeep": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose up to 3 open tasks. Tap one to keep it in view, then give it a loose part of the day if that helps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle bis zu drei offene Aufgaben. Tippe auf eine, um sie im Blick zu behalten, und ordne ihr bei Bedarf einen ungefähren Tagesabschnitt zu."
          }
        }
      }
    },
    "tendoCommonChooseUpTo3OpenTasksUnscheduledOrAlreadyOn": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose up to 3 open tasks — unscheduled or already on Today. Exact-time anchors stay fixed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle bis zu drei offene Aufgaben – ungeplant oder bereits unter Heute. Aufgaben mit fester Uhrzeit bleiben unverändert."
          }
        }
      }
    },
    "tendoCommonChooseUpToThreeFlexibleTasksToKeepInView": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
