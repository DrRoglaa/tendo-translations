    "tendoProgressThisResetsWhatProgressAndYourCompanionCountFromNow": {
      "comment": "Progress interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This resets what Progress and your companion count from now on. Your existing tasks, routines, focus history, and other Tendo data stay intact."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies setzt zurück, was Fortschritt und dein Begleiter ab jetzt zählen. Deine Aufgaben, Routinen, dein Fokusverlauf und andere Tendo-Daten bleiben erhalten."
          }
        }
      }
    },
    "tendoProgressThisResetsYourProgressAndCompanionProgressFromThisPoint": {
