    "tendoCommonDisconnectClearsTendosCalendarSelectionsAndStopsCalendarContextTo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect clears Tendo’s calendar selections and stops Calendar Context. To revoke Apple’s permission completely, use Manage Calendar permission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Trennen werden Tendos Kalenderauswahlen gelöscht und der Kalenderkontext deaktiviert. Um die Apple-Berechtigung vollständig zu widerrufen, öffne „Kalenderberechtigung verwalten“."
          }
        }
      }
    },
    "tendoCommonDisconnectStopsTendoFromUsingRemindersAndForgetsYourSelected": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect stops Tendo from using Reminders and forgets your selected lists. iOS may still show Full Access until you revoke the system permission in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Trennen greift Tendo nicht mehr auf Erinnerungen zu und vergisst die ausgewählten Listen. iOS kann weiterhin „Vollzugriff“ anzeigen, bis du die Berechtigung in den Einstellungen widerrufst."
          }
        }
      }
    },
    "tendoCommonDisconnectingStopsTendoFromReadingCalendarAndClearsItsCalendar": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting stops Tendo from reading Calendar and clears its calendar selections. iOS permission itself can only be revoked in System Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Trennen liest Tendo den Kalender nicht mehr und löscht die Kalenderauswahl. Die iOS-Berechtigung kannst du nur in den Systemeinstellungen widerrufen."
          }
        }
      }
    },
