        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo nije mogao otključati ovu sigurnosnu kopiju. Provjerite lozinku i pokušajte ponovno. Ako je lozinka ispravna, datoteka je možda oštećena. Trenutačni podaci nisu promijenjeni."
          }
        }
      }
    },
