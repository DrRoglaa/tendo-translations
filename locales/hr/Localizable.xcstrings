    "tendoWhatsNew130ConsistentTaskViewsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task rows across Today, Week, and Now have been refined for a more consistent appearance, making everyday planning easier to follow."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redci zadataka u prikazima Danas, Tjedan i Sada dotjerani su radi ujednačenijeg izgleda kako bi svakodnevno planiranje bilo preglednije."
          }
        }
      }
    },
    "tendoWhatsNew130ConsistentTaskViewsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
