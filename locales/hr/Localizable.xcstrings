        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo će odmah prestati koristiti podsjetnike i zaboraviti odabrane popise. Appleovo dopuštenje za puni pristup mijenja se zasebno u Postavkama sustava iOS."
          }
