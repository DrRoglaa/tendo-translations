    "tendoOnboardingStart5GetsYouMovingWhenYouKnowWhatTo": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start 5 gets you moving when you know what to do. What Fits Now helps you choose. I'm Stuck turns a blocked task into one physical next move. Welcome Back remembers your place after an interruption."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreni 5 pokreće vas kad znate što učiniti. Što sada odgovara pomaže pri izboru. Zapelo mi je pretvara blokiran zadatak u sljedeći konkretan pokret. Dobro došli natrag pamti vaše mjesto nakon prekida."
          }
        }
      }
    },
    "tendoOnboardingStartFor5Minutes": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start for 5 minutes"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreni na 5 minuta"
          }
        }
      }
    },
    "tendoOnboardingStartSmallFocusGently": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start small. Focus gently."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počnite malim korakom. Usredotočite se blago."
          }
        }
      }
    },
    "tendoOnboardingStartWith5MinutesChooseAGentle155Or": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, choose Soft ambient or Gentle rain, or use optional pink, white, or brown noise. If other audio starts, Tendo sound steps aside."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počnite s 5 minuta, odaberite lagani ritam 15 / 5 ili klasični 25 / 5 i zastanite kad trebate. Sesija ostaje vidljiva uz aktivnosti uživo i podršku za Apple Watch. Okruženje za fokus zadano je tiho: zadržite trenutačni zvuk, odaberite Blagi ambijent ili Nježnu kišu ili koristite neobavezan ružičasti, bijeli ili smeđi šum. Ako počne drugi zvuk, zvuk aplikacije Tendo prepušta mu prostor."
          }
        }
      }
    },
    "tendoOnboardingStartWithOneRoutineOrganizeMoreWhenYouNeedIt": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one routine. Organize more only when your routine library grows."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počnite jednom rutinom. Organizirajte više tek kad zbirka rutina naraste."
          }
        }
      }
    },
