    "tendoOnboardingTodayPreviewShowingOneExactAppointmentAndOneFlexibleTask": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today preview showing one exact appointment and one flexible task"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregled prikaza Danas s jednim točnim terminom i jednim fleksibilnim zadatkom"
          }
        }
      }
    },
    "tendoOnboardingTodayShowsExactTimeAnchorsFlexibleWindowsAndWhatFits": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and What Fits Now. Find me a place can suggest a calm opening for a task, while Week helps you spread things out without treating every change like failure."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Danas prikazuje točne termine, fleksibilne okvire i Što sada odgovara. Pronađi mi mjesto može predložiti mirnu prazninu za zadatak, dok Tjedan pomaže rasporediti stvari bez doživljavanja svake promjene kao neuspjeha."
          }
        }
      }
    },
    "tendoOnboardingTodayShowsExactTimeAnchorsFlexibleWindowsAndWhatIs": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and what is still available — without turning a changed plan into failure."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Danas prikazuje točne termine, fleksibilne okvire i ono što je još dostupno — bez pretvaranja promijenjenog plana u neuspjeh."
          }
        }
      }
    },
    "tendoOnboardingTue": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tue"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uto"
          }
        }
      }
    },
    "tendoOnboardingTurnOnOnlyWhatHelpsYouSoftAmbientAndGentle": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only what helps you. Soft ambient and Gentle rain are stored locally in Tendo, pink, white, and brown noise are generated on-device, backups are encrypted locally and never include Apple Calendar or Reminders data, and Tendo does not store listening history."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite samo ono što vam pomaže. Blagi ambijent i Nježna kiša pohranjeni su lokalno u aplikaciji Tendo, ružičasti, bijeli i smeđi šum stvaraju se na uređaju, sigurnosne kopije šifriraju se lokalno i nikad ne uključuju podatke Appleova Kalendara ili Podsjetnika, a Tendo ne pohranjuje povijest slušanja."
          }
        }
      }
    },
    "tendoOnboardingUseBrainDumpWhenYourHeadFeelsNoisyOrYou": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Brain Dump when your head feels noisy or you are worried you will forget something."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite Istresanje misli kad vam je u glavi bučno ili se bojite da ćete nešto zaboraviti."
          }
        }
      }
    },
    "tendoOnboardingUseNowWhenYouWantCalmGuidanceAClearNext": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Now when you want calm guidance, a clear next step, or a quick five-minute start."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite Sada kad želite mirne smjernice, jasan sljedeći korak ili brz petominutni početak."
          }
        }
      }
    },
    "tendoOnboardingUsePlanTodayForAGentleShortlistFindMeA": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Plan today for a gentle shortlist. Find me a place schedules only inside Tendo; Apple Calendar changes remain a separate, explicit action."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite Isplaniraj danas za blag uži izbor. Pronađi mi mjesto raspoređuje samo unutar aplikacije Tendo; promjene Appleova Kalendara ostaju zasebna, izričita radnja."
          }
        }
      }
    },
