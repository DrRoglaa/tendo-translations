    "tendoTodayCarryForwardSheetDetail": {
      "comment": "Today interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing a day shouldn't turn into a backlog. Choose only what feels doable now. Anything you leave out stays safely in Tasks."
          }
