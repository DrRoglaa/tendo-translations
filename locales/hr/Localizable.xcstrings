      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clearer folder hierarchy, folder icons and counts, calmer routine rows, and a dedicated Other routines section make larger libraries easier to scan."
          }
