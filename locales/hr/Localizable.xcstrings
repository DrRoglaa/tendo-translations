      }
    },
    "tendoSettingsTendoDoesNotDiagnoseTreatOrCureAdhdOrAny": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo does not diagnose, treat, or cure ADHD or any other health condition. It is a productivity and focus tool designed with ADHD-related challenges in mind."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ne dijagnosticira, liječi ni izlječuje ADHD ili drugo zdravstveno stanje. To je alat za produktivnost i fokus osmišljen uz uvažavanje izazova povezanih s ADHD-om."
          }
        }
      }
    },
    "tendoSettingsTendoDoesNotRequireAnAccountTasksRoutinesFocusHistory": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo does not require an account. Tasks, routines, focus history, and other personal productivity information stay on your device whenever practical."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ne zahtijeva račun. Zadaci, rutine, povijest fokusa i ostali osobni podaci produktivnosti ostaju na vašem uređaju kad god je praktično."
          }
        }
      }
    },
    "tendoSettingsTendoIntegration": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo integration"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezivanje Tendo"
          }
        }
      }
    },
    "tendoSettingsTendoIsACalmFocusAndProductivityCompanionBuiltAround": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is a calm focus and productivity companion built around one question: what should I do right now?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo je miran pratitelj fokusa i produktivnosti usmjeren na jedno pitanje: što bih trebao učiniti upravo sada?"
          }
        }
      }
    },
    "tendoSettingsTendoIsCheckingYourAppleWatchConnection": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is checking your Apple Watch connection."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo provjerava vezu s Apple Watchom."
          }
        }
      }
    },
    "tendoSettingsTendoIsDesignedAroundChallengesSuchAsTaskInitiationOverwhelm": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is designed around challenges such as task initiation, overwhelm, transitions, and losing sight of the next useful action. It keeps the interface small, makes stopping valid, and avoids shame-based streaks or productivity scores."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo je osmišljen oko izazova poput započinjanja zadataka, preplavljenosti, prijelaza i gubitka iz vida sljedeće korisne radnje. Sučelje ostaje jednostavno, zaustavljanje je valjano i nema nizova temeljenih na posramljivanju ni bodova produktivnosti."
          }
        }
      }
    },
    "tendoSettingsTendoIsIndependentlyBuiltAndShapedByThePeopleWho": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is independently built and shaped by the people who use it. Sharing feedback, joining the community, leaving a review, or simply telling someone about Tendo all help it grow."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo se razvija neovisno i oblikuju ga ljudi koji ga koriste. Povratne informacije, pridruživanje zajednici, recenzija ili jednostavno preporuka pomažu mu rasti."
          }
        }
      }
    },
