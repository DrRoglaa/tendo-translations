      }
    },
    "tendoFocusFiveMinutesStillCountsIfSoundHelpsFocusEnvironmentCan": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes still counts. If sound helps, Focus Environment can add pink, white, or brown noise without stopping your music or podcast. If you get interrupted, Pick Up Where You Left Off helps you return without rebuilding the whole plan in your head."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "I pet minuta se računa. Ako zvuk pomaže, okruženje za fokus može dodati ružičasti, bijeli ili smeđi šum bez zaustavljanja glazbe ili podcasta. Ako vas nešto prekine, Nastavi gdje ste stali pomaže pri povratku bez ponovnog slaganja cijelog plana u glavi."
          }
        }
      }
    },
    "tendoFocusFocusDurationSelectedminutesMinutes": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus duration, \\(selectedMinutes) minutes"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajanje fokusa, \\(selectedMinutes) minuta"
          }
        }
      }
    },
    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIoss": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated noise can step aside. If other audio begins, Tendo fades or stops its own noise and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okruženje za fokus neobavezno je i besplatno. Tendo može koristiti opći signal sustava iOS da se reproducira drugi zvuk kako bi vlastiti šum prepustio prostor. Kad počne drugi zvuk, Tendo stišava ili zaustavlja svoj šum te ga ne pokreće automatski ponovno kad drugi zvuk završi. Tendo ne zna koja se aplikacija, pjesma, podcast, audioknjiga ili video reproducira te ne pohranjuje ni šalje povijest slušanja. Ružičasti, bijeli i smeđi šum stvaraju se lokalno, a Tendo aktivira svoju audio sesiju samo dok proizvodi zvuk."
          }
        }
      }
    },
    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIossVariant": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated sound can step aside. If other audio begins, Tendo fades or stops its own sound and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Soft ambient and pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okruženje za fokus neobavezno je i besplatno. Tendo može koristiti opći signal sustava iOS da se reproducira drugi zvuk kako bi vlastiti zvuk prepustio prostor. Kad počne drugi zvuk, Tendo stišava ili zaustavlja svoj zvuk te ga ne pokreće automatski ponovno kad drugi zvuk završi. Tendo ne zna koja se aplikacija, pjesma, podcast, audioknjiga ili video reproducira te ne pohranjuje ni šalje povijest slušanja. Blagi ambijent te ružičasti, bijeli i smeđi šum stvaraju se lokalno, a Tendo aktivira svoju audio sesiju samo dok proizvodi zvuk."
          }
        }
      }
    },
    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIossVariant2": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated sound can step aside. If other audio begins, Tendo fades or stops its own sound and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Soft ambient, Gentle rain, and pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okruženje za fokus neobavezno je i besplatno. Tendo može koristiti opći signal sustava iOS da se reproducira drugi zvuk kako bi vlastiti zvuk prepustio prostor. Kad počne drugi zvuk, Tendo stišava ili zaustavlja svoj zvuk te ga ne pokreće automatski ponovno kad drugi zvuk završi. Tendo ne zna koja se aplikacija, pjesma, podcast, audioknjiga ili video reproducira te ne pohranjuje ni šalje povijest slušanja. Blagi ambijent, nježna kiša te ružičasti, bijeli i smeđi šum stvaraju se lokalno, a Tendo aktivira svoju audio sesiju samo dok proizvodi zvuk."
          }
        }
      }
