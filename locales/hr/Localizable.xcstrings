    "tendoFocusStartWith5MinutesChooseAGentle155Or": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment can stay quiet, keep your own audio, or add optional local background noise. When you stop, Tendo can remember your next tiny step so returning later takes less effort."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počnite s 5 minuta, odaberite lagani ritam 15 / 5 ili klasični 25 / 5 i zastanite kad trebate. Sesija ostaje vidljiva uz aktivnosti uživo i podršku za Apple Watch. Okruženje za fokus može ostati tiho, zadržati vaš zvuk ili dodati neobavezan lokalni pozadinski šum. Kad stanete, Tendo može zapamtiti vaš sljedeći mali korak kako bi povratak kasnije bio lakši."
          }
        }
      }
    },
    "tendoFocusStartWith5MinutesChooseAGentle155OrVariant": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, choose Soft ambient, or use optional pink, white, or brown noise. If other audio starts, Tendo sound steps aside."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počnite s 5 minuta, odaberite lagani ritam 15 / 5 ili klasični 25 / 5 i zastanite kad trebate. Sesija ostaje vidljiva uz aktivnosti uživo i podršku za Apple Watch. Okruženje za fokus zadano je tiho: zadržite trenutačni zvuk, odaberite Blagi ambijent ili koristite neobavezan ružičasti, bijeli ili smeđi šum. Ako počne drugi zvuk, zvuk aplikacije Tendo prepušta mu prostor."
          }
        }
      }
    },
    "tendoFocusStartWith5MinutesChooseAGentle155OrVariant2": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, or choose optional pink, white, or brown noise. If other audio starts, Tendo noise steps aside."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počnite s 5 minuta, odaberite lagani ritam 15 / 5 ili klasični 25 / 5 i zastanite kad trebate. Sesija ostaje vidljiva uz aktivnosti uživo i podršku za Apple Watch. Okruženje za fokus zadano je tiho: zadržite trenutačni zvuk ili odaberite neobavezan ružičasti, bijeli ili smeđi šum. Ako počne drugi zvuk, šum aplikacije Tendo prepušta mu prostor."
          }
        }
      }
    },
