      }
    },
    "tendoTipCalendar": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar and Reminders provide optional context without turning events into tasks."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar i Podsjetnici daju neobavezan kontekst bez pretvaranja događaja u zadatke."
