        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazivi kalendara služe samo za odabir onoga što se prikazuje u Tendu. Detalji događaja ostaju u memoriji i ne kopiraju se u SwiftData."
          }
        }
      }
    },
