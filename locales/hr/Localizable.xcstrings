    },
    "tendoWhatsNewCarryForwardDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished tasks from an earlier day no longer have to become today’s backlog. Review them and choose what you actually want to carry forward."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedovršeni zadaci od ranijeg dana više ne moraju postati današnji zaostatak. Pregledajte ih i odaberite što doista želite prenijeti dalje."
          }
        }
      }
    },
    "tendoWhatsNewCarryForwardTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what comes with you"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite što prenosite dalje"
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an optional morning reminder to start your day with intention, or an evening reflection to review your progress. Choose the times that suit you."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite neobavezan jutarnji podsjetnik za promišljen početak dana ili večernji osvrt za pregled napretka. Odaberite vrijeme koje vam odgovara."
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning Check-ins & Evening Reflections"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jutarnje javljanje i večernji osvrt"
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a friendly nudge after 1, 3, or 7 days away from Tendo. Your inactivity countdown resets automatically when you return."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primite prijateljski poticaj nakon 1, 3 ili 7 dana bez Tenda. Brojanje dana neaktivnosti automatski kreće ispočetka kad se vratite."
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Inactivity Reminders"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nježni podsjetnici na neaktivnost"
          }
        }
      }
    },
    "tendoWhatsNewGentleQuietHoursDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize quiet hours and manage each reminder individually. Everything is optional, disabled by default, and scheduled locally on your device."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodite razdoblje tišine i upravljajte svakim podsjetnikom zasebno. Sve je neobavezno, prema zadanim postavkama isključeno i zakazano lokalno na vašem uređaju."
          }
        }
      }
    },
    "tendoWhatsNewGentleQuietHoursTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet Hours & Notification Control"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razdoblje tišine i upravljanje obavijestima"
          }
        }
      }
    },
    "tendoWhatsNewResetProgressDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start fresh when you want to without deleting your Tendo tasks, routines, or history."
          }
        },
        "hr": {
