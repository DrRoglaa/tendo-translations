    "tendoCommonDisconnectClearsTendosCalendarSelectionsAndStopsCalendarContextTo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect clears Tendo’s calendar selections and stops Calendar Context. To revoke Apple’s permission completely, use Manage Calendar permission."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekid veze briše Tendo odabire kalendara i isključuje kontekst kalendara. Za potpuno ukidanje Appleova dopuštenja upotrijebi Upravljanje dopuštenjem kalendara."
          }
        }
      }
    },
    "tendoCommonDisconnectStopsTendoFromUsingRemindersAndForgetsYourSelected": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect stops Tendo from using Reminders and forgets your selected lists. iOS may still show Full Access until you revoke the system permission in Settings."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekid veze zaustavlja Tendo pristup Podsjetnicima i briše odabrane popise. iOS još može prikazivati puni pristup dok dopuštenje ne ukineš u Postavkama."
          }
        }
      }
    },
    "tendoCommonDisconnectingStopsTendoFromReadingCalendarAndClearsItsCalendar": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting stops Tendo from reading Calendar and clears its calendar selections. iOS permission itself can only be revoked in System Settings."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekid veze zaustavlja Tendo čitanje Kalendara i briše odabrane kalendare. iOS dopuštenje možeš ukinuti samo u postavkama sustava."
          }
        }
      }
    },
