        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Busy Calendar events help shape these suggestions. Find me a place does not create, move, or delete Calendar events."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zauzeti događaji Kalendara pomažu oblikovati ove prijedloge. Pronađi mi mjesto ne izrađuje, premješta ni briše događaje Kalendara."
          }
        }
      }
    },
