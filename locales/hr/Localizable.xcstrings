    "tendoCommonWhenYourHeadFeelsNoisyDumpItFirstYouCan": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your head feels noisy, dump it first. You can sort and refine things once the pressure is lower."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad vam je u glavi bučno, prvo istresite misli. Možete ih razvrstati i urediti kad pritisak popusti."
          }
        }
      }
    },
    "tendoCommonWinMoments": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
