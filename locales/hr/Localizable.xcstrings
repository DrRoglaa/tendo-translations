          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo će odmah prestati učitavati događaje kalendara i zaboraviti odabrane kalendare. Podaci Appleova Kalendara ostaju nepromijenjeni."
          }
        }
      }
    },
