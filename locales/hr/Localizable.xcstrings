    "tendoGuideShowAgainExplanation": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only resets educational tips. It does not change any tasks, routines, Focus sessions, or progress."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time se ponovno prikazuju samo edukativni savjeti. Zadaci, rutine, sesije fokusa i napredak ostaju nepromijenjeni."
          }
        }
      }
    },
