    "tendoTasksTendoConsidersBusyTimeExactTendoTasksYourEstimateDue": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo considers busy time, exact Tendo tasks, your estimate, due date, energy, day load, and recent Focus history."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo uzima u obzir zauzeta razdoblja, zadatke s točnim vremenom u Tendu, vašu procjenu, rok, energiju, opterećenje dana i nedavnu povijest Fokusa."
          }
        }
      }
    },
    "tendoTasksTendoLooksForAFewOpenWindowsAcrossTheNext": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo looks for a few open windows across the next three days. A Calendar event is created or moved only after you explicitly confirm one."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo traži nekoliko slobodnih razdoblja u sljedeća tri dana. Događaj u kalendaru stvara se ili premješta tek kad izričito potvrdite jedno od njih."
          }
        }
      }
    },
    "tendoTasksTendoLooksForRoomThatAlreadyExistsItUsesYour": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo looks for room that already exists. It uses your Tendo plan and, if connected, Apple Calendar. Nothing is added to Apple Calendar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo traži postojeći prostor. Koristi vaš plan u Tendu i Apple kalendar ako je povezan. Ništa se ne dodaje u Apple kalendar."
          }
        }
      }
    },
    "tendoTasksTendoOnlyLooksAtYourSelectedCalendarsAfterYouChoose": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo only looks at your selected calendars after you choose to connect them."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo uzima u obzir odabrane kalendare tek nakon što ih povežete."
          }
        }
      }
    },
    "tendoTasksTendoSuggestsThisFromTheTaskWordingOnDeviceNothing": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo suggests this from the task wording on-device. Nothing is added automatically. A follow-up reminder is scheduled only if you choose it."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ovo predlaže prema tekstu zadatka, na vašem uređaju. Ništa se ne dodaje automatski. Naknadni podsjetnik zakazuje se samo ako ga odaberete."
          }
        }
      }
    },
    "tendoTasksTendoSuggestsThisFromTheTaskWordingOnDeviceNothingVariant": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo suggests this from the task wording on-device. Nothing is added automatically. Mark this task done and Tendo can also offer a local follow-up reminder."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ovo predlaže prema tekstu zadatka, na vašem uređaju. Ništa se ne dodaje automatski. Označite ovaj zadatak dovršenim i Tendo vam može ponuditi i lokalni naknadni podsjetnik."
          }
        }
      }
    },
    "tendoTasksTendoSuggestsThisFromTheTaskWordingOnDeviceNothingVariant2": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo suggests this from the task wording on-device. Nothing is added or scheduled automatically."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ovo predlaže prema tekstu zadatka, na vašem uređaju. Ništa se ne dodaje niti zakazuje automatski."
          }
        }
      }
    },
    "tendoTasksTendoWillAskForNotificationPermissionOnlyWhenYouSave": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
