    "tendoCommonFiveMinutesStillCountsIfYouGetInterruptedPickUp": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes still counts. If you get interrupted, Pick Up Where You Left Off helps you return without rebuilding the whole plan in your head."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "I pet minuta vrijedi. Ako te nešto prekine, Nastavi gdje si stao pomaže ti vratiti se bez ponovnog slaganja cijelog plana u glavi."
          }
        }
      }
    },
    "tendoCommonFiveMinutesStillCountsTendoIsDesignedToHelpYou": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes still counts. Tendo is designed to help you begin, not punish you for stopping."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "I pet minuta vrijedi. Tendo ti pomaže početi, a ne kažnjava te kad staneš."
          }
        }
      }
    },
