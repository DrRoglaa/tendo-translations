      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic sample week with work and home tasks, Tiny Steps, two routines, several completed and interrupted Focus sessions, and a few Brain Dump thoughts. Delete demo data removes only records created by this button — your own data is left alone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrađuje realističan primjer tjedna s poslovnim i kućnim zadacima, malim koracima, dvjema rutinama, nekoliko dovršenih i prekinutih sesija fokusa te nekoliko misli u Istresanju misli. Brisanje pokaznih podataka uklanja samo zapise koje je izradio ovaj gumb — vaši podaci ostaju sačuvani."
          }
        }
      }
    },
