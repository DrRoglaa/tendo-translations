    "tendoFocusEnvironmentDefaultVolumeExplanation": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New installs start at %1$(text)@. This controls only Tendo's Focus Environment sound; your iPhone volume still controls the overall output. Tendo sound never starts automatically unless you turn this option on."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nove instalacije počinju s postavkom %1$(text)@. Time se upravlja samo zvukom okruženja za fokus u aplikaciji Tendo; glasnoća iPhonea i dalje upravlja ukupnim izlazom. Zvuk aplikacije Tendo ne pokreće se automatski ako ne uključite ovu opciju."
          }
        }
      }
    },
