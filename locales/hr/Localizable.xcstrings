    "tendoCommonWhatFitsNowCanSuggestABestFitAQuick": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Fits Now can suggest a best fit, a quick win, and a stretch option. Rescue Mode helps when you know the task but feel stuck. Lock Screen actions can jump you straight in."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što sada odgovara može predložiti najbolji izbor, brzi uspjeh i zahtjevniju mogućnost. Način pomoći pomaže kad znate zadatak, ali vam je zapelo. Radnje na zaključanom zaslonu mogu vas odmah dovesti do početka."
          }
        }
      }
    },
    "tendoCommonWhatFitsNowInApplicationname": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
