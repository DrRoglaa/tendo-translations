        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontekst kalendara"
          }
        }
      }
    },
    "tendoSettingsCalendarContextIsOptionalAppleRequiresFullCalendarAccessTo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar Context is optional. Apple requires Full Calendar Access to read existing events. Find me a place can use busy Calendar events to suggest open time, but it never creates, moves, or deletes Calendar events. Block in Apple Calendar is a separate action and changes only the single Calendar block you explicitly confirm for a Tendo task. There is no automatic task-to-calendar sync. You can disconnect Calendar Context inside Tendo at any time; system permission is managed in iOS Settings. Event details are not copied into Tendo's SwiftData database."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontekst kalendara nije obavezan. Apple zahtijeva puni pristup kalendaru za čitanje postojećih događaja. Pronađi mi mjesto može koristiti zauzete događaje za predlaganje slobodnog vremena, ali nikad ne izrađuje, premješta ni briše događaje. Blokiraj u Appleovu Kalendaru zasebna je radnja i mijenja samo jedan blok koji izričito potvrdite za zadatak Tendo. Nema automatske sinkronizacije zadataka i kalendara. Kontekst kalendara možete odspojiti u aplikaciji Tendo bilo kada; dopuštenjem sustava upravlja se u Postavkama sustava iOS. Detalji događaja ne kopiraju se u Tendo bazu SwiftData."
          }
        }
      }
    },
    "tendoSettingsCalendarNamesAreUsedOnlyToChooseWhatAppearsIn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar names are used only to choose what appears in Tendo. Event details stay in memory and are not copied into SwiftData."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazivi kalendara koriste se samo za odabir prikaza u aplikaciji Tendo. Detalji događaja ostaju u memoriji i ne kopiraju se u SwiftData."
          }
        }
      }
    },
