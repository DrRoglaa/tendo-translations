          }
        }
      }
    },
    "tendoSettingsWidgetsIntentionallyDoNotReadYourPrivateTaskDatabaseIn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets intentionally do not read your private task database in the current version. They stay useful without requiring shared app-group storage."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgeti u trenutačnoj verziji namjerno ne čitaju vašu privatnu bazu zadataka. Ostaju korisni bez potrebe za zajedničkom pohranom grupe aplikacija."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndCompanion": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments & Companion"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenuci uspjeha i pratitelj"
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheCompanionStayQuietProgressStillReflects": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the companion stay quiet. Progress still reflects your real activity."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenuci uspjeha i pratitelj ostaju tihi. Napredak i dalje odražava vašu stvarnu aktivnost."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheOptionalMomentumCompanionAreLocalPresentation": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the optional Momentum companion are local presentation features. Today's Wins and companion milestones are derived from your existing tasks, Tiny Steps, Focus history, and routines; Tendo does not create a separate XP, currency, streak, or analytics profile. Your companion choice is stored locally and changing it never changes your progress."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenuci uspjeha i neobavezan pratitelj zamaha lokalne su značajke prikaza. Današnji uspjesi i prekretnice pratitelja izvode se iz postojećih zadataka, malih koraka, povijesti fokusa i rutina; Tendo ne stvara zaseban profil bodova iskustva, valute, nizova ili analitike. Izbor pratitelja pohranjuje se lokalno i njegova promjena nikad ne mijenja napredak."
          }
        }
      }
    },
    "tendoSettingsWriteAReview": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a Review"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napišite recenziju"
          }
        }
      }
    },
    "tendoSettingsYesterday": {
      "comment": "Settings interface. Keep terminology consistent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jučer"
          }
        }
      }
    },
    "tendoSettingsYouCanPauseOrStopWheneverYouNeedToThe": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pause or stop whenever you need to. The time you already focused still counts."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete pauzirati ili stati kad god trebate. Već provedeno vrijeme fokusa i dalje se računa."
          }
        }
      }
    },
    "tendoSettingsYourOptionalPreferredNameIsStoredLocallyByTendoAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your optional preferred name is stored locally by Tendo and is used only to personalize greetings inside the app. It is included only when you choose to create an encrypted local Tendo backup. Tendo does not read your Contacts or Apple Account to obtain your name."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobavezno željeno ime Tendo pohranjuje lokalno i koristi samo za osobne pozdrave u aplikaciji. Uključuje se samo kad odlučite izraditi šifriranu lokalnu sigurnosnu kopiju Tendo. Tendo ne čita Kontakte ni Apple račun da bi saznao vaše ime."
          }
        }
      }
    },
    "tendoSettingsYourOptionalPreferredNameIsStoredOnlyByTendoAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your optional preferred name is stored only by Tendo and is used to personalize the greeting on Now. Leave it blank to keep the standard greeting."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobavezno željeno ime pohranjuje samo Tendo i koristi ga za osobni pozdrav u prikazu Sada. Ostavite prazno za standardni pozdrav."
          }
        }
      }
    },
    "tendoSettingsYourPasswordIsUsedOnlyOnThisDeviceToUnlock": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is used only on this device to unlock the selected backup and is never stored by Tendo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša lozinka koristi se samo na ovom uređaju za otključavanje odabrane sigurnosne kopije i Tendo je nikad ne pohranjuje."
          }
        }
      }
    },
    "tendoSettingsYourTasksRoutinesFocusHistoryTinyStepsAndBrainDump": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, routines, focus history, Tiny Steps, and Brain Dump stay in Tendo’s private local app storage. Apple Watch sharing uses only compact snapshots and actions, not the full SwiftData database."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaci, rutine, povijest fokusa, mali koraci i Istresanje misli ostaju u privatnoj lokalnoj pohrani aplikacije Tendo. Dijeljenje s Apple Watchom koristi samo sažete snimke stanja i radnje, a ne cijelu bazu SwiftData."
          }
        }
      }
    },
    "tendoSettingsYourTendoRecordsStayLocalUnlessYouExplicitlyExportAn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Tendo records stay local unless you explicitly export an encrypted backup."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši zapisi Tendo ostaju lokalni osim ako izričito izvezete šifriranu sigurnosnu kopiju."
          }
        }
      }
    },
