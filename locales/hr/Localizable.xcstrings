    "tendoFocusFiveFocusedMinutesBecameRealProgress": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five focused minutes became real progress."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pet minuta fokusa postalo je stvaran napredak."
          }
