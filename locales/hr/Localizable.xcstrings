        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustav prati izgled vašeg iPhonea. Neobavezno željeno ime pohranjuje samo Tendo i koristi ga za osobni pozdrav u prikazu Sada. Ostavite prazno za standardni pozdrav."
