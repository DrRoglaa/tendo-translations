    },
    "tendoFocusTendoOnlyChecksWhetherOtherAudioIsActiveItNever": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo only checks whether other audio is active. It never sees the app, song, podcast, audiobook, or video you are playing."
