        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Propušten dan ne treba stvoriti zaostatak. Odaberite samo ono što je sada izvedivo. Sve ostalo ostaje sigurno u Zadacima."
          }
        }
      }
    },
