    "tendoCommonTendoCanCreateAPasswordProtectedTendobackupFileTheBackup": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can create a password-protected .tendobackup file. The backup is created and encrypted locally on this device. Tendo does not upload, receive, store, or have access to your backup files or backup passwords. Demo/test data, Calendar and Reminders data, system permissions, account information, caches, diagnostics, and transient state are not included. If you export a backup, you choose where the encrypted file is stored or shared using Apple's system interfaces. Tendo cannot recover a backup if the password is lost."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo može izraditi datoteku .tendobackup zaštićenu lozinkom. Sigurnosna kopija izrađuje se i šifrira lokalno na ovom uređaju. Tendo ne prenosi, prima ni pohranjuje vaše datoteke sigurnosnih kopija ili njihove lozinke te im nema pristup. Pokazni i testni podaci, podaci Kalendara i Podsjetnika, dopuštenja sustava, podaci računa, predmemorije, dijagnostika i privremeno stanje nisu uključeni. Ako izvozite sigurnosnu kopiju, putem Appleovih sučelja sustava birate gdje će se šifrirana datoteka pohraniti ili dijeliti. Tendo ne može vratiti sigurnosnu kopiju ako izgubite lozinku."
          }
        }
      }
    },
    "tendoCommonTendoCouldntCompleteTheRestoreSafelyPleaseRestartTendoBefore": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't complete the restore safely. Please restart Tendo before making changes."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo nije mogao sigurno dovršiti vraćanje. Ponovno pokrenite Tendo prije unosa promjena."
          }
        }
      }
    },
    "tendoCommonTendoCouldntReadTheSelectedBackup": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't read the selected backup."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo nije mogao pročitati odabranu sigurnosnu kopiju."
          }
        }
      }
    },
    "tendoCommonTendoCouldntRestoreThisBackupYourExistingDataWasKept": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't restore this backup. Your existing data was kept."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo nije mogao vratiti ovu sigurnosnu kopiju. Postojeći podaci sačuvani su."
          }
        }
      }
    },
    "tendoCommonTendoReadsIncompleteRemindersDueTodayOrEarlierMarkingOne": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo reads incomplete reminders due today or earlier. Marking one done in Tendo completes the original Apple Reminder. Disconnecting never deletes reminders."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo čita nedovršene podsjetnike s rokom danas ili ranije. Označite li podsjetnik dovršenim u aplikaciji Tendo, dovršava se i izvorni Appleov podsjetnik. Prekid povezivanja nikad ne briše podsjetnike."
          }
        }
      }
    },
    "tendoCommonTendoTasksAlreadyPlaced": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(count)lld Tendo tasks already placed"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već smješteni zadaci Tendo: %1$(count)lld"
          }
        }
      }
    },
    "tendoCommonTendoWillStopLoadingRemindersAndForgetWhichListsYou": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo will stop loading reminders and forget which lists you selected. Your reminders stay unchanged in Apple Reminders."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo će prestati učitavati podsjetnike i zaboraviti odabrane popise. Vaši podsjetnici ostaju nepromijenjeni u Appleovim Podsjetnicima."
          }
        }
      }
    },
    "tendoCommonThatIsEnoughForNowYouDoNotNeedTo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
