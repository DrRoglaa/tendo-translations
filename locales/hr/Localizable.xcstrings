    "tendoSettingsBackupVerified": {
      "comment": "Settings interface. Keep terminology consistent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup verified"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
