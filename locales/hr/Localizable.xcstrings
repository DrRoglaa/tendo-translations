    "tendoMomentumTendoDerivesHomeGrowthFromYourRealTasksTinySteps": {
      "comment": "Momentum interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo derives home growth from your real tasks, Tiny Steps, Focus sessions, and routines. There is no XP, currency, daily quota, or streak to protect. Once a home detail appears, it stays. Demo data never changes your personal Companion Home."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo temelji rast doma na vašim stvarnim zadacima, malim koracima, sesijama fokusa i rutinama. Nema bodova iskustva, valute, dnevne kvote ni niza koji treba čuvati. Kad se detalj doma pojavi, ostaje. Pokazni podaci nikad ne mijenjaju osobni dom vašeg pratitelja."
          }
        }
      }
    },
    "tendoMomentumTendoDerivesHomeGrowthFromYourRealTasksTinyStepsVariant": {
      "comment": "Momentum interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo derives home growth from your real tasks, Tiny Steps, Focus sessions, and routines. There is no XP, currency, daily quota, or streak to protect. Once a home detail appears, it stays. Demo data never permanently unlocks home details."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo temelji rast doma na vašim stvarnim zadacima, malim koracima, sesijama fokusa i rutinama. Nema bodova iskustva, valute, dnevne kvote ni niza koji treba čuvati. Kad se detalj doma pojavi, ostaje. Pokazni podaci nikad ne otključavaju trajno detalje doma."
          }
        }
      }
    },
