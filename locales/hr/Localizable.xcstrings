        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite samo ono što vam pomaže. Blagi ambijent te ružičasti, bijeli i smeđi šum stvaraju se lokalno, a Tendo ne pohranjuje povijest slušanja."
          }
