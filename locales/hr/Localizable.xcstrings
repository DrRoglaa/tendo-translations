      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brain Dump turns thoughts into tasks fast. Then you can tidy them up, add tiny steps, estimates, and due dates, and keep everything in one place."
          }
