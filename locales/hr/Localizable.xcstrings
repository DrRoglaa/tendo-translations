    "tendoSettingsCreatesARealisticSyntheticWeekWith36MixedWorkAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, including follow-up nudge examples, Tiny Steps, three routines, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete Sample Data removes only records created here — your own data is left alone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrađuje realističan ogledni tjedan s 36 poslovnih i kućnih zadataka, uključujući primjere naknadnih poticaja, male korake, tri rutine, raznoliku povijest dovršenih i prekinutih sesija fokusa te misli u Istresanju misli. Brisanje pokaznih podataka uklanja samo ovdje izrađene zapise — vaši podaci ostaju sačuvani."
          }
        }
      }
    },
    "tendoSettingsCreatesARealisticSyntheticWeekWithRoutineFolders": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, Tiny Steps, 16 routines organized into four folders, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete Sample Data removes only records created here — your own data is left alone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrađuje realističan ogledni tjedan s 36 poslovnih i kućnih zadataka, malim koracima, 16 rutina u četiri mape, raznolikom poviješću dovršenih i prekinutih sesija fokusa te mislima u Istresanju misli. Brisanje pokaznih podataka uklanja samo ovdje izrađene zapise — vaši podaci ostaju sačuvani."
          }
        }
      }
    },
