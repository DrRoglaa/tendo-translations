        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovu sigurnosnu kopiju nije moguće provjeriti. Datoteka je možda nepotpuna ili oštećena. Trenutačni podaci nisu promijenjeni."
          }
        }
      }
    },
    "tendoSettingsThisBackupWasCreatedByANewerVersionOfTendo": {
