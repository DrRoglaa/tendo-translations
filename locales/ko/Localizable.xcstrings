          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유동적, 25분/5분, 15분/5분 선택과 실시간 현황, Apple Watch, 기본 무음 집중 환경이 표시된 집중 미리보기"
          }
