    "tendoNotificationsTendoIsAuthorizedButIosIsNotSetToShow": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is authorized, but iOS is not set to show an alert while your iPhone is unlocked."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo는 권한이 있지만 iPhone 잠금이 해제된 동안 알림을 표시하도록 설정되지 않았어요."
          }
        }
      }
    },
    "tendoNotificationsTendoSchedulesRemindersOnThisIphoneReminderContentIsNot": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo schedules reminders on this iPhone. Reminder content is not sent to a Tendo server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo는 이 iPhone에서 미리 알림을 예약해요. 미리 알림 내용은 Tendo 서버로 전송되지 않아요."
          }
        }
      }
    },
    "tendoNotificationsTendoSchedulesRemindersOnThisIphoneTheSelectedSoundIs": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo schedules reminders on this iPhone. The selected sound is used for focus completion, task reminders, transition reminders, and test notifications. Reminder content is not sent to a Tendo server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo는 이 iPhone에서 미리 알림을 예약해요. 선택한 소리는 집중 완료, 할 일, 전환, 테스트 알림에 사용돼요. 미리 알림 내용은 Tendo 서버로 전송되지 않아요."
          }
        }
      }
    },
    "tendoNotificationsTendoSchedulesTheseLocallyOnYourDeviceItDoesNot": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo schedules these locally on your device. It does not read your calendar or guess when you should leave."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo는 기기 안에서 예약해요. 캘린더를 읽거나 출발 시간을 추측하지 않아요."
          }
        }
      }
    },
    "tendoNotificationsTendoTestNotification": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
