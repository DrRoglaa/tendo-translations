    "tendoSettingsWidgetsIntentionallyDoNotReadYourPrivateTaskDatabaseIn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets intentionally do not read your private task database in the current version. They stay useful without requiring shared app-group storage."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 버전의 위젯은 의도적으로 비공개 할 일 데이터베이스를 읽지 않아요. 공유 앱 그룹 저장소 없이도 유용하게 사용할 수 있어요."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndCompanion": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments & Companion"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해낸 순간 및 동반자"
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheCompanionStayQuietProgressStillReflects": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the companion stay quiet. Progress still reflects your real activity."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해낸 순간과 동반자는 조용히 유지돼요. 진행 상황은 계속 실제 활동을 반영해요."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheOptionalMomentumCompanionAreLocalPresentation": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the optional Momentum companion are local presentation features. Today's Wins and companion milestones are derived from your existing tasks, Tiny Steps, Focus history, and routines; Tendo does not create a separate XP, currency, streak, or analytics profile. Your companion choice is stored locally and changing it never changes your progress."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해낸 순간과 선택적인 추진력 동반자는 기기 내 표시 기능이에요. 오늘 해낸 일과 동반자 이정표는 기존 할 일, 작은 단계, 집중 기록, 루틴에서 계산해요. 별도 경험치, 재화, 연속 기록, 분석 프로필을 만들지 않아요. 동반자 선택은 기기에 저장되며 바꿔도 진행 상황은 바뀌지 않아요."
          }
        }
      }
    },
    "tendoSettingsWriteAReview": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a Review"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리뷰 쓰기"
          }
        }
      }
    },
    "tendoSettingsYesterday": {
      "comment": "Settings interface. Keep terminology consistent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday"
