    "tendoTasksTryAShorterDurationOrChooseAnyTimeTendoWill": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a shorter duration or choose Any time. Tendo will not force a task into a crowded gap."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 줄이거나 아무 때나를 고르세요. Tendo는 붐비는 틈에 할 일을 억지로 넣지 않아요."
          }
        }
      }
    },
    "tendoTasksTryAShorterDurationTendoCurrentlyLooksBetween800": {
