    },
    "tendoSettingsAppleControlsTheCalendarPermissionTendoReadsSelectedEventsFor": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple controls the Calendar permission. Tendo reads selected events for context and only writes a Calendar event when you explicitly confirm Block Time. Turning the integration off takes effect immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 권한은 Apple이 관리해요. Tendo는 선택한 일정을 참고용으로 읽고 시간 확보를 명시적으로 확인할 때만 캘린더 일정을 써요. 연동을 끄면 즉시 적용돼요."
          }
        }
      }
    },
    "tendoSettingsAppleControlsTheRemindersPermissionTendoIntegrationControlsWhetherTendo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple controls the Reminders permission. Tendo integration controls whether Tendo actually reads or completes reminders. Turning it off takes effect immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 알림 권한은 Apple이 관리해요. Tendo 연동은 실제로 미리 알림을 읽거나 완료할지 정해요. 끄면 즉시 적용돼요."
          }
        }
      }
    },
    "tendoSettingsAppleKeepsThisSiriPermissionInTheShortcutsAppSo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple keeps this Siri permission in the Shortcuts app, so Tendo cannot move or duplicate the switch inside its own Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 이 Siri 권한을 단축어 앱에서 관리하므로 Tendo 설정 안으로 스위치를 옮기거나 복제할 수 없어요."
          }
        }
      }
    },
    "tendoSettingsAppleRemindersIntegrationIsOptionalTendoReadsIncompleteRemindersDue": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Reminders integration is optional. Tendo reads incomplete reminders due today or earlier from the lists you choose. If you mark one done in Tendo, that completion is saved back to Apple Reminders. Reminder contents are not copied into Tendo's SwiftData database."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 미리 알림 연동은 선택 사항이에요. 선택한 목록에서 기한이 오늘이거나 지난 미완료 항목을 읽어요. Tendo에서 완료하면 Apple 미리 알림에도 저장돼요. 내용은 Tendo의 SwiftData 데이터베이스로 복사되지 않아요."
          }
        }
      }
    },
    "tendoSettingsAppleWatch": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch, %1$(text)@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch, %1$(text)@"
          }
        }
      }
    },
    "tendoSettingsAppleWatchShowsTheIphoneStartedFocusAsAPassive": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch shows the iPhone-started Focus as a passive Live Activity, so the iPhone remains the source of truth for that session."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch는 iPhone에서 시작한 집중을 수동적인 실시간 현황으로 표시하므로 해당 세션의 기준은 iPhone이에요."
          }
        }
      }
    },
    "tendoSettingsAppleWatchTitle": {
      "comment": "Settings interface. Keep terminology consistent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
