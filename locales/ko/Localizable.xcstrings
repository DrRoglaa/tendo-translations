          }
        }
      }
    },
    "tendoTipTaskDetails": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tiny first action is often easier than starting the whole task at once."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일 전체를 한 번에 시작하기보다 작은 첫 행동이 더 쉬울 때가 많아요."
          }
        }
