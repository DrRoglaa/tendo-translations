        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴 폴더"
          }
        }
      }
    },
    "tendoWhatsNewRoutinesRefinedDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clearer folder hierarchy, folder icons and counts, calmer routine rows, and a dedicated Other routines section make larger libraries easier to scan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 명확한 폴더 계층 구조, 폴더 아이콘과 개수, 차분한 루틴 표시, 별도의 기타 루틴 섹션으로 루틴이 많아도 더 쉽게 살펴볼 수 있어요."
          }
        }
      }
    },
    "tendoWhatsNewRoutinesRefinedTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improved Routines"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개선된 루틴"
          }
        }
      }
    },
    "tendoWhatsNewSaferBackupsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify an encrypted backup before restoring it, and see your latest successful backup and restore."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 백업을 복원하기 전에 검증하고, 최근에 성공한 백업과 복원을 확인하세요."
          }
        }
      }
    },
