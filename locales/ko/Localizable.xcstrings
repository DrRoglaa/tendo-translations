        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트 전송됨"
          }
        }
      }
    },
    "tendoNotificationsTheTimeAboveIsWhenTendoSendsThisExactNudge": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time above is when Tendo sends this exact nudge. For example, choose the time you want to see “Leave in 10 minutes” rather than an appointment time and expecting Tendo to calculate travel automatically."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 시간은 Tendo가 이 문구를 그대로 보내는 시간이에요. 예를 들어 약속 시간을 입력하고 이동 시간을 자동 계산한다고 생각하기보다 “10분 후 출발”을 보고 싶은 시간을 고르세요."
          }
        }
      }
    },
    "tendoNotificationsThis": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "this"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것"
          }
        }
      }
    },
    "tendoNotificationsTransitionRemindersNeedNotificationPermissionYouCanEnableNotificationsIn": {
      "comment": "Notifications interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transition reminders need notification permission. You can enable notifications in System Settings."
