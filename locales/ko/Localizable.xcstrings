      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo considers busy time, exact Tendo tasks, your estimate, due date, energy, day load, and recent Focus history."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo는 바쁜 시간, 정확한 시간의 Tendo 할 일, 예상 시간, 기한, 에너지, 하루 일정량, 최근 집중 기록을 고려해요."
          }
