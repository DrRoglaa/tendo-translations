    "tendoCommonTryStart5WhenYouKnowWhatToDoWhat": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Start 5 when you know what to do, What Fits Now when you need guidance, and I'm Stuck when the first step feels blocked."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 알 때는 5분 시작, 도움이 필요할 때는 지금 할 수 있는 일, 첫 단계를 시작하기 어려울 때는 막혔어요를 사용해 보세요."
          }
        }
      }
    },
    "tendoCommonTurnOnOnlyTheIntegrationsThatHelpYouYouCan": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only the integrations that help you. You can change everything later in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도움이 되는 연동만 켜세요. 나중에 설정에서 모두 변경할 수 있어요."
          }
        }
      }
    },
    "tendoCommonTurningCalendarContextOffImmediatelyStopsTendoFromLoadingCalendar": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning Calendar Context off immediately stops Tendo from loading calendar events. Apple’s system permission is managed separately in iOS Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 참고를 끄면 Tendo가 즉시 일정 불러오기를 중단해요. Apple 시스템 권한은 iOS 설정에서 따로 관리돼요."
          }
        }
      }
    },
    "tendoCommonUseMin": {
