    "tendoTipAppleWatch": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check installation and connection status here before using Focus from your Watch."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch에서 집중을 사용하기 전에 여기서 설치 및 연결 상태를 확인하세요."
          }
        }
      }
    },
    "tendoTipBackups": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted exports stay under your control; remember the backup password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 내보내기는 직접 관리해요. 백업 암호를 기억하세요."
          }
        }
      }
    },
    "tendoTipBrainDump": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Make Task to move a thought into Tasks; the original stays under Processed until you clear it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일로 만들기로 생각을 할 일로 옮기세요. 원본은 지우기 전까지 처리됨에 남아요."
          }
        }
      }
    },
    "tendoTipCalendar": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar and Reminders provide optional context without turning events into tasks."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더와 미리 알림은 일정을 할 일로 바꾸지 않고 선택 참고 정보를 제공해요."
          }
        }
      }
    },
    "tendoTipFocus": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start with five minutes; your Focus preferences remain adjustable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5분부터 시작할 수 있어요. 집중 설정은 계속 조정할 수 있어요."
          }
        }
      }
    },
    "tendoTipNotifications": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only enable reminders that help. Quiet hours can keep them gentle."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도움이 되는 미리 알림만 켜세요. 방해 금지 시간으로 부드럽게 유지할 수 있어요."
          }
        }
      }
    },
    "tendoTipNow": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the next action small. You can use Start 5 without planning your whole day."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 행동을 작게 유지하세요. 하루 전체를 계획하지 않아도 5분 시작을 사용할 수 있어요."
          }
        }
      }
    },
    "tendoTipPersonalization": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your theme and preferred greeting are optional and saved on this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마와 인사 설정은 선택 사항이며 이 기기에 저장돼요."
          }
        }
      }
    },
    "tendoTipProgress": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small wins and short Focus sessions are still worth noticing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 성취와 짧은 집중 세션도 알아줄 만해요."
          }
        }
      }
    },
    "tendoTipRoutineFolders": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders organize routines without changing the steps inside them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더는 안의 단계를 바꾸지 않고 루틴을 정리해요."
          }
        }
      }
    },
    "tendoTipRoutines": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try running one short routine before building a bigger routine library."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 루틴 보관함을 만들기 전에 짧은 루틴 하나를 실행해 보세요."
          }
        }
      }
    },
    "tendoTipShortcuts": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a Tendo shortcut to start a task or Focus action with fewer taps."
