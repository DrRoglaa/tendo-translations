          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음으로 해 보기"
          }
        }
      }
    },
    "tendoGuideWeekExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Wednesday looks crowded, find a calmer place for a flexible task."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수요일이 붐빈다면 유동적인 할 일을 더 여유로운 곳에 배치하세요."
          }
        }
      }
    },
    "tendoGuideWeekNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Week from Today and try Make Room when needed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘에서 주간을 열고 필요할 때 여유 만들기를 사용해 보세요."
          }
        }
      }
    },
    "tendoGuideWeekSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review upcoming capacity without turning every day into a packed schedule."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 일정을 가득 채우지 않고 앞으로의 여유를 살펴보세요."
          }
        }
      }
    },
