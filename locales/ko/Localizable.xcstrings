    "tendoCalendarDemoDataIsReadyOpenTodayTasksRoutinesBrainDump": {
      "comment": "Calendar interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo data is ready. Open Today, Tasks, Routines, Brain Dump, or Progress to explore how the pieces fit together."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데모 데이터가 준비됐어요. 오늘, 할 일, 루틴, 생각 비우기, 진행 상황을 열어 기능이 어떻게 연결되는지 살펴보세요."
          }
        }
      }
    },
