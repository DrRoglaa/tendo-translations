    "tendoSettingsFlexibleMin": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexible · %1$(minutes)lld min"
          }
        },
        "ko": {
