    "tendoSettingsCreateTasksStartFocusRunRoutinesAndControlAnActive": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create tasks, start focus, run routines, and control an active focus session with Siri or Apple shortcuts."
          }
        },
