    "tendoSettingsTendoVerifiesEveryBackupFirstYouCanReviewItsDate": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo verifies every backup first. You can review its date and contents before deciding whether to replace the current Tendo data on this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo는 모든 백업을 먼저 검증해요. 날짜와 내용을 확인한 뒤 이 기기의 현재 Tendo 데이터를 교체할지 결정할 수 있어요."
          }
