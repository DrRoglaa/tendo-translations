    },
    "tendoSettingsTendoCanCreateAPasswordProtectedTendobackupFileTheBackup": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can create a password-protected .tendobackup file. The backup is created and encrypted locally, and it is verified and restored locally on this device. Tendo does not upload, receive, store, or have access to your backup files or backup passwords. Demo/test data, Calendar and Reminders data, system permissions, account information, caches, diagnostics, and transient state are not included. If you export a backup, you choose where the encrypted file is stored or shared using Apple's system interfaces. Tendo keeps only the dates of your last successful backup and restore locally for display in Settings. Tendo cannot recover a backup if the password is lost."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo는 암호로 보호된 .tendobackup을 만들 수 있어요. 생성, 암호화, 검증, 복원은 이 기기에서 이루어져요. Tendo는 백업 파일이나 암호를 업로드, 수신, 저장하거나 접근하지 않아요. 데모 및 테스트 데이터, 캘린더와 미리 알림 데이터, 권한, 계정, 캐시, 진단 정보, 임시 상태는 포함하지 않아요. 내보낼 때 Apple 시스템 화면에서 저장하거나 공유할 곳을 고를 수 있어요. 설정 표시를 위해 마지막으로 성공한 백업과 복원 날짜만 기기에 저장해요. 암호를 잃으면 백업을 복구할 수 없어요."
          }
        }
      }
    },
    "tendoSettingsTendoCanGentlyAcknowledgeACompletedTaskTinyStepFocus": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can gently acknowledge a completed task, Tiny Step, Focus, routine, or return after an interruption."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo는 할 일, 작은 단계, 집중, 루틴 완료나 중단 후 복귀를 부드럽게 인정해 줄 수 있어요."
          }
        }
      }
    },
    "tendoSettingsTendoCannotRecoverThisPasswordIfYouForgetItThis": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
