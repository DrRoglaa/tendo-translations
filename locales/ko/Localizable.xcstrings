      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calmer Settings experience"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 차분해진 설정 화면"
          }
        }
      }
    },
    "tendoWhatsNewCalmerTendoDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks, Task details, Settings, and Focus Live Activities have been refined to feel cleaner and easier to scan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일, 할 일 세부 정보, 설정, 집중 실시간 현황을 더 깔끔하고 한눈에 보기 쉽게 다듬었어요."
          }
        }
      }
    },
    "tendoWhatsNewCalmerTendoTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calmer Tendo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 차분해진 Tendo"
          }
        }
      }
    },
    "tendoWhatsNewCarryForwardDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished tasks from an earlier day no longer have to become today’s backlog. Review them and choose what you actually want to carry forward."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난날에 끝내지 못한 할 일을 모두 오늘로 가져올 필요는 없어요. 검토한 뒤 실제로 이어서 하고 싶은 일을 선택하세요."
          }
        }
      }
    },
    "tendoWhatsNewCarryForwardTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what comes with you"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어 갈 일 선택"
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an optional morning reminder to start your day with intention, or an evening reflection to review your progress. Choose the times that suit you."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루를 의식적으로 시작할 아침 미리 알림이나 진행 상황을 돌아볼 저녁 성찰을 선택적으로 설정하세요. 자신에게 맞는 시간을 고를 수 있어요."
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning Check-ins & Evening Reflections"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침 체크인과 저녁 성찰"
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a friendly nudge after 1, 3, or 7 days away from Tendo. Your inactivity countdown resets automatically when you return."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo를 1일, 3일 또는 7일 동안 사용하지 않으면 부드럽게 알려드려요. 돌아오면 미사용 기간의 집계가 자동으로 다시 시작돼요."
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Inactivity Reminders"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 미사용 알림"
          }
        }
      }
    },
    "tendoWhatsNewGentleQuietHoursDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize quiet hours and manage each reminder individually. Everything is optional, disabled by default, and scheduled locally on your device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 쉬는 시간을 설정하고 미리 알림을 개별적으로 관리하세요. 모두 선택 사항이며 기본적으로 꺼져 있고 기기에서 로컬로 예약돼요."
          }
        }
      }
    },
    "tendoWhatsNewGentleQuietHoursTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet Hours & Notification Control"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 쉬는 시간과 알림 관리"
          }
        }
      }
    },
    "tendoWhatsNewResetProgressDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start fresh when you want to without deleting your Tendo tasks, routines, or history."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo의 할 일, 루틴, 기록을 지우지 않고도 원할 때 새롭게 시작할 수 있어요."
          }
        }
      }
    },
    "tendoWhatsNewResetProgressTitle": {
      "comment": "Tendo interface text. Keep natural language and terminology consistent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Progress"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 상황 초기화"
          }
        }
      }
    },
    "tendoWhatsNewRoutineFoldersDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize routines into folders, choose an icon, and arrange them the way that works for you."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴을 폴더로 정리하고 아이콘을 고른 뒤 자신에게 맞게 배치하세요."
          }
        }
      }
    },
    "tendoWhatsNewRoutineFoldersTitle": {
      "comment": "Tendo interface text. Keep natural language and terminology consistent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
