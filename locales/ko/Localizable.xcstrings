    "tendoOnboardingSkipsOnboardingAndOpensTendo": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips onboarding and opens Tendo"
