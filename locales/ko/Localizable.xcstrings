    "tendoBrainDumpMakeATaskOnlyWhenItIsUsefulYouDo": {
      "comment": "Brain Dump interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a task only when it is useful. You do not need to organize everything now."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도움이 될 때만 할 일로 만드세요. 지금 모든 것을 정리하지 않아도 돼요."
          }
        }
      }
    },
