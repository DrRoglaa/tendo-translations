    "tendoTasksThisGivesYouALittleBreathingRoomAfterYourRecent": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This gives you a little breathing room after your recent Focus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 집중 후 숨 돌릴 여유를 조금 줘요."
          }
        }
      }
    },
    "tendoTasksThisKeepsADueSoonTaskInViewWithoutOverlapping": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This keeps a due-soon task in view without overlapping another fixed commitment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 고정 일정과 겹치지 않게 기한이 가까운 할 일을 눈에 보이게 둬요."
          }
        }
      }
    },
    "tendoTasksThisOpeningLeavesSomeBreathingRoomBeforeOrAfterThe": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This opening leaves some breathing room before or after the task."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일 전후에 숨 돌릴 여유가 남는 시간대예요."
          }
        }
      }
    },
    "tendoTasksThisRemovesTheCalendarEventCreatedForThisTaskAnd": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the Calendar event created for this task and removes its exact-time placement in Tendo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일을 위해 만든 캘린더 일정과 Tendo의 정확한 시간 배치를 제거해요."
          }
        }
      }
    },
    "tendoTasksThisTaskAlreadyHasAnAppleCalendarBlockMoveOr": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task already has an Apple Calendar block. Move or remove that block here so Tendo and Calendar stay together."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일에는 이미 Apple 캘린더 블록이 있어요. Tendo와 캘린더를 맞추려면 여기서 블록을 옮기거나 제거하세요."
          }
        }
      }
    },
    "tendoTasksThisTaskAlreadyHasAnAppleCalendarBlockUseMove": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task already has an Apple Calendar block. Use Move Calendar block so Tendo and Calendar stay together."
          }
