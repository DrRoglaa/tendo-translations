    "tendoCommonWhatFitsNowCanSuggestABestFitAQuick": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Fits Now can suggest a best fit, a quick win, and a stretch option. Rescue Mode helps when you know the task but feel stuck. Lock Screen actions can jump you straight in."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 할 수 있는 일은 가장 잘 맞는 일, 금방 끝낼 일, 조금 도전할 일을 제안해요. 할 일은 알지만 막힐 때는 구조 모드가 도와줘요. 잠금 화면에서 바로 시작할 수도 있어요."
          }
        }
      }
    },
    "tendoCommonWhatFitsNowInApplicationname": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What fits now in \\(.applicationName)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(.applicationName)에서 지금 할 수 있는 일"
          }
        }
      }
    },
    "tendoCommonWhen": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제"
          }
        }
      }
    },
    "tendoCommonWhenYourHeadFeelsNoisyDumpItFirstYouCan": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your head feels noisy, dump it first. You can sort and refine things once the pressure is lower."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머릿속이 복잡하면 먼저 적어 보세요. 부담이 줄어든 뒤에 정리하고 다듬어도 돼요."
          }
        }
      }
    },
    "tendoCommonWinMoments": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해낸 순간"
          }
        }
      }
    },
    "tendoCommonWinMomentsAreLocalCompletionFeedbackTheyDoNotCreate": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments are local completion feedback. They do not create scores, streaks, profiles, or analytics, and nothing about a Win Moment is sent off-device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해낸 순간은 기기 안에서 제공되는 완료 피드백이에요. 점수, 연속 기록, 프로필, 분석 데이터를 만들지 않으며 관련 정보는 기기 밖으로 전송되지 않아요."
          }
        }
      }
    },
    "tendoCommonWinsToday": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(count)lld wins today"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 해낸 일 %1$(count)lld개"
          }
        }
      }
    },
    "tendoCommonYouCanCreateAnotherTaskHereAtAnyTimeNew": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can create another task here at any time. New tasks are added automatically while there is room. Swipe left on an available task to delete the Tendo task."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 언제든 새 할 일을 만들 수 있어요. 공간이 있으면 새 할 일이 자동으로 추가돼요. 사용 가능한 할 일을 왼쪽으로 쓸어넘겨 Tendo 할 일을 삭제할 수 있어요."
          }
        }
      }
    },
    "tendoCommonYouGaveSomeAttentionYouCanStopHere": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You gave %1$(taskTitle)@ some attention. You can stop here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(taskTitle)@에 주의를 기울였어요. 여기서 멈춰도 돼요."
          }
        }
      }
    },
    "tendoCommonYouGaveThisYourAttentionThatMatters": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You gave this your attention. That matters."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 일에 주의를 기울였어요. 그것만으로도 의미가 있어요."
          }
        }
      }
    },
    "tendoCommonYouShowedUpYouCanStopHere": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You showed up. You can stop here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작해 보았어요. 여기서 멈춰도 돼요."
          }
        }
      }
    },
    "tendoCommonYourLightPlan": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light plan"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나의 가벼운 계획"
          }
        }
      }
    },
    "tendoCommonYourLightPlanIsFullRemoveOneAboveIfYou": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light plan is full. Remove one above if you want to choose a different task."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가벼운 계획이 가득 찼어요. 다른 할 일을 선택하려면 위에서 하나를 제거하세요."
          }
        }
      }
    },
    "tendoCommonYourOpenTasksAlreadyHaveAPlaceOrThereAre": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your open tasks already have a place, or there are no unscheduled tasks right now."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 할 일은 이미 배치되어 있거나, 지금은 예정되지 않은 할 일이 없어요."
          }
        }
      }
