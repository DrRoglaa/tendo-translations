    "tendoCalendarCalendarNamesAreUsedOnlyToChooseWhatAppearsIn": {
      "comment": "Calendar interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar names are used only to choose what appears in Tendo. Event details are kept in memory and are not copied into SwiftData."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 이름은 Tendo에 표시할 항목을 선택할 때만 사용됩니다. 일정 세부 정보는 메모리에만 보관되며 SwiftData로 복사되지 않습니다."
          }
        }
      }
    },
