    "tendoOnboardingChooseYourOwnTimeA25MinuteFocusOrA": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your own time, a 25-minute focus, or a gentler 15-minute focus. Breaks are optional, and 5 minutes is always a valid place to begin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 직접 정하거나 25분 집중, 더 가벼운 15분 집중을 선택하세요. 휴식은 선택 사항이며 5분부터 시작해도 언제나 괜찮아요."
          }
        }
      }
    },
    "tendoOnboardingClosesOnboarding": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes onboarding"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 안내를 닫아요"
          }
        }
      }
    },
    "tendoOnboardingCreateRoutinesNoticeTodaysWinsAndReviewProgressOverTime": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create routines, notice Today's Wins, and review progress over time. Choose Off, Subtle, or Companion Win Moments — without points, currency, or streak pressure."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴을 만들고 오늘 해낸 일을 알아보며 진행 상황을 돌아보세요. 해낸 순간은 끄기, 은은하게, 동반자 중에서 선택할 수 있어요. 점수, 재화, 연속 기록의 부담은 없어요."
          }
        }
      }
    },
    "tendoOnboardingDentist": {
