      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a folder to rename it or change its icon. Swipe left to delete it. Folders must be empty before deletion. Use Edit to reorder folders."
