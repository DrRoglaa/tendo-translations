    "tendoCommonChooseSomethingBelowTendoWillKeepThePlanSmallThree": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose something below. Tendo will keep the plan small — three things at most."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에서 골라 보세요. Tendo가 계획을 최대 세 가지로 간단하게 유지해요."
          }
        }
      }
    },
    "tendoCommonChooseUpTo3OpenTasksTapOneToKeep": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose up to 3 open tasks. Tap one to keep it in view, then give it a loose part of the day if that helps."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미완료 할 일을 최대 세 개 선택하세요. 하나를 탭해 눈에 보이게 두고 도움이 된다면 대략적인 시간대를 정하세요."
          }
        }
      }
    },
    "tendoCommonChooseUpTo3OpenTasksUnscheduledOrAlreadyOn": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose up to 3 open tasks — unscheduled or already on Today. Exact-time anchors stay fixed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미완료 할 일을 최대 세 개 선택하세요. 미배치나 오늘의 할 일 모두 가능해요. 시간이 고정된 할 일은 그대로 유지됩니다."
          }
        }
      }
    },
