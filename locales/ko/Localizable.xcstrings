      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Start 5 in Now or adjust Focus defaults in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금에서 5분 시작을 선택하거나 설정에서 집중 기본값을 조정하세요."
          }
        }
      }
    },
