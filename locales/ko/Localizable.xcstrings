        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘에서 지금 할 수 있는 일을, 지금에서 막혔어요를 사용해 보세요."
          }
        }
      }
    },
    "tendoGuideRescueSummary": {
