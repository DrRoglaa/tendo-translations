    "tendoCommonFlexibleKeepsATaskVisibleWithoutPromisingATimeMorning": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexible keeps a task visible without promising a time. Morning, Afternoon, and Evening give it a gentle window on Today."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유연하게 두면 정확한 시간을 정하지 않고도 할 일이 보여요. 아침, 오후, 저녁으로 오늘의 대략적인 시간대를 정할 수 있어요."
          }
        }
      }
    },
