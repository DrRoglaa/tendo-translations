    "tendoAboutIndieDeveloperFooter": {
      "comment": "About interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent software, built with ♥ by Indie developer (David Rok Roglič) in Slovenia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬로베니아의 인디 개발자 David Rok Roglič가 ♥을 담아 만든 독립 소프트웨어입니다."
