          }
        }
      }
    },
    "tendoTipSiri": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Tendo actions in Shortcuts, or try a suggested Siri phrase."
