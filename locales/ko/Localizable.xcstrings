    "tendoFocusTendoAddsNoSoundOtherAudioIsNeverStoppedJust": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo adds no sound. Other audio is never stopped just because Focus starts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo는 소리를 더하지 않아요. 집중을 시작한다는 이유로 다른 오디오를 멈추지 않아요."
          }
