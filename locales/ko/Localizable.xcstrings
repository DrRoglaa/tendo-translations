    "tendoGuideTaskDetailsExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For “prepare presentation,” make the next tiny step “open the outline.”"
