        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“치과에 전화하기”와 “여권 갱신하기”를 각각 다른 줄에 적고 나중에 정리하세요."
          }
        }
      }
    },
    "tendoGuideBrainDumpNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Brain Dump, then review its inbox when you are ready."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생각 비우기를 사용한 뒤 준비가 되면 받은 편지함을 살펴보세요."
          }
        }
      }
    },
    "tendoGuideBrainDumpSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
