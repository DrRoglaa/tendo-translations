            "state": "translated",
            "value": "하루로 돌아오는 네 가지 방법."
          }
        }
      }
    },
    "tendoOnboardingIfAPlannedTimePassesTheTaskIsStillAvailable": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a planned time passes, the task is still available."
