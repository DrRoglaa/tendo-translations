      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the next useful feature whenever you need it. No lessons to finish."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요할 때 유용한 다음 기능을 찾아보세요. 끝내야 할 수업은 없어요."
          }
        }
      }
    },
    "tendoGuideFocusExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with five minutes to write the first paragraph, then decide what is next."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5분 동안 첫 문단을 쓴 뒤 다음 할 일을 정하세요."
          }
        }
      }
