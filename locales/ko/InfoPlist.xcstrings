    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Apple calendar-permission explanation. Preserve meaning about access and confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo uses your calendar to show commitments and, only when you confirm, create, move, or remove a time block for a Tendo task."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo는 캘린더의 일정을 표시합니다. Tendo 할 일의 시간 블록은 확인을 받은 경우에만 생성하거나 이동 또는 삭제합니다."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "comment": "Apple Reminders-permission explanation. Preserve meaning about access and confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo uses Apple Reminders to show items due today or earlier and lets you mark them complete from Today."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo는 Apple 미리 알림에서 오늘까지 마감인 항목을 표시하고, 오늘 화면에서 완료로 표시할 수 있도록 합니다."
          }
        }
      }
    },
    "Tendo Encrypted Backup": {
      "comment": "System-facing permission or app name. Use clear platform terminology.",
      "extractionState": "manual",
      "localizations": {
        "en": {
