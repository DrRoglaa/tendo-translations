    "tendoSettingsAppleWatchShowsTheIphoneStartedFocusAsAPassive": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch shows the iPhone-started Focus as a passive Live Activity, so the iPhone remains the source of truth for that session."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Watch az iPhone-on indított Fókuszt passzív Élő tevékenységként jeleníti meg, így továbbra is az iPhone kezeli az alkalom hiteles állapotát."
          }
        }
      }
