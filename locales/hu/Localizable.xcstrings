    "tendoOnboardingTurnOnOnlyWhatHelpsYouSoftAmbientAndGentle": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only what helps you. Soft ambient and Gentle rain are stored locally in Tendo, pink, white, and brown noise are generated on-device, backups are encrypted locally and never include Apple Calendar or Reminders data, and Tendo does not store listening history."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak azt kapcsold be, ami segít. A Lágy háttérhang és a Gyengéd eső helyben, a Tendóban tárolódik, a rózsaszín, fehér és barna zaj az eszközön készül, a mentések helyben titkosítódnak és sosem tartalmaznak Apple Naptár- vagy Emlékeztetők-adatokat, és a Tendo nem tárol hallgatási előzményeket."
          }
        }
      }
    },
    "tendoOnboardingUseBrainDumpWhenYourHeadFeelsNoisyOrYou": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Brain Dump when your head feels noisy or you are worried you will forget something."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használd a Gondolatkiírást, ha túl sok minden kavarog a fejedben, vagy félsz, hogy elfelejtesz valamit."
          }
        }
      }
    },
    "tendoOnboardingUseNowWhenYouWantCalmGuidanceAClearNext": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Now when you want calm guidance, a clear next step, or a quick five-minute start."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használd a Most nézetet nyugodt útmutatáshoz, egyértelmű következő lépéshez vagy gyors ötperces kezdéshez."
          }
        }
      }
    },
    "tendoOnboardingUsePlanTodayForAGentleShortlistFindMeA": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Plan today for a gentle shortlist. Find me a place schedules only inside Tendo; Apple Calendar changes remain a separate, explicit action."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mai nap tervezése könnyed rövidlistát ad. A Keress helyet csak a Tendón belül ütemez; az Apple Naptár módosítása továbbra is külön, kifejezett művelet."
          }
        }
      }
    },
