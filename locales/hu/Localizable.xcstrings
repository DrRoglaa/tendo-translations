        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választásaid ezen az iPhone-on maradnak. Mindhárom emlékeztető ki van kapcsolva, amíg nem engedélyezed. Az iOS Fókusz vagy az Ütemezett összegzés késleltetheti az értesítést."
          }
