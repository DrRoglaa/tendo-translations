        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo csak azt ellenőrzi, hogy szól-e más hang. Soha nem látja, melyik alkalmazást, dalt, podcastot, hangoskönyvet vagy videót hallgatod."
