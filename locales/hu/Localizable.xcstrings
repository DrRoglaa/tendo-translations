        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Reggeli ráhangolódás és esti visszatekintés"
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a friendly nudge after 1, 3, or 7 days away from Tendo. Your inactivity countdown resets automatically when you return."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapj barátságos jelzést, ha 1, 3 vagy 7 napja nem használtad a Tendót. Amikor visszatérsz, a távollét számlálója automatikusan újraindul."
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Inactivity Reminders"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyengéd távolléti emlékeztetők"
          }
        }
      }
    },
    "tendoWhatsNewGentleQuietHoursDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize quiet hours and manage each reminder individually. Everything is optional, disabled by default, and scheduled locally on your device."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szabd személyre a csendes időszakokat, és kezeld külön az egyes emlékeztetőket. Minden választható, alapból kikapcsolt, és helyben, az eszközödön ütemezett."
          }
        }
      }
    },
    "tendoWhatsNewGentleQuietHoursTitle": {
