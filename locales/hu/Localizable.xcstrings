    "tendoSettingsIosOnlyShowsTheCalendarPermissionPromptTheFirstTime": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS only shows the Calendar permission prompt the first time. To allow Tendo again, open Settings and turn on Full Access."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS csak az első alkalommal kér naptárengedélyt. A Tendo újbóli engedélyezéséhez nyisd meg a Beállításokat, és kapcsold be a teljes hozzáférést."
          }
