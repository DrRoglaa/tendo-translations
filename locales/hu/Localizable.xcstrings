    "tendoSettingsCalendarContextIsOptionalAppleRequiresFullCalendarAccessTo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar Context is optional. Apple requires Full Calendar Access to read existing events. Find me a place can use busy Calendar events to suggest open time, but it never creates, moves, or deletes Calendar events. Block in Apple Calendar is a separate action and changes only the single Calendar block you explicitly confirm for a Tendo task. There is no automatic task-to-calendar sync. You can disconnect Calendar Context inside Tendo at any time; system permission is managed in iOS Settings. Event details are not copied into Tendo's SwiftData database."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Naptári háttér választható. A meglévő események olvasásához az Apple teljes naptárhozzáférést kér. A Keress helyet funkció a foglalt naptári események alapján javasolhat szabad időt, de soha nem hoz létre, helyez át vagy töröl naptári eseményt. Az Idő lefoglalása az Apple Naptárban külön művelet, és csak a Tendo-feladathoz kifejezetten jóváhagyott egyetlen időblokkot módosítja. Nincs automatikus feladat–naptár szinkronizálás. A Naptári hátteret bármikor leválaszthatod a Tendóban; a rendszerengedélyt az iOS Beállításaiban kezelheted. Az események részletei nem kerülnek át a Tendo SwiftData-adatbázisába."
          }
        }
      }
    },
    "tendoSettingsCalendarNamesAreUsedOnlyToChooseWhatAppearsIn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar names are used only to choose what appears in Tendo. Event details stay in memory and are not copied into SwiftData."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A naptárneveket csak a Tendóban megjelenő naptárak kiválasztásához használjuk. Az események részletei a memóriában maradnak, nem kerülnek a SwiftData-adatbázisba."
          }
        }
      }
    },
