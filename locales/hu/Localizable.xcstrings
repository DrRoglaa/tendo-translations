    "tendoSettingsBackupsAreCreatedAndEncryptedLocallyVerifiedLocallyAndRestored": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups are created and encrypted locally, verified locally, and restored locally. They include your real Tendo data and supported preferences, but never sample/test data, Apple Calendar or Reminders data, permissions, accounts, caches, diagnostics, Watch transfer state, or Live Activity state."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonsági mentések helyben készülnek és titkosítódnak, az ellenőrzés és a visszaállítás is helyben történik. Tartalmazzák a valódi Tendo-adataidat és a támogatott beállításokat, de minta- és tesztadatokat, Apple Naptár- és Emlékeztetők-adatokat, engedélyeket, fiókokat, gyorsítótárakat, diagnosztikát, Watch-átviteli állapotot és Élő tevékenység-állapotot soha."
          }
        }
      }
    },
