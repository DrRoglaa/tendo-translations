            "value": "Nyiss meg egy feladatot, és add hozzá a következő apró lépést."
          }
        }
      }
    },
    "tendoGuideTinyStepsSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break a difficult task into an action small enough to begin right now."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonts egy nehéz feladatot olyan apró lépésre, amit most rögtön el tudsz kezdeni."
          }
        }
      }
    },
    "tendoGuideTinyStepsTitle": {
      "comment": "In-app guide. Keep terminology consistent.",
      "extractionState": "manual",
      "localizations": {
