        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic sample week with work and home tasks, Tiny Steps, two routines, several completed and interrupted Focus sessions, and a few Brain Dump thoughts. Delete demo data removes only records created by this button — your own data is left alone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Létrehoz egy valószerű mintahetet munkahelyi és otthoni feladatokkal, Apró lépésekkel, két rutinnal, több befejezett és megszakított Fókusszal, valamint néhány kiírt gondolattal. A Demóadatok törlése csak az ezzel a gombbal létrehozott bejegyzéseket távolítja el – a saját adataid megmaradnak."
          }
        }
