        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A naptárnevek csak annak kiválasztására szolgálnak, hogy mi jelenjen meg a Tendóban. Az események részletei memóriában maradnak, és nem másolódnak a SwiftDatába."
          }
        }
      }
    },
