      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple controls the Calendar permission. Tendo reads selected events for context and only writes a Calendar event when you explicitly confirm Block Time. Turning the integration off takes effect immediately."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Naptár engedélyét az Apple kezeli. A Tendo a kiválasztott eseményeket háttérinformációként olvassa be, és csak akkor ír a Naptárba, ha kifejezetten jóváhagyod az Idő lefoglalása műveletet. Az integráció kikapcsolása azonnal érvényesül."
          }
        }
      }
    },
    "tendoSettingsAppleControlsTheRemindersPermissionTendoIntegrationControlsWhetherTendo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple controls the Reminders permission. Tendo integration controls whether Tendo actually reads or completes reminders. Turning it off takes effect immediately."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Emlékeztetők engedélyét az Apple kezeli. A Tendo integrációs beállítása szabályozza, hogy a Tendo ténylegesen beolvassa vagy késznek jelöli-e az emlékeztetőket. A kikapcsolás azonnal érvényesül."
          }
        }
      }
    },
    "tendoSettingsAppleKeepsThisSiriPermissionInTheShortcutsAppSo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple keeps this Siri permission in the Shortcuts app, so Tendo cannot move or duplicate the switch inside its own Settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple ezt a Siri-engedélyt a Parancsok appban tárolja, ezért a Tendo nem helyezheti át és nem másolhatja le a kapcsolót a saját Beállításaiba."
          }
        }
      }
    },
    "tendoSettingsAppleRemindersIntegrationIsOptionalTendoReadsIncompleteRemindersDue": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Reminders integration is optional. Tendo reads incomplete reminders due today or earlier from the lists you choose. If you mark one done in Tendo, that completion is saved back to Apple Reminders. Reminder contents are not copied into Tendo's SwiftData database."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Emlékeztetők integrációja választható. A Tendo a kiválasztott listák mai vagy korábbi esedékességű, befejezetlen emlékeztetőit olvassa be. Ha egyet késznek jelölsz a Tendóban, az Apple Emlékeztetőkben is elkészül. Az emlékeztetők tartalma nem kerül át a Tendo SwiftData-adatbázisába."
          }
        }
      }
    },
    "tendoSettingsAppleWatch": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
