    "tendoCommonDisconnectClearsTendosCalendarSelectionsAndStopsCalendarContextTo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect clears Tendo’s calendar selections and stops Calendar Context. To revoke Apple’s permission completely, use Manage Calendar permission."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A leválasztás törli a Tendo naptárválasztásait és leállítja a naptárkörnyezetet. Az Apple-engedély teljes visszavonásához nyisd meg a Naptárengedély kezelése lehetőséget."
          }
        }
      }
    },
    "tendoCommonDisconnectStopsTendoFromUsingRemindersAndForgetsYourSelected": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect stops Tendo from using Reminders and forgets your selected lists. iOS may still show Full Access until you revoke the system permission in Settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A leválasztás leállítja az Emlékeztetők használatát, és a Tendo elfelejti a kiválasztott listákat. Az iOS továbbra is teljes hozzáférést jelezhet, amíg a rendszerengedélyt vissza nem vonod a Beállításokban."
          }
        }
      }
    },
    "tendoCommonDisconnectingStopsTendoFromReadingCalendarAndClearsItsCalendar": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting stops Tendo from reading Calendar and clears its calendar selections. iOS permission itself can only be revoked in System Settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leválasztáskor a Tendo leállítja a Naptár olvasását, és törli a naptárválasztásokat. Az iOS engedélyét csak a rendszerbeállításokban vonhatod vissza."
          }
        }
      }
    },
