    "tendoOnboardingTodayPreviewShowingOneExactAppointmentAndOneFlexibleTask": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today preview showing one exact appointment and one flexible task"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Ma előnézete egy pontos időponttal és egy rugalmas feladattal"
          }
