    "tendoSettingsTendoDoesNotDiagnoseTreatOrCureAdhdOrAny": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo does not diagnose, treat, or cure ADHD or any other health condition. It is a productivity and focus tool designed with ADHD-related challenges in mind."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo nem diagnosztizál, kezel vagy gyógyít ADHD-t és más egészségi állapotot. A hatékony munkát és a fókuszálást segítő eszköz, amely az ADHD-val járó nehézségeket is figyelembe veszi."
          }
