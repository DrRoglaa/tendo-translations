    "tendoFocusFiveMinutesStillCountsIfSoundHelpsFocusEnvironmentCan": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes still counts. If sound helps, Focus Environment can add pink, white, or brown noise without stopping your music or podcast. If you get interrupted, Pick Up Where You Left Off helps you return without rebuilding the whole plan in your head."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Öt perc is számít. Ha segít a hang, a Fókuszkörnyezet rózsaszín, fehér vagy barna zajt adhat a zenéd vagy podcastod megszakítása nélkül. Ha félbeszakítanak, a Folytasd, ahol abbahagytad segít visszatérni anélkül, hogy fejben újra kellene építened az egész tervet."
          }
        }
      }
    },
    "tendoFocusFocusDurationSelectedminutesMinutes": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus duration, \\(selectedMinutes) minutes"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fókusz időtartama, \\(selectedMinutes) perc"
          }
        }
      }
    },
    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIoss": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated noise can step aside. If other audio begins, Tendo fades or stops its own noise and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fókuszkörnyezet opcionális és ingyenes. A Tendo az iOS általános jelzéséből érzékelheti, ha más hang szól, hogy a saját generált zaja félreállhasson. Más hang indulásakor a Tendo lehalkítja vagy leállítja a saját zaját, és a másik hang vége után nem indítja újra automatikusan. A Tendo nem tudja, melyik alkalmazás, dal, podcast, hangoskönyv vagy videó szól, és nem tárol vagy továbbít hallgatási előzményeket. A rózsaszín, fehér és barna zaj helyben készül, és a Tendo csak hangadás közben aktiválja a hangmunkamenetét."
          }
        }
      }
    },
    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIossVariant": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated sound can step aside. If other audio begins, Tendo fades or stops its own sound and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Soft ambient and pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fókuszkörnyezet opcionális és ingyenes. A Tendo az iOS általános jelzéséből érzékelheti, ha más hang szól, hogy a saját generált hangja félreállhasson. Más hang indulásakor a Tendo lehalkítja vagy leállítja a saját hangját, és a másik hang vége után nem indítja újra automatikusan. A Tendo nem tudja, melyik alkalmazás, dal, podcast, hangoskönyv vagy videó szól, és nem tárol vagy továbbít hallgatási előzményeket. A lágy háttérhang és a rózsaszín, fehér és barna zaj helyben készül, és a Tendo csak hangadás közben aktiválja a hangmunkamenetét."
          }
        }
      }
    },
    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIossVariant2": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated sound can step aside. If other audio begins, Tendo fades or stops its own sound and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Soft ambient, Gentle rain, and pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fókuszkörnyezet opcionális és ingyenes. A Tendo az iOS általános jelzéséből érzékelheti, ha más hang szól, hogy a saját generált hangja félreállhasson. Más hang indulásakor a Tendo lehalkítja vagy leállítja a saját hangját, és a másik hang vége után nem indítja újra automatikusan. A Tendo nem tudja, melyik alkalmazás, dal, podcast, hangoskönyv vagy videó szól, és nem tárol vagy továbbít hallgatási előzményeket. A lágy háttérhang, a Gyengéd eső és a rózsaszín, fehér és barna zaj helyben készül, és a Tendo csak hangadás közben aktiválja a hangmunkamenetét."
          }
        }
      }
    },
