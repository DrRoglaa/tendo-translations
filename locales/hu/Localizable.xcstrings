      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup from %1$(date)@: %2$(tasks)lld tasks, %3$(routines)lld routines, %4$(focusSessions)lld focus sessions. Restoring replaces the Tendo-owned data currently on this device. Calendar and Reminders are not changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztonsági mentés dátuma: %1$(date)@. Tartalma: %2$(tasks)lld feladat, %3$(routines)lld rutin, %4$(focusSessions)lld fókuszalkalom. A visszaállítás lecseréli az eszközön lévő Tendo-adatokat. A Naptár és az Emlékeztetők nem változnak."
