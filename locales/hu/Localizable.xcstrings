    "tendoFocusStartWith5MinutesChooseAGentle155Or": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment can stay quiet, keep your own audio, or add optional local background noise. When you stop, Tendo can remember your next tiny step so returning later takes less effort."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdd 5 perccel, válassz könnyed 15 / 5 vagy klasszikus 25 / 5 ritmust, és tarts szünetet, amikor szükséged van rá. Az Élő tevékenység és az Apple Watch segítségével mindig láthatod, hol tartasz. A Fókuszkörnyezet csendben maradhat, megtarthatja a saját hangodat, vagy helyi háttérzajt adhat hozzá. Amikor megállsz, a Tendo megjegyezheti a következő apró lépésedet, hogy később könnyebb legyen visszatérned."
          }
        }
      }
    },
    "tendoFocusStartWith5MinutesChooseAGentle155OrVariant": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, choose Soft ambient, or use optional pink, white, or brown noise. If other audio starts, Tendo sound steps aside."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdd 5 perccel, válassz könnyed 15 / 5 vagy klasszikus 25 / 5 ritmust, és tarts szünetet, amikor szükséged van rá. Az Élő tevékenység és az Apple Watch segítségével mindig láthatod, hol tartasz. A Fókuszkörnyezet alapból csendes: tartsd meg a jelenlegi hangot, válassz Lágy háttérhangot, vagy rózsaszín, fehér vagy barna zajt. Ha más hang indul, a Tendo hangja félreáll."
          }
        }
      }
    },
    "tendoFocusStartWith5MinutesChooseAGentle155OrVariant2": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, or choose optional pink, white, or brown noise. If other audio starts, Tendo noise steps aside."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdd 5 perccel, válassz könnyed 15 / 5 vagy klasszikus 25 / 5 ritmust, és tarts szünetet, amikor szükséged van rá. Az Élő tevékenység és az Apple Watch segítségével mindig láthatod, hol tartasz. A Fókuszkörnyezet alapból csendes: tartsd meg a jelenlegi hangot, vagy válassz rózsaszín, fehér vagy barna zajt. Ha más hang indul, a Tendo zaja félreáll."
          }
        }
      }
    },
