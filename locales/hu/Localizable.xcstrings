    "tendoShortcutsChooseAFocusDurationBetween1And240Minutes": {
      "comment": "Shortcuts interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
