      }
    },
    "tendoOnboardingTodayShowsExactTimeAnchorsFlexibleWindowsAndWhatFits": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and What Fits Now. Find me a place can suggest a calm opening for a task, while Week helps you spread things out without treating every change like failure."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Ma megmutatja a pontos időpontokat, a rugalmas idősávokat és a Mi fér bele most? lehetőséget. A Keress helyet nyugodt szabad időt javasolhat egy feladathoz, a Hét pedig segít elosztani a dolgokat anélkül, hogy minden változást kudarcnak tekintene."
          }
        }
      }
    },
    "tendoOnboardingTodayShowsExactTimeAnchorsFlexibleWindowsAndWhatIs": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and what is still available — without turning a changed plan into failure."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Ma megmutatja a pontos időpontokat, a rugalmas idősávokat és azt, ami még elérhető – anélkül, hogy a terv változását kudarccá tenné."
          }
        }
      }
    },
    "tendoOnboardingTue": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
