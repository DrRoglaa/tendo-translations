    "tendoMomentumTendoDerivesHomeGrowthFromYourRealTasksTinySteps": {
      "comment": "Momentum interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo derives home growth from your real tasks, Tiny Steps, Focus sessions, and routines. There is no XP, currency, daily quota, or streak to protect. Once a home detail appears, it stays. Demo data never changes your personal Companion Home."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo az otthon fejlődését a valódi feladataidból, Apró lépéseidből, Fókuszaidból és rutinjaidból vezeti le. Nincs XP, pénznem, napi kvóta vagy megőrzendő sorozat. Ha egy otthoni részlet megjelenik, meg is marad. A demóadatok sosem módosítják a személyes Társotthonodat."
          }
        }
      }
    },
    "tendoMomentumTendoDerivesHomeGrowthFromYourRealTasksTinyStepsVariant": {
      "comment": "Momentum interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo derives home growth from your real tasks, Tiny Steps, Focus sessions, and routines. There is no XP, currency, daily quota, or streak to protect. Once a home detail appears, it stays. Demo data never permanently unlocks home details."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo az otthon fejlődését a valódi feladataidból, Apró lépéseidből, Fókuszaidból és rutinjaidból vezeti le. Nincs XP, pénznem, napi kvóta vagy megőrzendő sorozat. Ha egy otthoni részlet megjelenik, meg is marad. A demóadatok sosem oldanak fel véglegesen otthoni részleteket."
          }
        }
      }
    },
