    "tendoSettingsFollowUpNudgesUseASmallSetOfOnDevice": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow-up nudges use a small set of on-device rules to recognize obvious everyday task sequences, such as laundry or the dishwasher. Tendo may suggest a likely earlier or next step, but it never assumes the step happened and never creates a task or reminder until you choose it. Task wording is not sent anywhere for this feature."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő lépésre ösztönzés néhány eszközön futó szabállyal ismeri fel az olyan egyértelmű hétköznapi feladatsorokat, mint a mosás vagy a mosogatás. A Tendo javasolhat egy valószínű korábbi vagy következő lépést, de soha nem feltételezi, hogy megtörtént, és nem hoz létre feladatot vagy emlékeztetőt, amíg nem választod ki. A funkció sehová nem küldi el a feladatok szövegét."
          }
        }
      }
    },
