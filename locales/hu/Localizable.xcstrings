    "tendoSettingsWidgetsIntentionallyDoNotReadYourPrivateTaskDatabaseIn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets intentionally do not read your private task database in the current version. They stay useful without requiring shared app-group storage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A widgetek a jelenlegi verzióban szándékosan nem olvassák a privát feladatadatbázisodat. Közös appcsoport-tárhely nélkül is hasznosak maradnak."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndCompanion": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments & Companion"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikerpillanatok és társ"
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheCompanionStayQuietProgressStillReflects": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the companion stay quiet. Progress still reflects your real activity."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sikerpillanatok és a társ csendben maradnak. A Haladás továbbra is a valódi tevékenységedet tükrözi."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheOptionalMomentumCompanionAreLocalPresentation": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the optional Momentum companion are local presentation features. Today's Wins and companion milestones are derived from your existing tasks, Tiny Steps, Focus history, and routines; Tendo does not create a separate XP, currency, streak, or analytics profile. Your companion choice is stored locally and changing it never changes your progress."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sikerpillanatok és a választható Lendület-társ helyi megjelenítési funkciók. A mai sikerek és a társ mérföldkövei a meglévő feladatokból, Apró lépésekből, Fókusz-előzményekből és rutinokból származnak; a Tendo nem hoz létre külön tapasztalatipont-, pénznem-, sorozat- vagy elemzési profilt. A választott társ helyben tárolódik, és módosítása soha nem változtatja meg a haladásodat."
          }
        }
      }
    },
    "tendoSettingsWriteAReview": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a Review"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értékelés írása"
          }
        }
      }
    },
    "tendoSettingsYesterday": {
      "comment": "Settings interface. Keep terminology consistent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnap"
          }
        }
      }
