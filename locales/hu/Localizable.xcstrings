    "tendoTasksBusyCalendarEventsAndExactTimeTendoTasksCountAs": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Busy Calendar events and exact-time Tendo tasks count as occupied. All-day events and events marked Free do not block the day."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A foglaltnak jelölt naptári események és a pontos időre ütemezett Tendo-feladatok foglalják az idődet. Az egész napos és a szabadnak jelölt események nem foglalják le a napot."
          }
        }
      }
    },
    "tendoTasksBusyCalendarEventsHelpShapeTheseSuggestionsFindMeA": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Busy Calendar events help shape these suggestions. Find me a place does not create, move, or delete Calendar events."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A foglalt naptári események segítenek kialakítani ezeket a javaslatokat. A Keress helyet nem hoz létre, helyez át vagy töröl naptári eseményt."
          }
        }
      }
    },
