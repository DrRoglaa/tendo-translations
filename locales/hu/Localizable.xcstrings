        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Öt perc is számít. A Tendónak sosem kell tudnia, mit hallgatsz. Ha félbeszakítanak, a Folytasd, ahol abbahagytad közvetlen visszautat ad, az Üdv újra pedig könnyeddé teszi a visszatérést."
          }
        }
      }
