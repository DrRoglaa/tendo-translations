      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments are local completion feedback. They do not create scores, streaks, profiles, or analytics, and nothing about a Win Moment is sent off-device."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sikerpillanatok helyi visszajelzések az elvégzett dolgokról. Nem hoznak létre pontszámokat, sorozatokat, profilokat vagy elemzéseket, és semmilyen adatuk nem hagyja el az eszközt."
          }
