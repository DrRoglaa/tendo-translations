    "tendoOnboardingStart5GetsYouMovingWhenYouKnowWhatTo": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start 5 gets you moving when you know what to do. What Fits Now helps you choose. I'm Stuck turns a blocked task into one physical next move. Welcome Back remembers your place after an interruption."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az 5 perc indítása segít belevágni, ha tudod, mit tennél. A Mi fér bele most? segít választani. Az Elakadtam egy konkrét fizikai lépéssé alakítja az elakadt feladatot. Az Üdv újra megjegyzi, hol tartottál a megszakítás előtt."
          }
        }
      }
    },
    "tendoOnboardingStartFor5Minutes": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start for 5 minutes"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdj 5 perccel"
          }
        }
      }
    },
    "tendoOnboardingStartSmallFocusGently": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start small. Focus gently."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdj kicsiben. Fókuszálj nyugodtan."
          }
        }
      }
    },
    "tendoOnboardingStartWith5MinutesChooseAGentle155Or": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, choose Soft ambient or Gentle rain, or use optional pink, white, or brown noise. If other audio starts, Tendo sound steps aside."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdd 5 perccel, válassz könnyed 15 / 5 vagy klasszikus 25 / 5 ritmust, és tarts szünetet, amikor szükséged van rá. Az Élő tevékenység és az Apple Watch segítségével mindig láthatod, hol tartasz. A Fókuszkörnyezet alapból csendes: tartsd meg a jelenlegi hangot, válassz Lágy háttérhangot vagy Gyengéd esőt, vagy használj rózsaszín, fehér vagy barna zajt. Ha más hang indul, a Tendo hangja félreáll."
          }
        }
      }
    },
    "tendoOnboardingStartWithOneRoutineOrganizeMoreWhenYouNeedIt": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one routine. Organize more only when your routine library grows."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdj egy rutinnal. Csak akkor rendszerezz többet, ha nő a rutingyűjteményed."
          }
        }
      }
    },
    "tendoOnboardingStartWithOneThing": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
