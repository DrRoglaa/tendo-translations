    "tendoSettingsWhenFocusStartsOnYourWatchTheWatchAppStays": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Focus starts on your Watch, the Watch app stays the primary wrist experience while Tendo keeps the iPhone in sync."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a Fókuszt az órádon indítod, a Watch app marad az elsődleges csuklós felület, a Tendo pedig szinkronban tartja az iPhone-t."
          }
        }
      }
    },
    "tendoSettingsWhenSiriAccessIsEnabledForTendoYouCanUse": {
