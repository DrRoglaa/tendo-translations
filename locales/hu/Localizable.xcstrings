        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo helyben, az eszközödön ütemezi ezeket. Nem olvassa a naptáradat, és nem találgatja, mikor kell elindulnod."
          }
        }
      }
    },
