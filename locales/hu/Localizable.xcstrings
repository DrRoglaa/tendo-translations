        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo használatához nem kell fiók. A feladatok, rutinok, fókuszelőzmények és egyéb személyes, munkaszervezési adatok lehetőség szerint az eszközödön maradnak."
          }
        }
      }
    },
