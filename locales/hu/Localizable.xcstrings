    "tendoCommonTendoCanCreateAPasswordProtectedTendobackupFileTheBackup": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can create a password-protected .tendobackup file. The backup is created and encrypted locally on this device. Tendo does not upload, receive, store, or have access to your backup files or backup passwords. Demo/test data, Calendar and Reminders data, system permissions, account information, caches, diagnostics, and transient state are not included. If you export a backup, you choose where the encrypted file is stored or shared using Apple's system interfaces. Tendo cannot recover a backup if the password is lost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo jelszóval védett .tendobackup fájlt tud létrehozni. A mentés helyben, ezen az eszközön készül és titkosítódik. A Tendo nem tölti fel, nem fogadja, nem tárolja és nem éri el a mentési fájljaidat vagy a hozzájuk tartozó jelszavakat. A mentés nem tartalmaz demó- és tesztadatokat, naptár- és emlékeztetőadatokat, rendszerengedélyeket, fiókadatokat, gyorsítótárakat, diagnosztikát vagy átmeneti állapotokat. Exportáláskor az Apple rendszerfelületein te választod ki, hol tárolod vagy osztod meg a titkosított fájlt. Elveszett jelszó esetén a Tendo nem tudja visszaállítani a mentést."
          }
        }
      }
    },
    "tendoCommonTendoCouldntCompleteTheRestoreSafelyPleaseRestartTendoBefore": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't complete the restore safely. Please restart Tendo before making changes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo nem tudta biztonságosan befejezni a visszaállítást. Módosítás előtt indítsd újra a Tendót."
          }
        }
      }
    },
