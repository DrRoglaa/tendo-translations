    "tendoSettingsCreatesARealisticSyntheticWeekWith36MixedWorkAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, including follow-up nudge examples, Tiny Steps, three routines, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete Sample Data removes only records created here — your own data is left alone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Életszerű mintahetet készít 36 vegyes munkahelyi és otthoni feladattal, köztük következő lépésre ösztönző példákkal, Apró lépésekkel, három rutinnal, változatos befejezett és megszakított Fókusz-előzményekkel és kiírt gondolatokkal. A Mintaadatok törlése csak az itt létrehozott rekordokat távolítja el — a saját adataidat érintetlenül hagyja."
          }
        }
      }
    },
    "tendoSettingsCreatesARealisticSyntheticWeekWithRoutineFolders": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, Tiny Steps, 16 routines organized into four folders, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete Sample Data removes only records created here — your own data is left alone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Életszerű mintahetet készít 36 vegyes munkahelyi és otthoni feladattal, Apró lépésekkel, négy mappába rendezett 16 rutinnal, változatos befejezett és megszakított Fókusz-előzményekkel és kiírt gondolatokkal. A Mintaadatok törlése csak az itt létrehozott rekordokat távolítja el — a saját adataidat érintetlenül hagyja."
          }
