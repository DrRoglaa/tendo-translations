    "tendoTipBrainDump": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Make Task to move a thought into Tasks; the original stays under Processed until you clear it."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Feladat készítése művelettel vihetsz át egy gondolatot a Feladatok közé; az eredeti a Feldolgozottak között marad, amíg ki nem üríted."
          }
        }
      }
    },
    "tendoTipCalendar": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar and Reminders provide optional context without turning events into tasks."
          }
