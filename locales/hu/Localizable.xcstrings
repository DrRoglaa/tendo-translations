    "tendoFocusEnvironmentDefaultVolumeExplanation": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New installs start at %1$(text)@. This controls only Tendo's Focus Environment sound; your iPhone volume still controls the overall output. Tendo sound never starts automatically unless you turn this option on."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Új telepítéskor a kezdőérték %1$(text)@. Ez csak a Tendo Fókuszkörnyezet hangját szabályozza; a teljes hangerőt továbbra is az iPhone hangereje határozza meg. A Tendo hangja csak akkor indul automatikusan, ha bekapcsolod ezt a lehetőséget."
          }
        }
      }
    },
    "tendoFocusFinishActionTitle": {
