    "tendoSettingsTendoCanCreateAPasswordProtectedTendobackupFileTheBackup": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can create a password-protected .tendobackup file. The backup is created and encrypted locally, and it is verified and restored locally on this device. Tendo does not upload, receive, store, or have access to your backup files or backup passwords. Demo/test data, Calendar and Reminders data, system permissions, account information, caches, diagnostics, and transient state are not included. If you export a backup, you choose where the encrypted file is stored or shared using Apple's system interfaces. Tendo keeps only the dates of your last successful backup and restore locally for display in Settings. Tendo cannot recover a backup if the password is lost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo jelszóval védett .tendobackup fájlt készíthet. A biztonsági mentés helyben készül és titkosítódik, az ellenőrzés és a visszaállítás is helyben, ezen az eszközön történik. A Tendo nem tölti fel, nem fogadja, nem tárolja a mentési fájljaidat és jelszavaidat, és nem fér hozzájuk. A mentés nem tartalmaz bemutató- és tesztadatokat, Naptár- és Emlékeztetők-adatokat, rendszerengedélyeket, fiókadatokat, gyorsítótárakat, diagnosztikát és átmeneti állapotot. Ha exportálsz egy mentést, te választod ki az Apple rendszerfelületein, hol tárolod vagy osztod meg a titkosított fájlt. A Tendo csak az utolsó sikeres mentés és visszaállítás dátumát tárolja helyben, hogy megjelenítse a Beállításokban. A Tendo nem tudja helyreállítani a mentést, ha a jelszó elveszik."
          }
        }
      }
    },
    "tendoSettingsTendoCanGentlyAcknowledgeACompletedTaskTinyStepFocus": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can gently acknowledge a completed task, Tiny Step, Focus, routine, or return after an interruption."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo finoman elismerheti egy feladat, Apró lépés, Fókusz vagy rutin befejezését, illetve a megszakítás utáni visszatérést."
          }
        }
      }
    },
