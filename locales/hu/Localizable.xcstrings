    "tendoGuideTipsSettingFootnote": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips can be turned off without affecting necessary instructions. Explore Tendo stays available."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tippeket kikapcsolhatod a szükséges utasítások nélkülözése nélkül. A Tendo felfedezése továbbra is elérhető."
          }
        }
      }
    },
    "tendoGuideTodayExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meeting stays at its exact time; groceries can fit in a flexible afternoon window."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megbeszélés marad a pontos időpontjában; a bevásárlás beleférhet egy rugalmas délutáni idősávba."
          }
        }
      }
    },
    "tendoGuideTodayNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Today and try Plan Today or What Fits Now."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Ma nézetet, és próbáld a Mai nap tervezése vagy a Mi fér bele most? lehetőséget."
          }
        }
      }
    },
    "tendoGuideTodaySummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your scheduled work, flexible windows, and optional calendar context together."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lásd együtt az ütemezett munkát, a rugalmas idősávokat és az opcionális naptári környezetet."
          }
        }
      }
    },
