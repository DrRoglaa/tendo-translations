      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Apple language files can be shared for review, with checks that protect newer translations and saved Tendo data."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple natív nyelvi fájljai megoszthatók ellenőrzésre. Az ellenőrzések védik az újabb fordításokat és a mentett Tendo-adatokat."
          }
        }
      }
    },
    "tendoWhatsNew132SharingTitle": {
