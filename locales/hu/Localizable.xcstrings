    "tendoSettingsYouCanPauseOrStopWheneverYouNeedToThe": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pause or stop whenever you need to. The time you already focused still counts."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor szüneteltetheted vagy leállíthatod, ha szükséged van rá. A fókuszálással töltött idő továbbra is számít."
          }
        }
      }
    },
    "tendoSettingsYourOptionalPreferredNameIsStoredLocallyByTendoAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your optional preferred name is stored locally by Tendo and is used only to personalize greetings inside the app. It is included only when you choose to create an encrypted local Tendo backup. Tendo does not read your Contacts or Apple Account to obtain your name."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választható megszólítást a Tendo helyben tárolja, és csak az appon belüli köszöntések személyre szabására használja. Csak akkor kerül mentésbe, ha titkosított helyi Tendo-mentést készítesz. A Tendo nem olvassa ki a nevedet a Kontaktokból vagy az Apple-fiókodból."
          }
        }
      }
    },
    "tendoSettingsYourOptionalPreferredNameIsStoredOnlyByTendoAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your optional preferred name is stored only by Tendo and is used to personalize the greeting on Now. Leave it blank to keep the standard greeting."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választható megszólítást csak a Tendo tárolja, és a Most nézet köszöntését szabja vele személyre. Hagyd üresen az alapértelmezett köszöntéshez."
          }
        }
      }
    },
    "tendoSettingsYourPasswordIsUsedOnlyOnThisDeviceToUnlock": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is used only on this device to unlock the selected backup and is never stored by Tendo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszavadat csak ezen az eszközön használjuk a kiválasztott mentés feloldásához, és a Tendo soha nem tárolja."
          }
        }
      }
    },
    "tendoSettingsYourTasksRoutinesFocusHistoryTinyStepsAndBrainDump": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, routines, focus history, Tiny Steps, and Brain Dump stay in Tendo’s private local app storage. Apple Watch sharing uses only compact snapshots and actions, not the full SwiftData database."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A feladataid, rutinjaid, fókuszelőzményeid, Apró lépéseid és kiírt gondolataid a Tendo privát, helyi apptárhelyén maradnak. Az Apple Watch megosztása csak tömör állapotképeket és műveleteket használ, a teljes SwiftData-adatbázist nem."
          }
        }
      }
    },
    "tendoSettingsYourTendoRecordsStayLocalUnlessYouExplicitlyExportAn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Tendo records stay local unless you explicitly export an encrypted backup."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo-rekordjaid helyben maradnak, kivéve, ha kifejezetten exportálsz egy titkosított biztonsági mentést."
          }
        }
      }
    },
    "tendoShortcutsAddAtLeastOneStepToThatRoutineBeforeStarting": {
      "comment": "Shortcuts interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
