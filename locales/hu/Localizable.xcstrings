    "tendoCommonStartWith5MinutesChooseAGentle155Or": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdd 5 perccel, válassz könnyed 15 / 5 vagy klasszikus 25 / 5 ritmust, és tarts szünetet, amikor szükséged van rá. Az Élő tevékenység és az Apple Watch segítségével mindig láthatod, hol tartasz."
          }
        }
      }
    },
    "tendoCommonStartWith5MinutesChooseAGentle155OrVariant": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. When you stop, Tendo can remember your next tiny step so returning later takes less effort."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdd 5 perccel, válassz könnyed 15 / 5 vagy klasszikus 25 / 5 ritmust, és tarts szünetet, amikor szükséged van rá. Az Élő tevékenység és az Apple Watch segítségével mindig láthatod, hol tartasz. Amikor megállsz, a Tendo megjegyezheti a következő apró lépésedet, hogy később könnyebb legyen visszatérned."
          }
        }
      }
    },
