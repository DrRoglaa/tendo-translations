        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, mit viszel tovább"
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an optional morning reminder to start your day with intention, or an evening reflection to review your progress. Choose the times that suit you."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állíts be egy választható reggeli emlékeztetőt a tudatos napkezdéshez, vagy esti visszatekintést a haladásod áttekintéséhez. Válassz hozzád illő időpontokat."
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
