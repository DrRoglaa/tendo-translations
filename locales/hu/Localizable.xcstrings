            "value": "Tendo will immediately stop loading calendar events and forget which calendars you selected. Your Apple Calendar data is not changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tendo azonnal leállítja a naptári események betöltését, és elfelejti a kiválasztott naptárakat. Az Apple Naptár adatai nem változnak."
          }
        }
      }
