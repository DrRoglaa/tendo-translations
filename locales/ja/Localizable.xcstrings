    "tendoCommonWhatFitsNow": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Fits Now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今できること"
          }
        }
      }
    },
    "tendoCommonWhatFitsNowCanSuggestABestFitAQuick": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Fits Now can suggest a best fit, a quick win, and a stretch option. Rescue Mode helps when you know the task but feel stuck. Lock Screen actions can jump you straight in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今できること」では、ぴったりの候補、すぐできること、少し挑戦することを提案します。やることは分かっているのに進めないときはレスキューモードを。ロック画面の操作ですぐに始められます。"
          }
        }
      }
    },
    "tendoCommonWhatFitsNowInApplicationname": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What fits now in \\(.applicationName)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(.applicationName)で今できること"
          }
        }
      }
    },
    "tendoCommonWhen": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
