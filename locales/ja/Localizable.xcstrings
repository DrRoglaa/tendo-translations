    },
    "tendoWhatsNew132Subtitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language support is taking shape — translations and proofreading are still in progress."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多言語対応を進めています。翻訳と校正はまだ進行中です。"
          }
        }
      }
    },
    "tendoWhatsNew132TranslationsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Essential controls now have early translations in seven additional languages. Untranslated text still appears in English."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主要な操作項目を新たに7言語で仮翻訳しました。未翻訳のテキストは引き続き英語で表示されます。"
          }
        }
      }
    },
    "tendoWhatsNew132TranslationsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More languages, one calm experience"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語が増えても、変わらない心地よさ"
          }
        }
      }
    },
    "tendoWhatsNewCalmerSettingsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings are now organized into focused pages, with clearer status and less scrolling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を項目ごとのページに整理しました。状態がわかりやすくなり、スクロールも少なくなりました。"
          }
        }
      }
    },
    "tendoWhatsNewCalmerSettingsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calmer Settings experience"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より落ち着いた設定画面"
          }
        }
      }
    },
    "tendoWhatsNewCalmerTendoDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks, Task details, Settings, and Focus Live Activities have been refined to feel cleaner and easier to scan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、タスクの詳細、設定、集中のライブアクティビティを整え、すっきりと見やすくしました。"
          }
        }
      }
    },
    "tendoWhatsNewCalmerTendoTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calmer Tendo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より落ち着いたTendo"
          }
        }
      }
    },
    "tendoWhatsNewCarryForwardDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished tasks from an earlier day no longer have to become today’s backlog. Review them and choose what you actually want to carry forward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の日に終わらなかったタスクを、すべて今日に持ち越す必要はありません。見直して、本当に引き継ぎたいものを選べます。"
          }
        }
      }
    },
    "tendoWhatsNewCarryForwardTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what comes with you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ち越すものを選ぶ"
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an optional morning reminder to start your day with intention, or an evening reflection to review your progress. Choose the times that suit you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日を意識して始める朝のリマインダーや、進捗を振り返る夜の時間を、必要に応じて設定できます。自分に合う時刻を選んでください。"
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning Check-ins & Evening Reflections"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝のチェックインと夜の振り返り"
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a friendly nudge after 1, 3, or 7 days away from Tendo. Your inactivity countdown resets automatically when you return."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendoを1日、3日、7日使わなかったときに、やさしくお知らせします。戻ってくると、経過日数のカウントは自動でリセットされます。"
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Inactivity Reminders"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく使っていないときのやさしい通知"
          }
        }
      }
    },
    "tendoWhatsNewGentleQuietHoursDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize quiet hours and manage each reminder individually. Everything is optional, disabled by default, and scheduled locally on your device."
          }
        },
        "ja": {
