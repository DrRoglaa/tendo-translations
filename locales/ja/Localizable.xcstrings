    "tendoOnboardingTodayPreviewShowingOneExactAppointmentAndOneFlexibleTask": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today preview showing one exact appointment and one flexible task"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻指定の予定1つと柔軟なタスク1つがある「今日」のプレビュー"
          }
        }
      }
    },
    "tendoOnboardingTodayShowsExactTimeAnchorsFlexibleWindowsAndWhatFits": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and What Fits Now. Find me a place can suggest a calm opening for a task, while Week helps you spread things out without treating every change like failure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日」では時刻指定、柔軟な時間帯、「今できること」を確認できます。「場所を探す」がタスクに合う余裕のある時間を提案し、「週」で予定を分散できます。変更しても失敗ではありません。"
          }
        }
      }
    },
    "tendoOnboardingTodayShowsExactTimeAnchorsFlexibleWindowsAndWhatIs": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and what is still available — without turning a changed plan into failure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日」には時刻指定、柔軟な時間帯、まだできることを表示します。計画が変わっても失敗にはしません。"
          }
        }
      }
    },
    "tendoOnboardingTue": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "火"
          }
        }
      }
    },
    "tendoOnboardingTurnOnOnlyWhatHelpsYouSoftAmbientAndGentle": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only what helps you. Soft ambient and Gentle rain are stored locally in Tendo, pink, white, and brown noise are generated on-device, backups are encrypted locally and never include Apple Calendar or Reminders data, and Tendo does not store listening history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "役立つものだけをオンにしましょう。柔らかな環境音とやさしい雨音はTendo内に保存され、ピンク、ホワイト、ブラウンノイズはデバイス内で生成します。バックアップはローカルで暗号化され、Appleカレンダーやリマインダーのデータは含みません。再生履歴は保存しません。"
          }
        }
      }
    },
    "tendoOnboardingUseBrainDumpWhenYourHeadFeelsNoisyOrYou": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Brain Dump when your head feels noisy or you are worried you will forget something."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭が騒がしいときや忘れそうで心配なときは、「頭の中を書き出す」を使いましょう。"
          }
        }
      }
    },
    "tendoOnboardingUseNowWhenYouWantCalmGuidanceAClearNext": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Now when you want calm guidance, a clear next step, or a quick five-minute start."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穏やかな案内、明確な次の一歩、すぐに5分始めたいときは「今」を使いましょう。"
          }
        }
      }
    },
    "tendoOnboardingUsePlanTodayForAGentleShortlistFindMeA": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Plan today for a gentle shortlist. Find me a place schedules only inside Tendo; Apple Calendar changes remain a separate, explicit action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日の計画」でやさしい候補リストを。「場所を探す」はTendo内だけで予定を設定します。Appleカレンダーの変更は別途、明示的な操作が必要です。"
          }
        }
      }
    },
    "tendoOnboardingWatch": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
