    "tendoCommonCountsShowYourRealTendoRecordsOnThisDeviceDemo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts show your real Tendo records on this device. Demo data is not included."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示される数は、このデバイス上の実際のTendo記録に基づきます。デモデータは含みません。"
          }
        }
      }
    },
    "tendoCommonCreateRoutinesNoticeTodaysWinsAndReviewProgressOverTime": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create routines, notice Today's wins, and review progress over time. Win Moments can gently acknowledge meaningful starts and finishes without points or streak pressure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティンを作り、今日の達成に気づき、進捗を振り返りましょう。「達成の瞬間」は点数や連続記録のプレッシャーなしに大切な開始と完了をそっと認めます。"
          }
        }
      }
    },
    "tendoCommonCreateRoutinesTrackMomentumAndReviewProgressOverTimeSo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create routines, track momentum, and review progress over time so helpful patterns are easier to keep repeating."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティンと進捗の確認で勢いをつけ、役立つ習慣を続けやすくしましょう。"
          }
        }
      }
    },
    "tendoCommonCreatesARealisticSyntheticWeekWith36MixedWorkAnd": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, including follow-up nudge examples, Tiny Steps, three routines, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete demo data removes only records created by this button — your own data is left alone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕事と家事のタスク36件、フォローアップの通知例、小さなステップ、3つのルーティン、完了・中断した集中履歴、書き留めた考えを含む現実的なサンプル週を作成します。デモデータを削除しても、このボタンで作った記録だけが消え、個人データは残ります。"
          }
        }
      }
    },
    "tendoCommonCurrently": {
