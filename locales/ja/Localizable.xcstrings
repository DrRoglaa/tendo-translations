    "tendoTasksRightNowTendoIsUsingOnlyYourTendoScheduleConnect": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right now Tendo is using only your Tendo schedule. Connect Calendar Context if you want busy events considered too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在はTendoの予定だけを使っています。カレンダーの埋まった時間も考慮するには、カレンダーの情報を接続してください。"
          }
        }
      }
    },
    "tendoTasksSchedule": {
