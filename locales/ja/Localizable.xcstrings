        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(taskTitle)@に向き合いました。ここで終えても大丈夫です。"
          }
        }
      }
    },
    "tendoCommonYouGaveThisYourAttentionThatMatters": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
