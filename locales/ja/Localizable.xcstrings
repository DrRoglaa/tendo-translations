        }
      }
    },
    "tendoFocusTendoAddsNoSoundOtherAudioIsNeverStoppedJust": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo adds no sound. Other audio is never stopped just because Focus starts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendoは音を追加しません。集中を始めただけで他の音声が止まることはありません。"
          }
        }
      }
    },
    "tendoFocusTendoNeverPausesAppleMusicSpotifyPodcastsYoutubeOrOther": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo never pauses Apple Music, Spotify, podcasts, YouTube, or other audio just because Focus starts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中を始めただけでApple Music、Spotify、ポッドキャスト、YouTubeなどを一時停止することはありません。"
          }
        }
      }
    },
    "tendoFocusTendoOnlyChecksWhetherOtherAudioIsActiveItNever": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo only checks whether other audio is active. It never sees the app, song, podcast, audiobook, or video you are playing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendoが確認するのは他の音声が再生中かどうかだけです。再生中のアプリ、曲、ポッドキャスト、オーディオブック、動画の内容は取得しません。"
          }
        }
      }
    },
