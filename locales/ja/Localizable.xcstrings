      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One gentle reminder after the selected number of days without opening Tendo. Returning resets the count. Opens Today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendoを開かずに指定の日数が経つと、やさしく1回通知します。戻ると日数はリセットされます。「今日」を開きます。"
          }
        }
      }
    },
    "tendoGentleInactivityNotificationBody": {
