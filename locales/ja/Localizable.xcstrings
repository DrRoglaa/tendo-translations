      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task can have notes, an icon, a next tiny step, timing, and follow-up actions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクにはメモ、アイコン、次の小さなステップ、日時、フォローアップを設定できます。"
          }
        }
      }
    },
