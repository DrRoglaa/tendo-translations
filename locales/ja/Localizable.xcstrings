    "tendoGuideBrainDumpNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Brain Dump, then review its inbox when you are ready."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「頭の中を書き出す」を使い、準備ができたら受信箱を確認しましょう。"
          }
        }
      }
    },
    "tendoGuideBrainDumpSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture loose thoughts quickly, then decide later whether each one belongs in Tasks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "浮かんだことをさっと記録し、タスクにするかどうかはあとで決めましょう。"
          }
        }
      }
    },
