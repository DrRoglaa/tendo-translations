    "tendoGuideWeekExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Wednesday looks crowded, find a calmer place for a flexible task."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水曜が混み合っていたら、柔軟なタスクを余裕のある場所へ。"
          }
        }
      }
    },
    "tendoGuideWeekNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Week from Today and try Make Room when needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日」から「週」を開き、必要に応じて「余裕を作る」を試しましょう。"
          }
        }
      }
    },
    "tendoGuideWeekSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review upcoming capacity without turning every day into a packed schedule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日を予定で埋めずに、これからの余裕を確認できます。"
          }
        }
      }
    },
