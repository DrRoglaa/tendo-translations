      }
    },
    "tendoSettingsWhenFocusStartsOnYourWatchTheWatchAppStays": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Focus starts on your Watch, the Watch app stays the primary wrist experience while Tendo keeps the iPhone in sync."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchから集中を始めると、手首ではWatchアプリが中心となり、TendoがiPhoneと同期します。"
          }
        }
      }
    },
    "tendoSettingsWhenSiriAccessIsEnabledForTendoYouCanUse": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Siri access is enabled for Tendo, you can use the phrase above to start Focus by voice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TendoのSiriアクセスを有効にすると、上のフレーズで声から集中を始められます。"
          }
        }
      }
    },
    "tendoSettingsWhenYouNeedAReset": {
