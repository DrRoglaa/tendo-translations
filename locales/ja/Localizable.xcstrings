    "tendoFocusCreatesARealisticSampleWeekWithWorkAndHomeTasks": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic sample week with work and home tasks, Tiny Steps, two routines, several completed and interrupted Focus sessions, and a few Brain Dump thoughts. Delete demo data removes only records created by this button — your own data is left alone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕事と家のタスク、小さなステップ、2つのルーティン、完了・中断した集中セッション、頭の中のメモを含むサンプルの1週間を作成します。「デモデータを削除」はこのボタンで作成した記録だけを削除し、自分のデータは保持します。"
          }
        }
      }
    },
