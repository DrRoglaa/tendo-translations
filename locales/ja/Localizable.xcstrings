    "tendoGuideWidgetsSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home and Lock Screen widgets provide shortcuts back into Tendo without exposing your private task library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面とロック画面のウィジェットから、非公開のタスク一覧を見せずにTendoへ戻れます。"
          }
        }
      }
    },
