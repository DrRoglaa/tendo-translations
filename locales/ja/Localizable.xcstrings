    "tendoOnboardingCaptureFirstOrganizeLater": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture first. Organize later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず書き留めて、整理はあとで。"
          }
        }
      }
    },
    "tendoOnboardingChooseYourOwnTimeA25MinuteFocusOrA": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your own time, a 25-minute focus, or a gentler 15-minute focus. Breaks are optional, and 5 minutes is always a valid place to begin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間を自由に選ぶか、25分の集中、やさしい15分の集中を選べます。休憩は任意で、5分から始めてもいつでも大丈夫。"
          }
        }
      }
    },
    "tendoOnboardingClosesOnboarding": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes onboarding"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期案内を閉じます"
          }
        }
      }
    },
    "tendoOnboardingCreateRoutinesNoticeTodaysWinsAndReviewProgressOverTime": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create routines, notice Today's Wins, and review progress over time. Choose Off, Subtle, or Companion Win Moments — without points, currency, or streak pressure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティンを作り、今日のできたことに目を向け、進捗を振り返りましょう。「できた瞬間」はオフ、控えめ、仲間から選べます。点数や通貨、連続記録のプレッシャーはありません。"
          }
        }
      }
    },
    "tendoOnboardingDentist": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dentist"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歯医者"
          }
        }
      }
    },
    "tendoOnboardingEncryptedLocalBackupsStayUnderYourControl": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted local backups stay under your control"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化ローカルバックアップは自分で管理"
          }
        }
      }
    },
    "tendoOnboardingFinishesOnboardingAndOpensTendo": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishes onboarding and opens Tendo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期案内を終えてTendoを開きます"
          }
        }
      }
    },
    "tendoOnboardingFiveMinutesIsEnoughToBegin": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes is enough to begin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始めるには5分で十分です。"
          }
        }
      }
    },
    "tendoOnboardingFiveMinutesIsEnoughToBeginOtherAudioAlwaysGets": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes is enough to begin. Other audio always gets priority."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始めるには5分で十分。他の音声は常に優先されます。"
          }
        }
      }
    },
    "tendoOnboardingFiveMinutesStillCountsTendoNeverNeedsToKnowWhat": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes still counts. Tendo never needs to know what you are listening to. If you get interrupted, Pick Up Where You Left Off gives you a direct way back, and Welcome Back keeps that return gentle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5分にも意味があります。Tendoは何を聴いているか知る必要がありません。中断しても「続きから再開」ですぐに戻れ、「おかえりなさい」がやさしく迎えます。"
          }
        }
      }
    },
    "tendoOnboardingFocusInAWayThatFitsYou": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
