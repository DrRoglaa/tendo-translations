    "tendoGuideFocusExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with five minutes to write the first paragraph, then decide what is next."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず5分で最初の段落を書き、次にすることはそのあと決めましょう。"
