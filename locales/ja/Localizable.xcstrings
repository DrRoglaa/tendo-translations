    "tendoGuideBrainDumpExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write “call dentist” and “renew passport” on separate lines; sort them later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「歯医者に電話」「パスポート更新」を別々の行に書き、あとで整理しましょう。"
          }
        }
      }
