    "tendoOnboardingBrainDumpCapturesThoughtsFirstOneLineBecomesOneItem": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brain Dump captures thoughts first. One line becomes one item; organizing can wait."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「頭の中を書き出す」は、まず考えを記録します。1行が1件になります。整理はあとで大丈夫。"
          }
        }
      }
    },
    "tendoOnboardingBrainDumpPreviewWithThreeCapturedThoughtsAndFollowUp": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brain Dump preview with three captured thoughts and follow-up options for tiny steps, estimates, and due dates"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3つの考えと、小さなステップ、見積もり、期限の選択肢がある「頭の中を書き出す」のプレビュー"
          }
        }
      }
    },
    "tendoOnboardingBrainDumpPreviewWithThreeUnorganizedThoughts": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brain Dump preview with three unorganized thoughts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未整理の考え3つを表示した「頭の中を書き出す」のプレビュー"
          }
        }
      }
    },
    "tendoOnboardingBrainDumpTurnsThoughtsIntoTasksFastThenYouCan": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brain Dump turns thoughts into tasks fast. Then you can tidy them up, add tiny steps, estimates, and due dates, and keep everything in one place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「頭の中を書き出す」で考えをすばやくタスクに。そのあと整理し、小さなステップ、見積もり、期限を追加して1か所にまとめられます。"
          }
        }
      }
    },
    "tendoOnboardingBuildMomentumYourWay": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build momentum your way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分らしく、勢いをつけましょう。"
          }
