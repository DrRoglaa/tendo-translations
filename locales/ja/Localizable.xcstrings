    "tendoOnboardingNoAccountIsRequiredCalendarRemindersNotificationsWidgetsAppleWatch": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account is required. Calendar, Reminders, notifications, widgets, Apple Watch, and Focus Environment stay optional. Your task data is local-first, encrypted local backups are optional, and Tendo never inspects the song, podcast, audiobook, or video behind the system's generic other-audio signal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは不要です。カレンダー、リマインダー、通知、ウィジェット、Apple Watch、集中環境はすべて任意です。タスクデータはデバイス内を優先し、暗号化ローカルバックアップも任意です。Tendoは他の音声を示すシステム信号から、曲、ポッドキャスト、オーディオブック、動画の内容を調べることはありません。"
          }
        }
      }
    },
    "tendoOnboardingNoAccountIsRequiredYourTasksRoutinesAndFocusHistory": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account is required. Your tasks, routines, and focus history stay on your device whenever practical."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは不要です。タスク、ルーティン、集中履歴は可能な限りデバイス内に保存されます。"
          }
        }
      }
    },
