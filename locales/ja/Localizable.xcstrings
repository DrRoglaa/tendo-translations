    "tendoTipBrainDump": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Make Task to move a thought into Tasks; the original stays under Processed until you clear it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「タスクにする」で考えをタスクへ移せます。元のメモは消去するまで「処理済み」に残ります。"
          }
        }
      }
    },
    "tendoTipCalendar": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar and Reminders provide optional context without turning events into tasks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーとリマインダーは予定をタスクにせず、任意の参考情報を提供します。"
          }
        }
      }
    },
    "tendoTipFocus": {
      "comment": "Tip interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start with five minutes; your Focus preferences remain adjustable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5分から始められます。集中の設定はあとで調整できます。"
