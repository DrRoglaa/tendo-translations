    "tendoGuideBackupsSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups are encrypted exports you control; they are not automatic cloud synchronization."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップは自分で管理する暗号化された書き出しファイルです。クラウドへの自動同期ではありません。"
          }
        }
      }
    },
    "tendoGuideBackupsTitle": {
