    "tendoSettingsOnlyTheSampleRecordsCreatedByTendoWillBeRemoved": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the sample records created by Tendo will be removed. Your own tasks, routines, Brain Dump items, and focus history stay untouched."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendoが作成したサンプル記録だけを削除します。自分のタスク、ルーティン、頭の中のメモ、集中履歴はそのままです。"
          }
        }
      }
