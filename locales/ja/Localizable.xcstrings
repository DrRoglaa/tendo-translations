    "tendoOnboardingTendoAsksForReminderPermissionOnlyWhenYouChooseA": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo asks for reminder permission only when you choose a reminder. You can change everything later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendoはリマインダーを選んだときだけ許可を求めます。あとで設定から変更できます。"
          }
        }
      }
    },
    "tendoOnboardingTendoHelpsYouDecideWhatFeelsDoableNowWithoutAsking": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo helps you decide what feels doable now — without asking you to organize your whole life first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生活のすべてを整理しなくても、今できそうなことをTendoが一緒に考えます。"
          }
        }
      }
    },
    "tendoOnboardingTendoHelpsYouSeeWhatMattersNowChooseADoable": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo helps you see what matters now, choose a doable next step, and begin without needing a perfect plan first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完璧な計画がなくても、今大切なことを見つけ、できそうな次の一歩を選んで始められます。"
          }
        }
      }
    },
    "tendoOnboardingTheseFourExperiencesAreTheHeartOfTendoLockScreen": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These four experiences are the heart of Tendo. Lock Screen actions can jump straight into Start 5, What Fits Now, or I'm Stuck."
          }
