    "tendoWhatsNew132SharingDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Apple language files can be shared for review, with checks that protect newer translations and saved Tendo data."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvirne Applove jezikovne datoteke lahko delite za pregled. Preverjanje ščiti novejše prevode in shranjene podatke Tendo."
          }
        }
      }
    },
