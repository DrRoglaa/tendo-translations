    "tendoFocusTurnOnOnlyWhatHelpsYouPinkWhiteAndBrown": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only what helps you. Pink, white, and brown noise are generated locally, and Tendo does not store listening history."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite le, kar vam pomaga. Rožnati, beli in rjavi šum se ustvarjajo lokalno. Tendo ne hrani zgodovine poslušanja."
          }
        }
      }
    },
    "tendoFocusTurnOnOnlyWhatHelpsYouSoftAmbientAndPink": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only what helps you. Soft ambient and pink, white, and brown noise are generated locally, and Tendo does not store listening history."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite le, kar vam pomaga. Nežna ambientalna kulisa ter rožnati, beli in rjavi šum se ustvarjajo lokalno. Tendo ne hrani zgodovine poslušanja."
          }
        }
      }
    },
