    "tendoSettingsTendoIsACalmFocusAndProductivityCompanionBuiltAround": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is a calm focus and productivity companion built around one question: what should I do right now?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo je miren spremljevalec za osredotočenost in produktivnost, zgrajen okoli enega vprašanja: kaj naj naredim prav zdaj?"
          }
        }
      }
    },
    "tendoSettingsTendoIsCheckingYourAppleWatchConnection": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is checking your Apple Watch connection."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo preverja povezavo z vašo uro Apple Watch."
          }
        }
      }
    },
    "tendoSettingsTendoIsDesignedAroundChallengesSuchAsTaskInitiationOverwhelm": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is designed around challenges such as task initiation, overwhelm, transitions, and losing sight of the next useful action. It keeps the interface small, makes stopping valid, and avoids shame-based streaks or productivity scores."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo je zasnovan okoli izzivov, kot so začetek opravila, preobremenjenost, prehodi in izguba pregleda nad naslednjim koristnim dejanjem. Vmesnik ostaja preprost, ustavljanje je sprejemljivo, ni pa nizov ali ocen produktivnosti, ki bi vzbujali sram."
          }
        }
      }
    },
    "tendoSettingsTendoIsIndependentlyBuiltAndShapedByThePeopleWho": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is independently built and shaped by the people who use it. Sharing feedback, joining the community, leaving a review, or simply telling someone about Tendo all help it grow."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo nastaja neodvisno in ga sooblikujejo uporabniki. Povratne informacije, sodelovanje v skupnosti, ocena ali že priporočilo drugi osebi pomagajo pri njegovi rasti."
          }
        }
      }
    },
