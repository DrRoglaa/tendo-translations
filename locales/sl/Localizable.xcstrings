          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaj lahko naredim zdaj v aplikaciji \\(.applicationName)"
          }
        }
      }
    },
    "tendoCommonWhen": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
