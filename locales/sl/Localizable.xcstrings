    "tendoFocusCreatesARealisticSampleWeekWithWorkAndHomeTasks": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic sample week with work and home tasks, Tiny Steps, two routines, several completed and interrupted Focus sessions, and a few Brain Dump thoughts. Delete demo data removes only records created by this button — your own data is left alone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvari realističen vzorčni teden s službenimi in domačimi opravili, majhnimi koraki, dvema rutinama, več končanimi in prekinjenimi sejami osredotočenosti ter nekaj zapisanimi mislimi. Izbris predstavitvenih podatkov odstrani le zapise, ustvarjene s tem gumbom; vaši podatki ostanejo nedotaknjeni."
          }
        }
      }
    },
