    "tendoSettingsTendoDoesNotDiagnoseTreatOrCureAdhdOrAny": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo does not diagnose, treat, or cure ADHD or any other health condition. It is a productivity and focus tool designed with ADHD-related challenges in mind."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ne diagnosticira, zdravi ali ozdravi ADHD ali katerega koli drugega zdravstvenega stanja. Je orodje za produktivnost in osredotočenost, zasnovano z mislijo na izzive, povezane z ADHD."
          }
        }
      }
    },
    "tendoSettingsTendoDoesNotRequireAnAccountTasksRoutinesFocusHistory": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo does not require an account. Tasks, routines, focus history, and other personal productivity information stay on your device whenever practical."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ne zahteva računa. Opravila, rutine, zgodovina osredotočenosti in drugi osebni podatki o produktivnosti ostajajo v napravi, kadar je to izvedljivo."
          }
        }
      }
    },
    "tendoSettingsTendoIntegration": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
