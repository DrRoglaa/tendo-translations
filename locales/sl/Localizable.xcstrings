        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite le, kar vam pomaga. Nežna ambientalna kulisa, Nežen dež ter rožnati, beli in rjavi šum se ustvarjajo lokalno. Tendo ne hrani zgodovine poslušanja."
          }
        }
      }
    },
