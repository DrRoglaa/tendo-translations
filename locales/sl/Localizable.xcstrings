    "tendoFollowUpIfTheDishwasherIsNotAlreadyRunningThisMayBe": {
      "comment": "Follow interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the dishwasher is not already running, this may be the step that comes first."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če pomivalni stroj še ne deluje, je morda najprej na vrsti ta korak."
