    "tendoGuideWeekExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Wednesday looks crowded, find a calmer place for a flexible task."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če je sreda videti polna, poiščite mirnejši termin za prilagodljivo opravilo."
          }
        }
      }
    },
    "tendoGuideWeekNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Week from Today and try Make Room when needed."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iz pogleda Danes odprite Teden in po potrebi poskusite Naredi prostor."
          }
        }
      }
    },
    "tendoGuideWeekSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review upcoming capacity without turning every day into a packed schedule."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preglejte, koliko prostora je v prihodnjih dneh, ne da bi vsak dan napolnili do zadnje minute."
          }
        }
      }
    },
