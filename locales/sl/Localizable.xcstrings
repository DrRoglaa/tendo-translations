    "tendoMomentumTendoDerivesHomeGrowthFromYourRealTasksTinySteps": {
      "comment": "Momentum interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo derives home growth from your real tasks, Tiny Steps, Focus sessions, and routines. There is no XP, currency, daily quota, or streak to protect. Once a home detail appears, it stays. Demo data never changes your personal Companion Home."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo rast doma povezuje z vašimi resničnimi opravili, majhnimi koraki, sejami osredotočenosti in rutinami. Ni točk izkušenj, valute, dnevnih kvot ali nizov, ki bi jih morali ohranjati. Ko se podrobnost doma pojavi, ostane. Predstavitveni podatki nikoli ne spremenijo vašega osebnega Doma spremljevalca."
          }
        }
      }
    },
    "tendoMomentumTendoDerivesHomeGrowthFromYourRealTasksTinyStepsVariant": {
      "comment": "Momentum interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo derives home growth from your real tasks, Tiny Steps, Focus sessions, and routines. There is no XP, currency, daily quota, or streak to protect. Once a home detail appears, it stays. Demo data never permanently unlocks home details."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo rast doma povezuje z vašimi resničnimi opravili, majhnimi koraki, sejami osredotočenosti in rutinami. Ni točk izkušenj, valute, dnevnih kvot ali nizov, ki bi jih morali ohranjati. Ko se podrobnost doma pojavi, ostane. Predstavitveni podatki nikoli trajno ne odklenejo podrobnosti doma."
          }
        }
      }
    },
