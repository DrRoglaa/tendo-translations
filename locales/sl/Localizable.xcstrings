    "tendoCommonStartWith5MinutesChooseAGentle155Or": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite s 5 minutami, izberite nežnejši ritem 15 / 5 ali klasični 25 / 5 in po potrebi naredite premor. Svoji seji lahko sledite z dejavnostjo v živo in podporo za Apple Watch."
          }
        }
      }
    },
    "tendoCommonStartWith5MinutesChooseAGentle155OrVariant": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. When you stop, Tendo can remember your next tiny step so returning later takes less effort."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite s 5 minutami, izberite nežnejši ritem 15 / 5 ali klasični 25 / 5 in po potrebi naredite premor. Svoji seji lahko sledite z dejavnostjo v živo in podporo za Apple Watch. Ko končate, si lahko Tendo zapomni vaš naslednji majhen korak, da boste pozneje lažje nadaljevali."
          }
        }
      }
    },
