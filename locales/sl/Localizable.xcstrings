    "tendoTasksSchedulemodeTitleIsAFlexibleWindowNotADeadline": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(scheduleMode.title) is a flexible window, not a deadline."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(scheduleMode.title) je prilagodljivo časovno okno, ne rok."
          }
        }
      }
    },
    "tendoTasksTendoConsidersBusyTimeExactTendoTasksYourEstimateDue": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo considers busy time, exact Tendo tasks, your estimate, due date, energy, day load, and recent Focus history."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo upošteva zaseden čas, točno razporejena opravila Tendo, vašo oceno, rok, energijo, obremenitev dneva in nedavno zgodovino osredotočenosti."
          }
        }
      }
    },
    "tendoTasksTendoLooksForAFewOpenWindowsAcrossTheNext": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo looks for a few open windows across the next three days. A Calendar event is created or moved only after you explicitly confirm one."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo poišče nekaj prostih oken v naslednjih treh dneh. Koledarski dogodek se ustvari ali premakne šele, ko ga izrecno potrdite."
          }
        }
      }
    },
    "tendoTasksTendoLooksForRoomThatAlreadyExistsItUsesYour": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo looks for room that already exists. It uses your Tendo plan and, if connected, Apple Calendar. Nothing is added to Apple Calendar."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo išče prostor, ki že obstaja. Uporabi vaš načrt Tendo in Applov Koledar, če je povezan. V Applov Koledar se nič ne doda."
          }
        }
      }
    },
    "tendoTasksTendoOnlyLooksAtYourSelectedCalendarsAfterYouChoose": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo only looks at your selected calendars after you choose to connect them."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo pregleda izbrane koledarje šele, ko se odločite za povezavo."
          }
        }
      }
    },
    "tendoTasksTendoSuggestsThisFromTheTaskWordingOnDeviceNothing": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo suggests this from the task wording on-device. Nothing is added automatically. A follow-up reminder is scheduled only if you choose it."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo to predlaga glede na besedilo opravila v napravi. Nič se ne doda samodejno. Nadaljnji opomnik se načrtuje le, če ga izberete."
          }
        }
      }
    },
    "tendoTasksTendoSuggestsThisFromTheTaskWordingOnDeviceNothingVariant": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo suggests this from the task wording on-device. Nothing is added automatically. Mark this task done and Tendo can also offer a local follow-up reminder."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
