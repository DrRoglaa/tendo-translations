      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, choose Soft ambient or Gentle rain, or use optional pink, white, or brown noise. If other audio starts, Tendo sound steps aside."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite s 5 minutami, izberite nežnejši ritem 15 / 5 ali klasični 25 / 5 in po potrebi naredite premor. Svoji seji lahko sledite z dejavnostjo v živo in podporo za Apple Watch. Okolje za osredotočenost je privzeto tiho: ohranite trenutni zvok, izberite Nežno ambientalno kuliso ali Nežen dež ali uporabite izbirni rožnati, beli ali rjavi šum. Ko se začne drug zvok, se zvok Tendo umakne."
          }
        }
      }
    },
    "tendoOnboardingStartWithOneRoutineOrganizeMoreWhenYouNeedIt": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one routine. Organize more only when your routine library grows."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite z eno rutino. Več organiziranja dodajte šele, ko zbirka rutin zraste."
          }
        }
      }
    },
