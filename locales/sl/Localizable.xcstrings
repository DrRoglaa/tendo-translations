    "tendoCommonTendoCanCreateAPasswordProtectedTendobackupFileTheBackup": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can create a password-protected .tendobackup file. The backup is created and encrypted locally on this device. Tendo does not upload, receive, store, or have access to your backup files or backup passwords. Demo/test data, Calendar and Reminders data, system permissions, account information, caches, diagnostics, and transient state are not included. If you export a backup, you choose where the encrypted file is stored or shared using Apple's system interfaces. Tendo cannot recover a backup if the password is lost."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo lahko ustvari datoteko .tendobackup, zaščiteno z geslom. Varnostna kopija se ustvari in šifrira lokalno v tej napravi. Tendo vaših varnostnih kopij ali njihovih gesel ne nalaga, prejema ali hrani in do njih nima dostopa. Predstavitveni in preskusni podatki, podatki Koledarja in Opomnikov, sistemska dovoljenja, podatki o računih, predpomnilniki, diagnostika in začasna stanja niso vključeni. Pri izvozu sami izberete, kam se šifrirana datoteka shrani ali s kom se deli prek Applovih sistemskih vmesnikov. Tendo ne more obnoviti varnostne kopije, če izgubite geslo."
          }
        }
      }
    },
    "tendoCommonTendoCouldntCompleteTheRestoreSafelyPleaseRestartTendoBefore": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't complete the restore safely. Please restart Tendo before making changes."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ni mogel varno dokončati obnove. Pred spreminjanjem podatkov znova zaženite Tendo."
          }
        }
      }
    },
    "tendoCommonTendoCouldntReadTheSelectedBackup": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
