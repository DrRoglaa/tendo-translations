    "tendoFocusStartWith5MinutesChooseAGentle155Or": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment can stay quiet, keep your own audio, or add optional local background noise. When you stop, Tendo can remember your next tiny step so returning later takes less effort."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite s 5 minutami, izberite nežnejši ritem 15 / 5 ali klasični 25 / 5 in po potrebi naredite premor. Svoji seji lahko sledite z dejavnostjo v živo in podporo za Apple Watch. Okolje za osredotočenost lahko ostane tiho, ohrani vaš zvok ali doda izbirni lokalni šum v ozadju. Ko končate, si lahko Tendo zapomni vaš naslednji majhen korak, da boste pozneje lažje nadaljevali."
          }
        }
      }
    },
    "tendoFocusStartWith5MinutesChooseAGentle155OrVariant": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, choose Soft ambient, or use optional pink, white, or brown noise. If other audio starts, Tendo sound steps aside."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite s 5 minutami, izberite nežnejši ritem 15 / 5 ali klasični 25 / 5 in po potrebi naredite premor. Svoji seji lahko sledite z dejavnostjo v živo in podporo za Apple Watch. Okolje za osredotočenost je privzeto tiho: ohranite trenutni zvok, izberite Nežno ambientalno kuliso ali uporabite izbirni rožnati, beli ali rjavi šum. Ko se začne drug zvok, se zvok Tendo umakne."
          }
        }
      }
    },
    "tendoFocusStartWith5MinutesChooseAGentle155OrVariant2": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, or choose optional pink, white, or brown noise. If other audio starts, Tendo noise steps aside."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite s 5 minutami, izberite nežnejši ritem 15 / 5 ali klasični 25 / 5 in po potrebi naredite premor. Svoji seji lahko sledite z dejavnostjo v živo in podporo za Apple Watch. Okolje za osredotočenost je privzeto tiho: ohranite trenutni zvok ali izberite izbirni rožnati, beli ali rjavi šum. Ko se začne drug zvok, se šum Tendo umakne."
          }
        }
      }
    },
