    "tendoSettingsOffSubtleOrCompanionNoPointsStreakLossLeaderboardsCurrency": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off, Subtle, or Companion — no points, streak loss, leaderboards, currency, or penalties. Companion choice never changes your progress."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izklopljeno, Diskretno ali Spremljevalec – brez točk, izgube nizov, lestvic, valute ali kazni. Izbira spremljevalca nikoli ne spremeni vašega napredka."
          }
        }
      }
    },
