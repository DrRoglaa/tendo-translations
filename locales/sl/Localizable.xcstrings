    "tendoSettingsYouCanPauseOrStopWheneverYouNeedToThe": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pause or stop whenever you need to. The time you already focused still counts."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar koli lahko naredite premor ali končate. Čas že opravljene osredotočenosti še vedno šteje."
          }
        }
      }
    },
    "tendoSettingsYourOptionalPreferredNameIsStoredLocallyByTendoAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your optional preferred name is stored locally by Tendo and is used only to personalize greetings inside the app. It is included only when you choose to create an encrypted local Tendo backup. Tendo does not read your Contacts or Apple Account to obtain your name."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo hrani izbirno želeno ime lokalno in ga uporablja le za osebne pozdrave v aplikaciji. Vključeno je le, če ustvarite šifrirano lokalno varnostno kopijo Tendo. Tendo vašega imena ne pridobiva iz Stikov ali računa Apple."
          }
        }
      }
    },
    "tendoSettingsYourOptionalPreferredNameIsStoredOnlyByTendoAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your optional preferred name is stored only by Tendo and is used to personalize the greeting on Now. Leave it blank to keep the standard greeting."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbirno želeno ime hrani samo Tendo in ga uporablja za osebni pozdrav v pogledu Zdaj. Za običajni pozdrav pustite polje prazno."
          }
        }
      }
    },
    "tendoSettingsYourPasswordIsUsedOnlyOnThisDeviceToUnlock": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is used only on this device to unlock the selected backup and is never stored by Tendo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geslo se uporablja le v tej napravi za odklepanje izbrane varnostne kopije. Tendo ga nikoli ne shrani."
          }
        }
      }
    },
    "tendoSettingsYourTasksRoutinesFocusHistoryTinyStepsAndBrainDump": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, routines, focus history, Tiny Steps, and Brain Dump stay in Tendo’s private local app storage. Apple Watch sharing uses only compact snapshots and actions, not the full SwiftData database."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša opravila, rutine, zgodovina osredotočenosti, majhni koraki in zapisane misli ostajajo v zasebni lokalni shrambi aplikacije Tendo. Deljenje z Apple Watch uporablja le strnjene posnetke stanja in dejanja, ne celotne zbirke SwiftData."
          }
        }
      }
    },
    "tendoSettingsYourTendoRecordsStayLocalUnlessYouExplicitlyExportAn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Tendo records stay local unless you explicitly export an encrypted backup."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši zapisi Tendo ostanejo lokalni, razen če izrecno izvozite šifrirano varnostno kopijo."
          }
        }
      }
    },
