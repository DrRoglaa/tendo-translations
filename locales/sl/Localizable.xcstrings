      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, including follow-up nudge examples, Tiny Steps, three routines, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete Sample Data removes only records created here — your own data is left alone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvari realističen vzorčni teden s 36 raznolikimi službenimi in domačimi opravili, primeri nadaljnjih spodbud, majhnimi koraki, tremi rutinami, raznovrstno zgodovino končanih in prekinjenih osredotočenosti ter zapisanimi mislimi. Izbris vzorčnih podatkov odstrani le tukaj ustvarjene zapise; vaši podatki ostanejo nedotaknjeni."
          }
        }
      }
    },
    "tendoSettingsCreatesARealisticSyntheticWeekWithRoutineFolders": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, Tiny Steps, 16 routines organized into four folders, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete Sample Data removes only records created here — your own data is left alone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvari realističen vzorčni teden s 36 raznolikimi službenimi in domačimi opravili, majhnimi koraki, 16 rutinami v štirih mapah, raznovrstno zgodovino končanih in prekinjenih osredotočenosti ter zapisanimi mislimi. Izbris vzorčnih podatkov odstrani le tukaj ustvarjene zapise; vaši podatki ostanejo nedotaknjeni."
          }
        }
      }
    },
