    },
    "tendoOnboardingTurnOnOnlyWhatHelpsYouSoftAmbientAndGentle": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only what helps you. Soft ambient and Gentle rain are stored locally in Tendo, pink, white, and brown noise are generated on-device, backups are encrypted locally and never include Apple Calendar or Reminders data, and Tendo does not store listening history."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite le, kar vam pomaga. Nežna ambientalna kulisa in Nežen dež sta shranjena lokalno v aplikaciji Tendo, rožnati, beli in rjavi šum se ustvarjajo v napravi, varnostne kopije se šifrirajo lokalno in nikoli ne vsebujejo podatkov Applovega Koledarja ali Opomnikov. Tendo ne hrani zgodovine poslušanja."
          }
        }
      }
    },
    "tendoOnboardingUseBrainDumpWhenYourHeadFeelsNoisyOrYou": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Brain Dump when your head feels noisy or you are worried you will forget something."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite Izprazni misli, ko je v glavi preveč misli ali vas skrbi, da boste kaj pozabili."
          }
        }
      }
    },
    "tendoOnboardingUseNowWhenYouWantCalmGuidanceAClearNext": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Now when you want calm guidance, a clear next step, or a quick five-minute start."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite Zdaj, ko želite mirno usmeritev, jasen naslednji korak ali hiter petminutni začetek."
          }
        }
      }
    },
    "tendoOnboardingUsePlanTodayForAGentleShortlistFindMeA": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Plan today for a gentle shortlist. Find me a place schedules only inside Tendo; Apple Calendar changes remain a separate, explicit action."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za kratek seznam uporabite Načrtuj današnji dan. Najdi mi termin razporeja le znotraj aplikacije Tendo; spremembe Applovega Koledarja so vedno ločeno, izrecno dejanje."
          }
        }
      }
    },
    "tendoOnboardingWatch": {
