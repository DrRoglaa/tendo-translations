    "tendoCommonTryStart5WhenYouKnowWhatToDoWhat": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Start 5 when you know what to do, What Fits Now when you need guidance, and I'm Stuck when the first step feels blocked."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko veste, kaj želite narediti, poskusite Začni 5. Če potrebujete usmeritev, izberite Kaj lahko naredim zdaj. Če težko naredite prvi korak, izberite Ne vem, kako naprej."
          }
        }
      }
    },
    "tendoCommonTurnOnOnlyTheIntegrationsThatHelpYouYouCan": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only the integrations that help you. You can change everything later in Settings."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite le povezave, ki vam pomagajo. Vse lahko pozneje spremenite v Nastavitvah."
          }
        }
      }
    },
    "tendoCommonTurningCalendarContextOffImmediatelyStopsTendoFromLoadingCalendar": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning Calendar Context off immediately stops Tendo from loading calendar events. Apple’s system permission is managed separately in iOS Settings."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko izklopite Koledarski kontekst, Tendo takoj preneha nalagati koledarske dogodke. Applovo sistemsko dovoljenje se upravlja ločeno v nastavitvah iOS."
          }
        }
