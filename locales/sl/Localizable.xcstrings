    "tendoSettingsCalendarContext": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar Context"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koledarski kontekst"
          }
        }
      }
    },
    "tendoSettingsCalendarContextIsOptionalAppleRequiresFullCalendarAccessTo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar Context is optional. Apple requires Full Calendar Access to read existing events. Find me a place can use busy Calendar events to suggest open time, but it never creates, moves, or deletes Calendar events. Block in Apple Calendar is a separate action and changes only the single Calendar block you explicitly confirm for a Tendo task. There is no automatic task-to-calendar sync. You can disconnect Calendar Context inside Tendo at any time; system permission is managed in iOS Settings. Event details are not copied into Tendo's SwiftData database."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koledarski kontekst je izbiren. Apple za branje obstoječih dogodkov zahteva polni dostop do koledarja. Najdi mi termin lahko uporabi zasedene termine za predlog prostega časa, nikoli pa ne ustvari, premakne ali izbriše koledarskih dogodkov. Rezerviraj v Applovem Koledarju je ločeno dejanje, ki spremeni le posamezni časovni blok, ki ga izrecno potrdite za opravilo Tendo. Samodejne sinhronizacije opravil s koledarjem ni. Koledarski kontekst lahko kadar koli izklopite v aplikaciji Tendo; sistemsko dovoljenje upravljate v nastavitvah iOS. Podrobnosti dogodkov se ne kopirajo v podatkovno zbirko SwiftData aplikacije Tendo."
          }
        }
      }
    },
    "tendoSettingsCalendarNamesAreUsedOnlyToChooseWhatAppearsIn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar names are used only to choose what appears in Tendo. Event details stay in memory and are not copied into SwiftData."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imena koledarjev se uporabljajo le za izbiro prikaza v aplikaciji Tendo. Podrobnosti dogodkov ostanejo v pomnilniku in se ne kopirajo v SwiftData."
          }
        }
      }
    },
