      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If these are the same bins, taking them out is probably the earlier step."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če gre za iste zabojnike, jih je verjetno treba najprej odpeljati ven."
