    "tendoOnboardingWhenYourHeadFeelsNoisyDumpItFirstYouCan": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your head feels noisy, dump it first. You can sort and refine things once the pressure is lower. For a few obvious everyday sequences, Tendo can also suggest what may come before or next without adding anything automatically."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je v glavi preveč misli, jih najprej zapišite. Uredite in dopolnite jih lahko, ko bo pritisk manjši. Pri nekaj očitnih vsakdanjih zaporedjih lahko Tendo predlaga tudi prejšnji ali naslednji korak, ne da bi kar koli samodejno dodal."
          }
        }
      }
    },
