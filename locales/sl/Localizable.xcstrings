    "tendoSettingsOnlyTheListsYouKeepEnabledAppearInTendoReminder": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the lists you keep enabled appear in Tendo. Reminder contents are not copied into SwiftData."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V aplikaciji Tendo se prikažejo le omogočeni seznami. Vsebina opomnikov se ne kopira v SwiftData."
          }
