    "tendoOnboardingTodayPreviewShowingOneExactAppointmentAndOneFlexibleTask": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today preview showing one exact appointment and one flexible task"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predogled Danes z eno obveznostjo ob točni uri in enim prilagodljivim opravilom"
          }
        }
      }
    },
    "tendoOnboardingTodayShowsExactTimeAnchorsFlexibleWindowsAndWhatFits": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and What Fits Now. Find me a place can suggest a calm opening for a task, while Week helps you spread things out without treating every change like failure."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes pokaže fiksne obveznosti, prilagodljiva okna in Kaj lahko naredim zdaj. Najdi mi termin lahko predlaga mirno okno za opravilo, Teden pa pomaga razporediti opravila, ne da bi vsako spremembo doživeli kot neuspeh."
          }
        }
      }
    },
    "tendoOnboardingTodayShowsExactTimeAnchorsFlexibleWindowsAndWhatIs": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and what is still available — without turning a changed plan into failure."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes pokaže fiksne obveznosti, prilagodljiva okna in še razpoložljiva opravila, ne da bi spremenjen načrt pomenil neuspeh."
          }
        }
      }
    },
    "tendoOnboardingTue": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tue"
          }
        },
        "sl": {
          "stringUnit": {
