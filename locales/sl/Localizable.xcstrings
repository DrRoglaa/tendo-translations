    "tendoFocusTendoNeverPausesAppleMusicSpotifyPodcastsYoutubeOrOther": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo never pauses Apple Music, Spotify, podcasts, YouTube, or other audio just because Focus starts."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ob začetku osredotočenosti nikoli ne ustavi Apple Music, Spotifyja, podkastov, YouTuba ali drugega zvoka."
          }
        }
      }
    },
    "tendoFocusTendoOnlyChecksWhetherOtherAudioIsActiveItNever": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo only checks whether other audio is active. It never sees the app, song, podcast, audiobook, or video you are playing."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo preveri le, ali se predvaja drug zvok. Nikoli ne vidi aplikacije, skladbe, podkasta, zvočne knjige ali videoposnetka, ki ga predvajate."
          }
        }
      }
    },
