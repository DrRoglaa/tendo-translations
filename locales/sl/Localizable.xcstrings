    "tendoSettingsWidgetsIntentionallyDoNotReadYourPrivateTaskDatabaseIn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets intentionally do not read your private task database in the current version. They stay useful without requiring shared app-group storage."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomočki v trenutni različici namenoma ne berejo vaše zasebne zbirke opravil. Ostajajo uporabni brez skupne shrambe skupine aplikacij."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndCompanion": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments & Companion"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutki uspeha in spremljevalec"
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheCompanionStayQuietProgressStillReflects": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the companion stay quiet. Progress still reflects your real activity."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutki uspeha in spremljevalec ostanejo tihi. Napredek še vedno odraža vašo resnično dejavnost."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheOptionalMomentumCompanionAreLocalPresentation": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the optional Momentum companion are local presentation features. Today's Wins and companion milestones are derived from your existing tasks, Tiny Steps, Focus history, and routines; Tendo does not create a separate XP, currency, streak, or analytics profile. Your companion choice is stored locally and changing it never changes your progress."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutki uspeha in izbirni spremljevalec zagona so lokalne predstavitvene funkcije. Današnji uspehi in mejniki spremljevalca izhajajo iz obstoječih opravil, majhnih korakov, zgodovine osredotočenosti in rutin. Tendo ne ustvarja ločenih profilov točk izkušenj, valute, nizov ali analitike. Izbira spremljevalca je shranjena lokalno in njena sprememba nikoli ne spremeni vašega napredka."
          }
        }
      }
    },
    "tendoSettingsWriteAReview": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a Review"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiši oceno"
          }
        }
      }
    },
    "tendoSettingsYesterday": {
      "comment": "Settings interface. Keep terminology consistent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Včeraj"
          }
        }
