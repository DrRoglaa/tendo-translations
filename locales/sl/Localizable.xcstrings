    "tendoGuideWidgetsSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home and Lock Screen widgets provide shortcuts back into Tendo without exposing your private task library."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomočki na domačem in zaklenjenem zaslonu ponujajo bližnjice v Tendo, ne da bi razkrili vašo zasebno zbirko opravil."
          }
        }
      }
    },
