          }
        }
      }
    },
    "tendoWhatsNew130FocusTaskFinishDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a Focus session finishes naturally and is linked to a task, Tendo can ask whether you've finished it. Complete the task immediately or keep it open for later."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko se seja osredotočenosti, povezana z opravilom, izteče, lahko Tendo vpraša, ali ste opravilo dokončali. Dokončajte ga takoj ali ga pustite odprtega za pozneje."
          }
        }
      }
    },
    "tendoWhatsNew130FocusTaskFinishTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smarter Focus Completion"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pametnejši zaključek osredotočenosti"
          }
        }
      }
    },
    "tendoWhatsNew130Subtitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little more support for your everyday routines, with gentler reminders, smarter Focus sessions, and a more consistent planning experience."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekaj več podpore za vsakdanje rutine z nežnejšimi opomniki, pametnejšimi sejami osredotočenosti in bolj usklajenim načrtovanjem."
          }
        }
      }
    },
    "tendoWhatsNew131GuideDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
