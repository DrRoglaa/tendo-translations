    "tendoGentlePermissionDetail": {
      "comment": "Gentle interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choices stay on this iPhone. All three reminders are off until you enable them. iOS Focus or Scheduled Summary may delay delivery."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše izbire ostanejo v tem iPhonu. Vsi trije opomniki so izklopljeni, dokler jih ne vklopite. Osredotočenost iOS ali načrtovani povzetek lahko dostavo odložita."
          }
        }
      }
    },
