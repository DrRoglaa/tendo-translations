    "tendoSettingsFollowUpNudges": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow-up nudges"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaljnje spodbude"
          }
        }
      }
    },
    "tendoSettingsFollowUpNudgesUseASmallSetOfOnDevice": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow-up nudges use a small set of on-device rules to recognize obvious everyday task sequences, such as laundry or the dishwasher. Tendo may suggest a likely earlier or next step, but it never assumes the step happened and never creates a task or reminder until you choose it. Task wording is not sent anywhere for this feature."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaljnje spodbude z majhnim naborom pravil v napravi prepoznajo očitna vsakdanja zaporedja, kot sta pranje perila in pomivalni stroj. Tendo lahko predlaga verjetni predhodni ali naslednji korak, nikoli pa ne domneva, da je bil opravljen, in ne ustvari opravila ali opomnika, dokler ga ne izberete. Besedilo opravil se za to funkcijo nikamor ne pošilja."
          }
        }
      }
    },
