    "tendoCommonYouCanCreateAnotherTaskHereAtAnyTimeNew": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can create another task here at any time. New tasks are added automatically while there is room. Swipe left on an available task to delete the Tendo task."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lahko kadar koli ustvarite novo opravilo. Nova opravila se samodejno dodajajo, dokler je prostor. Če želite izbrisati razpoložljivo opravilo Tendo, ga podrsajte v levo."
          }
        }
      }
    },
    "tendoCommonYouGaveSomeAttentionYouCanStopHere": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
