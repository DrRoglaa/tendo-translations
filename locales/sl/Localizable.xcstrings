    "tendoCommonCountsShowYourRealTendoRecordsOnThisDeviceDemo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts show your real Tendo records on this device. Demo data is not included."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Števci kažejo tvoje resnične zapise Tenda v tej napravi. Predstavitveni podatki niso vključeni."
          }
        }
      }
    },
    "tendoCommonCreateRoutinesNoticeTodaysWinsAndReviewProgressOverTime": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create routines, notice Today's wins, and review progress over time. Win Moments can gently acknowledge meaningful starts and finishes without points or streak pressure."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarjaj rutine, opazi današnje uspehe in spremljaj napredek skozi čas. Trenutki uspeha lahko nežno priznajo pomembne začetke in zaključke brez točk ali pritiska neprekinjenih nizov."
          }
        }
      }
    },
    "tendoCommonCreateRoutinesTrackMomentumAndReviewProgressOverTimeSo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create routines, track momentum, and review progress over time so helpful patterns are easier to keep repeating."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z rutinami in spremljanjem napredka ustvarjaj zagon, da bo koristne vzorce lažje ponavljati."
          }
        }
      }
    },
    "tendoCommonCreatesARealisticSyntheticWeekWith36MixedWorkAnd": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, including follow-up nudge examples, Tiny Steps, three routines, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete demo data removes only records created by this button — your own data is left alone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvari realističen vzorčni teden s 36 različnimi službenimi in domačimi opravili, primeri nadaljnjih opomnikov, drobnimi koraki, tremi rutinami, različno zaključenimi in prekinjenimi sejami osredotočenosti ter zapisanimi mislimi. Brisanje demo podatkov odstrani samo zapise, ustvarjene s tem gumbom – tvoji podatki ostanejo nedotaknjeni."
          }
        }
      }
    },
