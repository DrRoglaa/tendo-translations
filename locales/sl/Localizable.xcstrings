        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ni mogel prebrati izbrane varnostne kopije."
          }
        }
      }
    },
    "tendoCommonTendoCouldntRestoreThisBackupYourExistingDataWasKept": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't restore this backup. Your existing data was kept."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo ni mogel obnoviti te varnostne kopije. Obstoječi podatki so ohranjeni."
          }
        }
      }
    },
    "tendoCommonTendoReadsIncompleteRemindersDueTodayOrEarlierMarkingOne": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo reads incomplete reminders due today or earlier. Marking one done in Tendo completes the original Apple Reminder. Disconnecting never deletes reminders."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo bere nedokončane opomnike z današnjim ali preteklim rokom. Če opomnik v aplikaciji Tendo označite kot opravljen, se dokonča tudi izvirni Applov opomnik. Prekinitev povezave opomnikov nikoli ne izbriše."
          }
        }
      }
    },
    "tendoCommonTendoTasksAlreadyPlaced": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
