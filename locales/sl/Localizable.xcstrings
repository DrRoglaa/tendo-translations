    },
    "tendoWhatsNewCalmerTendoDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks, Task details, Settings, and Focus Live Activities have been refined to feel cleaner and easier to scan."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravila, podrobnosti opravil, Nastavitve in dejavnosti osredotočenosti v živo so izpopolnjeni za čistejši in preglednejši videz."
          }
        }
      }
    },
    "tendoWhatsNewCalmerTendoTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calmer Tendo"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirnejši Tendo"
          }
        }
      }
    },
    "tendoWhatsNewCarryForwardDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished tasks from an earlier day no longer have to become today’s backlog. Review them and choose what you actually want to carry forward."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedokončana opravila iz prejšnjega dne ne postanejo več samodejno današnji zaostanki. Preglejte jih in izberite, kaj res želite prenesti naprej."
          }
        }
      }
    },
    "tendoWhatsNewCarryForwardTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what comes with you"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite, kaj gre z vami"
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an optional morning reminder to start your day with intention, or an evening reflection to review your progress. Choose the times that suit you."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavite izbirni jutranji opomnik za premišljen začetek dneva ali večerni razmislek za pregled napredka. Izberite čas, ki vam ustreza."
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning Check-ins & Evening Reflections"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jutranji pozdravi in večerni razmisleki"
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a friendly nudge after 1, 3, or 7 days away from Tendo. Your inactivity countdown resets automatically when you return."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po 1, 3 ali 7 dneh brez aplikacije Tendo prejmite prijazno spodbudo. Ob vrnitvi se odštevanje nedejavnosti samodejno ponastavi."
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Inactivity Reminders"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nežni opomniki po odsotnosti"
          }
        }
      }
    },
    "tendoWhatsNewGentleQuietHoursDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize quiet hours and manage each reminder individually. Everything is optional, disabled by default, and scheduled locally on your device."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodite tihe ure in upravljajte vsak opomnik posebej. Vse je izbirno, privzeto izklopljeno in načrtovano lokalno v napravi."
          }
        }
      }
    },
    "tendoWhatsNewGentleQuietHoursTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
