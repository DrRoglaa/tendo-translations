    "tendoSettingsTendoCanCreateAPasswordProtectedTendobackupFileTheBackup": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can create a password-protected .tendobackup file. The backup is created and encrypted locally, and it is verified and restored locally on this device. Tendo does not upload, receive, store, or have access to your backup files or backup passwords. Demo/test data, Calendar and Reminders data, system permissions, account information, caches, diagnostics, and transient state are not included. If you export a backup, you choose where the encrypted file is stored or shared using Apple's system interfaces. Tendo keeps only the dates of your last successful backup and restore locally for display in Settings. Tendo cannot recover a backup if the password is lost."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo lahko ustvari datoteko .tendobackup, zaščiteno z geslom. Varnostna kopija se ustvari, šifrira, preveri in obnovi lokalno v tej napravi. Tendo vaših varnostnih kopij ali njihovih gesel ne nalaga, prejema ali hrani in do njih nima dostopa. Predstavitveni in preskusni podatki, podatki Koledarja in Opomnikov, sistemska dovoljenja, podatki o računih, predpomnilniki, diagnostika in začasna stanja niso vključeni. Pri izvozu sami izberete, kam se šifrirana datoteka shrani ali s kom se deli prek Applovih sistemskih vmesnikov. Tendo za prikaz v Nastavitvah lokalno hrani le datuma zadnje uspešne varnostne kopije in obnove. Če izgubite geslo, Tendo varnostne kopije ne more obnoviti."
          }
        }
      }
    },
    "tendoSettingsTendoCanGentlyAcknowledgeACompletedTaskTinyStepFocus": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can gently acknowledge a completed task, Tiny Step, Focus, routine, or return after an interruption."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo lahko nežno izrazi priznanje za končano opravilo, majhen korak, osredotočenost, rutino ali vrnitev po prekinitvi."
          }
        }
      }
    },
    "tendoSettingsTendoCannotRecoverThisPasswordIfYouForgetItThis": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo cannot recover this password. If you forget it, this backup cannot be restored."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo tega gesla ne more obnoviti. Če ga pozabite, te varnostne kopije ne bo mogoče obnoviti."
          }
        }
      }
    },
    "tendoSettingsTendoCouldntCompleteThatBackupAction": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
