        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch prikaže osredotočenost, začeto v iPhonu, kot pasivno dejavnost v živo, zato iPhone ostaja glavni vir stanja te seje."
          }
        }
      }
    },
