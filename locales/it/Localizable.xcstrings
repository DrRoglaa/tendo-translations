      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One gentle reminder after the selected number of days without opening Tendo. Returning resets the count. Opens Today."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria delicato dopo il numero scelto di giorni senza aprire Tendo. Tornare azzera il conteggio. Apre Oggi."
          }
        }
      }
    },
