    "tendoWhatsNew130ConsistentTaskViewsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task rows across Today, Week, and Now have been refined for a more consistent appearance, making everyday planning easier to follow."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe delle attività in Oggi, Settimana e Adesso sono state migliorate per un aspetto più coerente che rende più facile seguire la pianificazione quotidiana."
          }
        }
      }
    },
    "tendoWhatsNew130ConsistentTaskViewsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More Consistent Task Views"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viste delle attività più coerenti"
          }
        }
      }
    },
    "tendoWhatsNew130FocusTaskFinishDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a Focus session finishes naturally and is linked to a task, Tendo can ask whether you've finished it. Complete the task immediately or keep it open for later."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una sessione di Concentrazione termina naturalmente ed è collegata a un'attività, Tendo può chiederti se l'hai completata. Completa subito l'attività o lasciala aperta per dopo."
          }
        }
      }
    },
    "tendoWhatsNew130FocusTaskFinishTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smarter Focus Completion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine della concentrazione più intelligente"
          }
        }
      }
    },
    "tendoWhatsNew130Subtitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little more support for your everyday routines, with gentler reminders, smarter Focus sessions, and a more consistent planning experience."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un po' più di supporto per le routine quotidiane, con promemoria più delicati, sessioni di Concentrazione più intelligenti e una pianificazione più coerente."
          }
        }
      }
    },
    "tendoWhatsNew131GuideDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find short, practical explanations and examples for everyday features in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova nelle Impostazioni brevi spiegazioni pratiche ed esempi delle funzioni quotidiane."
          }
        }
      }
    },
    "tendoWhatsNew131GuideTitle": {
      "comment": "Tendo interface text. Keep natural language and terminology consistent.",
      "extractionState": "manual",
