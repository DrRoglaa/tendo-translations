          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima di Svuota la mente con tre pensieri raccolti e opzioni successive per piccoli passi, stime e scadenze"
          }
        }
      }
    },
    "tendoOnboardingBrainDumpPreviewWithThreeUnorganizedThoughts": {
