    "tendoSettingsCalendarContext": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar Context"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contesto del calendario"
          }
        }
      }
    },
    "tendoSettingsCalendarContextIsOptionalAppleRequiresFullCalendarAccessTo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar Context is optional. Apple requires Full Calendar Access to read existing events. Find me a place can use busy Calendar events to suggest open time, but it never creates, moves, or deletes Calendar events. Block in Apple Calendar is a separate action and changes only the single Calendar block you explicitly confirm for a Tendo task. There is no automatic task-to-calendar sync. You can disconnect Calendar Context inside Tendo at any time; system permission is managed in iOS Settings. Event details are not copied into Tendo's SwiftData database."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contesto del calendario è facoltativo. Apple richiede l'accesso completo al calendario per leggere gli eventi esistenti. Trovami uno spazio può usare gli eventi occupati per suggerire tempo libero, ma non crea, sposta o elimina mai eventi del calendario. Blocca in Calendario Apple è un'azione separata e modifica solo il singolo blocco che confermi esplicitamente per un'attività Tendo. Non c'è sincronizzazione automatica tra attività e calendario. Puoi disconnettere il contesto del calendario in Tendo quando vuoi; l'autorizzazione di sistema si gestisce nelle Impostazioni di iOS. I dettagli degli eventi non vengono copiati nel database SwiftData di Tendo."
          }
        }
      }
    },
    "tendoSettingsCalendarNamesAreUsedOnlyToChooseWhatAppearsIn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar names are used only to choose what appears in Tendo. Event details stay in memory and are not copied into SwiftData."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi dei calendari servono solo a scegliere cosa appare in Tendo. I dettagli degli eventi restano in memoria e non vengono copiati in SwiftData."
          }
        }
      }
    },
