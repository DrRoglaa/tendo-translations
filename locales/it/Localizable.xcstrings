        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi dei calendari servono solo a scegliere cosa mostrare in Tendo. I dettagli degli eventi restano in memoria e non vengono copiati in SwiftData."
          }
        }
      }
    },
