    "tendoOnboardingChooseYourOwnTimeA25MinuteFocusOrA": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your own time, a 25-minute focus, or a gentler 15-minute focus. Breaks are optional, and 5 minutes is always a valid place to begin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una durata libera, 25 minuti di concentrazione o 15 minuti più delicati. Le pause sono facoltative e 5 minuti sono sempre un buon inizio."
          }
        }
      }
    },
    "tendoOnboardingClosesOnboarding": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
