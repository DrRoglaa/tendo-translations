    },
    "tendoSettingsTendoDoesNotDiagnoseTreatOrCureAdhdOrAny": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo does not diagnose, treat, or cure ADHD or any other health condition. It is a productivity and focus tool designed with ADHD-related challenges in mind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo non diagnostica, tratta o cura l'ADHD o altre condizioni di salute. È uno strumento di produttività e concentrazione progettato tenendo presenti le difficoltà legate all'ADHD."
          }
        }
      }
    },
    "tendoSettingsTendoDoesNotRequireAnAccountTasksRoutinesFocusHistory": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo does not require an account. Tasks, routines, focus history, and other personal productivity information stay on your device whenever practical."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo non richiede un account. Attività, routine, cronologia della concentrazione e altre informazioni personali di produttività rimangono sul dispositivo quando possibile."
          }
        }
      }
    },
    "tendoSettingsTendoIntegration": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo integration"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrazione di Tendo"
          }
        }
      }
    },
    "tendoSettingsTendoIsACalmFocusAndProductivityCompanionBuiltAround": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is a calm focus and productivity companion built around one question: what should I do right now?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo è un compagno tranquillo per concentrazione e produttività, costruito intorno a una domanda: cosa faccio proprio adesso?"
          }
        }
      }
    },
    "tendoSettingsTendoIsCheckingYourAppleWatchConnection": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is checking your Apple Watch connection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo sta verificando la connessione ad Apple Watch."
          }
        }
      }
    },
    "tendoSettingsTendoIsDesignedAroundChallengesSuchAsTaskInitiationOverwhelm": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is designed around challenges such as task initiation, overwhelm, transitions, and losing sight of the next useful action. It keeps the interface small, makes stopping valid, and avoids shame-based streaks or productivity scores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo è progettato intorno a difficoltà come iniziare attività, sentirsi sopraffatti, cambiare attività e perdere di vista la prossima azione utile. Mantiene l'interfaccia essenziale, rende legittimo fermarsi ed evita serie basate sul senso di colpa o punteggi di produttività."
          }
        }
      }
    },
    "tendoSettingsTendoIsIndependentlyBuiltAndShapedByThePeopleWho": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo is independently built and shaped by the people who use it. Sharing feedback, joining the community, leaving a review, or simply telling someone about Tendo all help it grow."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo è sviluppato in modo indipendente e prende forma grazie a chi lo usa. Condividere idee, unirsi alla community, lasciare una recensione o semplicemente parlarne a qualcuno lo aiuta a crescere."
          }
        }
      }
    },
