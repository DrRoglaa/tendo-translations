    "tendoGuideNotificationsExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable a morning check-in only if it helps; keep reminders off otherwise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva un saluto mattutino solo se ti aiuta; altrimenti lascia disattivati i promemoria."
          }
        }
      }
    },
    "tendoGuideNotificationsNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Gentle Reminders or Notifications & Reminders in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Promemoria delicati o Notifiche e promemoria nelle Impostazioni."
          }
        }
      }
    },
    "tendoGuideNotificationsSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional notifications help with check-ins and Focus. Quiet hours protect your downtime."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche facoltative aiutano con i saluti e Concentrazione. Le ore di silenzio proteggono il tuo riposo."
          }
        }
      }
    },
