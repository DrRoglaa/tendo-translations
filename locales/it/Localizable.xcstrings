            "value": "Task and transition reminders use Apple’s local notification system. Tendo asks for notification access only when you choose to use a feature that needs it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria delle attività e di transizione usano le notifiche locali di Apple. Tendo chiede l'accesso alle notifiche solo quando scegli una funzione che lo richiede."
          }
        }
      }
    },
    "tendoSettingsTendo": {
