    "tendoOnboardingStart5GetsYouMovingWhenYouKnowWhatTo": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start 5 gets you moving when you know what to do. What Fits Now helps you choose. I'm Stuck turns a blocked task into one physical next move. Welcome Back remembers your place after an interruption."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con 5 ti mette in moto quando sai cosa fare. Cosa fare adesso ti aiuta a scegliere. Sono bloccato trasforma un'attività bloccata in una prossima azione concreta. Bentornato ricorda il punto dopo un'interruzione."
          }
        }
      }
    },
    "tendoOnboardingStartFor5Minutes": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start for 5 minutes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia per 5 minuti"
          }
        }
      }
    },
    "tendoOnboardingStartSmallFocusGently": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start small. Focus gently."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia in piccolo. Concentrati con calma."
          }
        }
      }
    },
    "tendoOnboardingStartWith5MinutesChooseAGentle155Or": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, choose Soft ambient or Gentle rain, or use optional pink, white, or brown noise. If other audio starts, Tendo sound steps aside."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con 5 minuti, scegli un ritmo delicato 15 / 5 o il classico 25 / 5 e fai una pausa quando serve. Tieni d'occhio la sessione con le attività in tempo reale e Apple Watch. L'Ambiente di concentrazione è silenzioso per impostazione predefinita: mantieni il tuo audio, scegli Sottofondo delicato o Pioggia delicata oppure usa il rumore rosa, bianco o marrone facoltativo. Se inizia altro audio, il suono di Tendo si fa da parte."
          }
        }
      }
    },
    "tendoOnboardingStartWithOneRoutineOrganizeMoreWhenYouNeedIt": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one routine. Organize more only when your routine library grows."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con una routine. Organizza di più solo quando la raccolta cresce."
          }
        }
      }
    },
