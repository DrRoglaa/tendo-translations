    },
    "tendoCommonTendoCouldntRestoreThisBackupYourExistingDataWasKept": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't restore this backup. Your existing data was kept."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo non ha potuto ripristinare questo backup. I dati esistenti sono stati conservati."
          }
        }
      }
    },
    "tendoCommonTendoReadsIncompleteRemindersDueTodayOrEarlierMarkingOne": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo reads incomplete reminders due today or earlier. Marking one done in Tendo completes the original Apple Reminder. Disconnecting never deletes reminders."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo legge i promemoria non completati con scadenza oggi o precedente. Se ne completi uno in Tendo, viene completato anche il promemoria Apple originale. Disconnettere non elimina mai i promemoria."
          }
        }
      }
    },
    "tendoCommonTendoTasksAlreadyPlaced": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
