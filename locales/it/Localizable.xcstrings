    "tendoSettingsBackupFromTasksRoutinesFocusSessionsRestoringReplacesTheTendo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup from %1$(date)@: %2$(tasks)lld tasks, %3$(routines)lld routines, %4$(focusSessions)lld focus sessions. Restoring replaces the Tendo-owned data currently on this device. Calendar and Reminders are not changed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup del %1$(date)@: %2$(tasks)lld attività, %3$(routines)lld routine, %4$(focusSessions)lld sessioni di concentrazione. Il ripristino sostituisce i dati di Tendo attualmente su questo dispositivo. Calendario e Promemoria non vengono modificati."
          }
        }
      }
    },
