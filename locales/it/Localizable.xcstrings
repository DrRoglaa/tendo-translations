    "tendoCommonWhatFitsNow": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Fits Now"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa fare adesso"
          }
        }
      }
    },
    "tendoCommonWhatFitsNowCanSuggestABestFitAQuick": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Fits Now can suggest a best fit, a quick win, and a stretch option. Rescue Mode helps when you know the task but feel stuck. Lock Screen actions can jump you straight in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa fare adesso può suggerire l'opzione più adatta, un risultato rapido e un'opzione più impegnativa. La modalità Aiuto serve quando conosci l'attività ma senti un blocco. Le azioni della schermata di blocco ti portano direttamente al punto."
          }
        }
      }
    },
    "tendoCommonWhatFitsNowInApplicationname": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What fits now in \\(.applicationName)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa fare adesso in \\(.applicationName)"
          }
        }
      }
    },
    "tendoCommonWhen": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
