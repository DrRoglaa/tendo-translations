    "tendoSettingsYouCanPauseOrStopWheneverYouNeedToThe": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pause or stop whenever you need to. The time you already focused still counts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi mettere in pausa o fermarti quando serve. Il tempo già dedicato alla concentrazione conta comunque."
          }
        }
      }
    },
    "tendoSettingsYourOptionalPreferredNameIsStoredLocallyByTendoAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your optional preferred name is stored locally by Tendo and is used only to personalize greetings inside the app. It is included only when you choose to create an encrypted local Tendo backup. Tendo does not read your Contacts or Apple Account to obtain your name."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo salva localmente il nome preferito facoltativo e lo usa solo per personalizzare i saluti nell'app. Viene incluso solo se scegli di creare un backup locale crittografato di Tendo. Tendo non legge Contatti o l'account Apple per ottenere il tuo nome."
          }
        }
      }
    },
    "tendoSettingsYourOptionalPreferredNameIsStoredOnlyByTendoAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your optional preferred name is stored only by Tendo and is used to personalize the greeting on Now. Leave it blank to keep the standard greeting."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome preferito facoltativo viene salvato solo da Tendo e serve a personalizzare il saluto in Adesso. Lascia il campo vuoto per mantenere il saluto standard."
          }
        }
      }
    },
    "tendoSettingsYourPasswordIsUsedOnlyOnThisDeviceToUnlock": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is used only on this device to unlock the selected backup and is never stored by Tendo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password viene usata solo su questo dispositivo per sbloccare il backup selezionato e non viene mai salvata da Tendo."
          }
        }
      }
    },
    "tendoSettingsYourTasksRoutinesFocusHistoryTinyStepsAndBrainDump": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, routines, focus history, Tiny Steps, and Brain Dump stay in Tendo’s private local app storage. Apple Watch sharing uses only compact snapshots and actions, not the full SwiftData database."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attività, routine, cronologia della concentrazione, Piccoli passi e Svuota la mente restano nell'archivio locale privato di Tendo. La condivisione con Apple Watch usa solo riepiloghi compatti e azioni, senza l'intero database SwiftData."
          }
        }
      }
    },
    "tendoSettingsYourTendoRecordsStayLocalUnlessYouExplicitlyExportAn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Tendo records stay local unless you explicitly export an encrypted backup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di Tendo restano locali, a meno che tu non esporti esplicitamente un backup crittografato."
          }
        }
      }
    },
