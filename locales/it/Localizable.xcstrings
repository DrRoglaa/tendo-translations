    },
    "tendoGuideProgressNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Progress to review your recent wins and Focus history."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Progressi per rivedere i tuoi risultati recenti e la cronologia di Concentrazione."
          }
        }
      }
    },
    "tendoGuideProgressSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look back on completed tasks, Focus sessions, and small wins without daily targets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riguarda attività completate, sessioni di Concentrazione e piccoli risultati senza obiettivi giornalieri."
          }
        }
      }
    },
    "tendoGuideProgressTitle": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
