    "tendoSettingsCreatesARealisticSyntheticWeekWith36MixedWorkAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, including follow-up nudge examples, Tiny Steps, three routines, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete Sample Data removes only records created here — your own data is left alone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una settimana sintetica realistica con 36 attività di lavoro e casa, esempi di suggerimenti successivi, Piccoli passi, tre routine, una cronologia varia di Concentrazione completata e interrotta e pensieri di Svuota la mente. Elimina dati di esempio rimuove solo i dati creati qui; i tuoi rimangono invariati."
          }
        }
      }
    },
    "tendoSettingsCreatesARealisticSyntheticWeekWithRoutineFolders": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, Tiny Steps, 16 routines organized into four folders, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete Sample Data removes only records created here — your own data is left alone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una settimana sintetica realistica con 36 attività di lavoro e casa, Piccoli passi, 16 routine organizzate in quattro cartelle, una cronologia varia di Concentrazione completata e interrotta e pensieri di Svuota la mente. Elimina dati di esempio rimuove solo i dati creati qui; i tuoi rimangono invariati."
          }
        }
      }
    },
