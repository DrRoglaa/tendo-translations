    "tendoGentlePermissionDetail": {
      "comment": "Gentle interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choices stay on this iPhone. All three reminders are off until you enable them. iOS Focus or Scheduled Summary may delay delivery."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scelte rimangono su questo iPhone. Tutti e tre i promemoria sono disattivati finché non li abiliti. Le modalità Full immersion o il riepilogo programmato di iOS possono ritardarne la consegna."
          }
        }
      }
    },
