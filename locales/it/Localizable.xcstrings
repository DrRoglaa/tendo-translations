    "tendoGuideTaskDetailsExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For “prepare presentation,” make the next tiny step “open the outline.”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per «preparare la presentazione», scegli come prossimo piccolo passo «aprire la scaletta»."
          }
        }
      }
    },
    "tendoGuideTaskDetailsNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a task to edit details or make a smaller start."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un'attività per modificarne i dettagli o rendere più semplice l'inizio."
          }
        }
      }
    },
    "tendoGuideTaskDetailsSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task can have notes, an icon, a next tiny step, timing, and follow-up actions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'attività può avere note, un'icona, un prossimo piccolo passo, orari e azioni successive."
          }
        }
      }
    },
    "tendoGuideTaskDetailsTitle": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
