    "tendoSettingsAppleControlsTheCalendarPermissionTendoReadsSelectedEventsFor": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple controls the Calendar permission. Tendo reads selected events for context and only writes a Calendar event when you explicitly confirm Block Time. Turning the integration off takes effect immediately."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gestisce l'autorizzazione al Calendario. Tendo legge gli eventi selezionati come contesto e scrive un evento solo quando confermi esplicitamente Blocca tempo. Disattivare l'integrazione ha effetto immediato."
          }
        }
      }
    },
    "tendoSettingsAppleControlsTheRemindersPermissionTendoIntegrationControlsWhetherTendo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple controls the Reminders permission. Tendo integration controls whether Tendo actually reads or completes reminders. Turning it off takes effect immediately."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gestisce l'autorizzazione a Promemoria. L'integrazione di Tendo determina se Tendo legge o completa effettivamente i promemoria. Disattivarla ha effetto immediato."
          }
        }
      }
    },
    "tendoSettingsAppleKeepsThisSiriPermissionInTheShortcutsAppSo": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple keeps this Siri permission in the Shortcuts app, so Tendo cannot move or duplicate the switch inside its own Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple mantiene questa autorizzazione di Siri nell'app Comandi Rapidi, quindi Tendo non può spostare o duplicare l'interruttore nelle proprie Impostazioni."
          }
        }
      }
    },
    "tendoSettingsAppleRemindersIntegrationIsOptionalTendoReadsIncompleteRemindersDue": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Reminders integration is optional. Tendo reads incomplete reminders due today or earlier from the lists you choose. If you mark one done in Tendo, that completion is saved back to Apple Reminders. Reminder contents are not copied into Tendo's SwiftData database."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'integrazione con Promemoria Apple è facoltativa. Tendo legge i promemoria non completati con scadenza oggi o precedente dagli elenchi che scegli. Se ne completi uno in Tendo, il completamento viene salvato in Promemoria Apple. Il contenuto dei promemoria non viene copiato nel database SwiftData di Tendo."
          }
        }
      }
    },
    "tendoSettingsAppleWatch": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
