    "tendoFocusStartWith5MinutesChooseAGentle155Or": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment can stay quiet, keep your own audio, or add optional local background noise. When you stop, Tendo can remember your next tiny step so returning later takes less effort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con 5 minuti, scegli un ritmo delicato 15 / 5 o il classico 25 / 5 e fai una pausa quando serve. Tieni d'occhio la sessione con le attività in tempo reale e Apple Watch. L'Ambiente di concentrazione può rimanere in silenzio, mantenere il tuo audio o aggiungere un rumore di fondo locale facoltativo. Quando ti fermi, Tendo può ricordare il prossimo piccolo passo per rendere più facile riprendere."
          }
        }
      }
    },
    "tendoFocusStartWith5MinutesChooseAGentle155OrVariant": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, choose Soft ambient, or use optional pink, white, or brown noise. If other audio starts, Tendo sound steps aside."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con 5 minuti, scegli un ritmo delicato 15 / 5 o il classico 25 / 5 e fai una pausa quando serve. Tieni d'occhio la sessione con le attività in tempo reale e Apple Watch. L'Ambiente di concentrazione è silenzioso per impostazione predefinita: mantieni il tuo audio, scegli Sottofondo delicato o usa il rumore rosa, bianco o marrone facoltativo. Se inizia altro audio, il suono di Tendo si fa da parte."
          }
        }
      }
    },
    "tendoFocusStartWith5MinutesChooseAGentle155OrVariant2": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. Focus Environment is silent by default: keep your current audio, or choose optional pink, white, or brown noise. If other audio starts, Tendo noise steps aside."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con 5 minuti, scegli un ritmo delicato 15 / 5 o il classico 25 / 5 e fai una pausa quando serve. Tieni d'occhio la sessione con le attività in tempo reale e Apple Watch. L'Ambiente di concentrazione è silenzioso per impostazione predefinita: mantieni il tuo audio o scegli il rumore rosa, bianco o marrone facoltativo. Se inizia altro audio, il rumore di Tendo si fa da parte."
          }
        }
      }
    },
