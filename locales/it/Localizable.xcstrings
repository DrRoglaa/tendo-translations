    "tendoCommonWhenYourHeadFeelsNoisyDumpItFirstYouCan": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your head feels noisy, dump it first. You can sort and refine things once the pressure is lower."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando hai troppi pensieri, inizia a svuotare la mente. Potrai riordinare e rifinire quando sentirai meno pressione."
          }
        }
      }
    },
    "tendoCommonWinMoments": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Momenti di soddisfazione"
          }
        }
      }
    },
    "tendoCommonWinMomentsAreLocalCompletionFeedbackTheyDoNotCreate": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments are local completion feedback. They do not create scores, streaks, profiles, or analytics, and nothing about a Win Moment is sent off-device."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Momenti di soddisfazione sono riscontri locali al completamento. Non creano punteggi, serie, profili o analisi e nessuna informazione su questi momenti viene inviata fuori dal dispositivo."
          }
        }
      }
    },
    "tendoCommonWinsToday": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(count)lld wins today"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(count)lld risultati oggi"
          }
        }
      }
    },
    "tendoCommonYouCanCreateAnotherTaskHereAtAnyTimeNew": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can create another task here at any time. New tasks are added automatically while there is room. Swipe left on an available task to delete the Tendo task."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi creare un'altra attività qui in qualsiasi momento. Le nuove attività vengono aggiunte automaticamente finché c'è spazio. Scorri a sinistra su un'attività disponibile per eliminare l'attività Tendo."
          }
        }
      }
    },
    "tendoCommonYouGaveSomeAttentionYouCanStopHere": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You gave %1$(taskTitle)@ some attention. You can stop here."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai dedicato attenzione a %1$(taskTitle)@. Puoi fermarti qui."
          }
        }
      }
    },
    "tendoCommonYouGaveThisYourAttentionThatMatters": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
