    },
    "tendoGuideFocusExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with five minutes to write the first paragraph, then decide what is next."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con cinque minuti per scrivere il primo paragrafo e poi decidi cosa fare."
          }
        }
      }
    },
    "tendoGuideFocusNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Start 5 in Now or adjust Focus defaults in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Inizia con 5 in Adesso o modifica le impostazioni di Concentrazione nelle Impostazioni."
          }
        }
      }
    },
