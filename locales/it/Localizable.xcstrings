          }
        }
      }
    },
    "tendoWhatsNew132SharingDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Apple language files can be shared for review, with checks that protect newer translations and saved Tendo data."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file di lingua Apple possono essere condivisi per la revisione. I controlli proteggono le traduzioni recenti e i dati Tendo salvati."
          }
        }
      }
    },
    "tendoWhatsNew132SharingTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translations made easier to improve"
