    "tendoGentleQuietHoursDetail": {
      "comment": "Gentle interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No gentle reminders are scheduled inside quiet hours. If a daily check-in falls in this window, choose a different time. Matching start and end times mean no quiet window."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vengono programmati promemoria delicati durante le ore di silenzio. Se un saluto quotidiano cade in questa fascia, scegli un altro orario. Orari di inizio e fine uguali indicano nessuna fascia di silenzio."
          }
        }
      }
    },
