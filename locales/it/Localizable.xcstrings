    "tendoGuideProgressExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A five-minute Focus session still counts as progress."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche una sessione di Concentrazione di cinque minuti è un progresso."
          }
