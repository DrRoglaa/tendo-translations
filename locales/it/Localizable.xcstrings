    "tendoSettingsTendoProvidesActionsToPauseResumeOrFinishTheCurrent": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo provides actions to pause, resume, or finish the current focus session from Shortcuts, Siri, Spotlight, and supported system surfaces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo offre azioni per mettere in pausa, riprendere o terminare la sessione di concentrazione attuale da Comandi Rapidi, Siri, Spotlight e interfacce di sistema supportate."
          }
        }
      }
    },
    "tendoSettingsTendoProvidesStart5WhatFitsNowImStuckAnd": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo provides Start 5, What Fits Now, I'm Stuck, and Focus controls through Shortcuts, Siri, Spotlight, and supported system surfaces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo offre Inizia con 5, Cosa fare adesso, Sono bloccato e i controlli di Concentrazione tramite Comandi Rapidi, Siri, Spotlight e interfacce di sistema supportate."
          }
        }
      }
    },
    "tendoSettingsTendoReminders": {
