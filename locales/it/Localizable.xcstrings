    "tendoGuideLiveActivitiesExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a Focus session, then check its progress without reopening the timer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una sessione di Concentrazione e controllane i progressi senza riaprire il timer."
          }
        }
      }
    },
    "tendoGuideLiveActivitiesNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Focus Live Activity options in Notifications & Reminders."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla le opzioni delle attività in tempo reale di Concentrazione in Notifiche e promemoria."
          }
        }
      }
    },
    "tendoGuideLiveActivitiesSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, an active Focus timer can appear on the Lock Screen and supported system surfaces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, un timer di Concentrazione attivo può apparire sulla schermata di blocco e nelle interfacce di sistema supportate."
          }
        }
      }
    },
