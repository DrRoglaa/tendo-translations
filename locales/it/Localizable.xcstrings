      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This resets your Progress and companion progress from this point forward. Your tasks, routines, focus sessions, brain dump items, and other Tendo data will not be deleted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azzera i tuoi progressi e quelli del compagno da questo momento. Attività, routine, sessioni di concentrazione, pensieri di Svuota la mente e altri dati di Tendo non verranno eliminati."
          }
        }
      }
    },
