    "tendoCommonStartWith5MinutesChooseAGentle155Or": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con 5 minuti, scegli un ritmo delicato 15 / 5 o il classico 25 / 5 e fai una pausa quando serve. Tieni d'occhio la sessione grazie alle attività in tempo reale e al supporto per Apple Watch."
          }
        }
      }
    },
    "tendoCommonStartWith5MinutesChooseAGentle155OrVariant": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with 5 minutes, choose a gentle 15 / 5 or a classic 25 / 5, pause when you need to, and keep your session visible with Live Activity and Apple Watch support. When you stop, Tendo can remember your next tiny step so returning later takes less effort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con 5 minuti, scegli un ritmo delicato 15 / 5 o il classico 25 / 5 e fai una pausa quando serve. Tieni d'occhio la sessione grazie alle attività in tempo reale e al supporto per Apple Watch. Quando ti fermi, Tendo può ricordare il prossimo piccolo passo per rendere più facile riprendere."
          }
        }
      }
    },
