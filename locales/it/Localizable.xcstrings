    "tendoOnboardingTodayPreviewShowingOneExactAppointmentAndOneFlexibleTask": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today preview showing one exact appointment and one flexible task"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima di Oggi con un appuntamento a un orario preciso e un'attività flessibile"
          }
        }
      }
    },
    "tendoOnboardingTodayShowsExactTimeAnchorsFlexibleWindowsAndWhatFits": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and What Fits Now. Find me a place can suggest a calm opening for a task, while Week helps you spread things out without treating every change like failure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi mostra impegni a orari precisi, fasce flessibili e Cosa fare adesso. Trovami uno spazio può suggerire un momento tranquillo per un'attività, mentre Settimana ti aiuta a distribuire le cose senza vivere ogni cambiamento come un fallimento."
          }
        }
      }
    },
    "tendoOnboardingTodayShowsExactTimeAnchorsFlexibleWindowsAndWhatIs": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today shows exact-time anchors, flexible windows, and what is still available — without turning a changed plan into failure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi mostra impegni a orari precisi, fasce flessibili e ciò che è ancora disponibile, senza trasformare un piano cambiato in un fallimento."
          }
        }
      }
    },
    "tendoOnboardingTue": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mar"
          }
        }
      }
    },
    "tendoOnboardingTurnOnOnlyWhatHelpsYouSoftAmbientAndGentle": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only what helps you. Soft ambient and Gentle rain are stored locally in Tendo, pink, white, and brown noise are generated on-device, backups are encrypted locally and never include Apple Calendar or Reminders data, and Tendo does not store listening history."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva solo ciò che ti aiuta. Sottofondo delicato e Pioggia delicata sono salvati localmente in Tendo; i rumori rosa, bianco e marrone sono generati sul dispositivo. I backup sono crittografati localmente e non includono mai dati di Calendario Apple o Promemoria. Tendo non memorizza la cronologia di ascolto."
          }
        }
      }
    },
    "tendoOnboardingUseBrainDumpWhenYourHeadFeelsNoisyOrYou": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Brain Dump when your head feels noisy or you are worried you will forget something."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Svuota la mente quando hai troppi pensieri o temi di dimenticare qualcosa."
          }
        }
      }
    },
    "tendoOnboardingUseNowWhenYouWantCalmGuidanceAClearNext": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Now when you want calm guidance, a clear next step, or a quick five-minute start."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Adesso per una guida tranquilla, un prossimo passo chiaro o un rapido inizio di cinque minuti."
          }
        }
      }
    },
    "tendoOnboardingUsePlanTodayForAGentleShortlistFindMeA": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Plan today for a gentle shortlist. Find me a place schedules only inside Tendo; Apple Calendar changes remain a separate, explicit action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Pianifica oggi per una breve lista senza pressione. Trovami uno spazio pianifica solo in Tendo; le modifiche a Calendario Apple restano un'azione separata ed esplicita."
          }
        }
      }
    },
