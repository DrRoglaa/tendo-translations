    "tendoFocusEnvironmentDefaultVolumeExplanation": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New installs start at %1$(text)@. This controls only Tendo's Focus Environment sound; your iPhone volume still controls the overall output. Tendo sound never starts automatically unless you turn this option on."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove installazioni partono da %1$(text)@. Questa impostazione controlla solo il suono dell'Ambiente di concentrazione di Tendo; il volume dell'iPhone controlla comunque l'uscita complessiva. Il suono di Tendo non si avvia mai automaticamente se non attivi questa opzione."
          }
        }
      }
    },
    "tendoFocusFinishActionTitle": {
      "comment": "Focus interface. Keep terminology consistent.",
