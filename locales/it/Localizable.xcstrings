    "tendoGuideTaskSchedulingExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a dentist appointment to an exact time, but leave shopping for the afternoon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissa l'appuntamento dal dentista a un orario preciso, ma lascia la spesa per il pomeriggio."
          }
        }
      }
    },
    "tendoGuideTaskSchedulingNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a task, edit its schedule, then check Today."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un'attività, modificane la pianificazione e poi controlla Oggi."
          }
        }
      }
    },
    "tendoGuideTaskSchedulingSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact times anchor the day; flexible windows leave space to choose when to act."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli orari precisi danno punti fermi alla giornata; le fasce flessibili ti lasciano scegliere quando agire."
          }
        }
      }
    },
    "tendoGuideTaskSchedulingTitle": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
