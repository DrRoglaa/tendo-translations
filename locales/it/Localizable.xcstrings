    "tendoGuideNowExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short reply can be your One Thing even when larger tasks are waiting."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una risposta breve può essere la tua Cosa importante anche quando aspettano attività più grandi."
          }
        }
      }
    },
    "tendoGuideNowNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Now and choose a small action to start."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Adesso e scegli una piccola azione per iniziare."
          }
        }
      }
    },
    "tendoGuideNowSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let Now suggest one manageable action from your current tasks instead of scanning everything at once."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che Adesso suggerisca un'azione gestibile tra le tue attività attuali, senza doverle scorrere tutte insieme."
          }
        }
      }
    },
