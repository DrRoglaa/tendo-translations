    "tendoSettingsTheseAreRemindersNotRulesTendoShouldMakeTheNext": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are reminders, not rules. Tendo should make the next action easier, not give you another system to maintain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono promemoria, non regole. Tendo dovrebbe rendere più facile la prossima azione, senza darti un altro sistema da mantenere."
          }
        }
      }
    },
    "tendoSettingsThisBackupCouldNotBeVerifiedTheFileMayBe": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup could not be verified. The file may be incomplete or damaged. Your current data has not been changed."
          }
        },
        "it": {
          "stringUnit": {
