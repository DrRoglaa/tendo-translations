    "tendoCommonCountsShowYourRealTendoRecordsOnThisDeviceDemo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts show your real Tendo records on this device. Demo data is not included."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I conteggi mostrano i tuoi dati Tendo reali su questo dispositivo. I dati demo non sono inclusi."
          }
        }
      }
    },
    "tendoCommonCreateRoutinesNoticeTodaysWinsAndReviewProgressOverTime": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create routines, notice Today's wins, and review progress over time. Win Moments can gently acknowledge meaningful starts and finishes without points or streak pressure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea routine, nota i successi di oggi e osserva i progressi nel tempo. I Momenti di successo riconoscono con delicatezza inizi e conclusioni importanti, senza punti né pressione delle serie."
          }
        }
      }
    },
    "tendoCommonCreateRoutinesTrackMomentumAndReviewProgressOverTimeSo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create routines, track momentum, and review progress over time so helpful patterns are easier to keep repeating."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea slancio con le routine e il monitoraggio dei progressi, così sarà più facile ripetere le buone abitudini."
          }
        }
      }
    },
    "tendoCommonCreatesARealisticSyntheticWeekWith36MixedWorkAnd": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a realistic synthetic week with 36 mixed work and home tasks, including follow-up nudge examples, Tiny Steps, three routines, varied completed and interrupted Focus history, and Brain Dump thoughts. Delete demo data removes only records created by this button — your own data is left alone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una settimana dimostrativa realistica con 36 attività di lavoro e casa, esempi di promemoria successivi, Piccoli passi, tre routine, sessioni di concentrazione completate o interrotte e pensieri raccolti. Eliminare i dati demo rimuove solo gli elementi creati da questo pulsante, senza toccare i tuoi dati."
          }
        }
      }
    },
