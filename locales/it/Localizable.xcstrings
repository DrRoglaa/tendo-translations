    "tendoSettingsTendoCanCreateAPasswordProtectedTendobackupFileTheBackup": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can create a password-protected .tendobackup file. The backup is created and encrypted locally, and it is verified and restored locally on this device. Tendo does not upload, receive, store, or have access to your backup files or backup passwords. Demo/test data, Calendar and Reminders data, system permissions, account information, caches, diagnostics, and transient state are not included. If you export a backup, you choose where the encrypted file is stored or shared using Apple's system interfaces. Tendo keeps only the dates of your last successful backup and restore locally for display in Settings. Tendo cannot recover a backup if the password is lost."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo può creare un file .tendobackup protetto da password. Il backup viene creato e crittografato localmente, verificato e ripristinato localmente su questo dispositivo. Tendo non carica, riceve o conserva i tuoi file di backup o le relative password e non vi ha accesso. Dati dimostrativi e di prova, dati di Calendario e Promemoria, autorizzazioni di sistema, informazioni dell'account, cache, diagnostica e stato temporaneo non sono inclusi. Se esporti un backup, scegli dove salvare o condividere il file crittografato tramite le interfacce di sistema Apple. Tendo conserva localmente solo le date dell'ultimo backup e ripristino riusciti per mostrarle nelle Impostazioni. Tendo non può recuperare un backup se perdi la password."
          }
        }
      }
    },
    "tendoSettingsTendoCanGentlyAcknowledgeACompletedTaskTinyStepFocus": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can gently acknowledge a completed task, Tiny Step, Focus, routine, or return after an interruption."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo può riconoscere con delicatezza il completamento di un'attività, un Piccolo passo, una sessione di Concentrazione, una routine o il ritorno dopo un'interruzione."
          }
        }
      }
    },
    "tendoSettingsTendoCannotRecoverThisPasswordIfYouForgetItThis": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
