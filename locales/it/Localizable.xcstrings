    "tendoCalendarCreatesASmallSampleDayTasksTinyStepsARoutine": {
      "comment": "Calendar interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a small sample day, tasks, Tiny Steps, a routine, a completed focus session, and a Brain Dump item. Delete demo data removes only records created by this button — your own data is left alone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una giornata di esempio con attività, piccoli passi, una routine, una sessione di concentrazione completata e un pensiero. Eliminando i dati demo verranno rimossi solo gli elementi creati da questo pulsante, senza toccare i tuoi dati."
          }
        }
      }
    },
