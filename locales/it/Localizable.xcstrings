    "tendoCommonTryStart5WhenYouKnowWhatToDoWhat": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Start 5 when you know what to do, What Fits Now when you need guidance, and I'm Stuck when the first step feels blocked."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Inizia con 5 quando sai cosa fare, Cosa fare adesso quando ti serve una guida e Sono bloccato quando il primo passo sembra difficile."
          }
        }
      }
    },
    "tendoCommonTurnOnOnlyTheIntegrationsThatHelpYouYouCan": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on only the integrations that help you. You can change everything later in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva solo le integrazioni che ti aiutano. Puoi cambiare tutto più tardi nelle Impostazioni."
          }
        }
      }
    },
    "tendoCommonTurningCalendarContextOffImmediatelyStopsTendoFromLoadingCalendar": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning Calendar Context off immediately stops Tendo from loading calendar events. Apple’s system permission is managed separately in iOS Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivando il contesto del calendario, Tendo smette subito di caricare gli eventi. L'autorizzazione di sistema Apple si gestisce separatamente nelle Impostazioni di iOS."
          }
        }
      }
    },
