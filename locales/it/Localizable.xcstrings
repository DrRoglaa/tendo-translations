    },
    "tendoFocusFiveMinutesStillCountsIfSoundHelpsFocusEnvironmentCan": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes still counts. If sound helps, Focus Environment can add pink, white, or brown noise without stopping your music or podcast. If you get interrupted, Pick Up Where You Left Off helps you return without rebuilding the whole plan in your head."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche cinque minuti contano. Se il suono ti aiuta, l'Ambiente di concentrazione può aggiungere rumore rosa, bianco o marrone senza interrompere musica o podcast. Se qualcosa ti interrompe, Riprendi da dove eri ti aiuta a tornare senza dover ricostruire tutto il piano nella tua testa."
          }
        }
      }
    },
    "tendoFocusFocusDurationSelectedminutesMinutes": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus duration, \\(selectedMinutes) minutes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durata della concentrazione, \\(selectedMinutes) minuti"
          }
        }
      }
    },
    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIoss": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated noise can step aside. If other audio begins, Tendo fades or stops its own noise and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Ambiente di concentrazione è facoltativo e gratuito. Tendo può usare il segnale generico di iOS che indica la presenza di altro audio per farsi da parte. Se inizia altro audio, Tendo sfuma o interrompe il proprio rumore e non lo riavvia automaticamente quando l'altro audio termina. Tendo non sa quale app, brano, podcast, audiolibro o video è in riproduzione e non memorizza né trasmette la cronologia di ascolto. I rumori rosa, bianco e marrone sono generati localmente e Tendo attiva la sessione audio solo mentre produce suono."
          }
        }
      }
    },
    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIossVariant": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated sound can step aside. If other audio begins, Tendo fades or stops its own sound and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Soft ambient and pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Ambiente di concentrazione è facoltativo e gratuito. Tendo può usare il segnale generico di iOS che indica la presenza di altro audio per farsi da parte. Se inizia altro audio, Tendo sfuma o interrompe il proprio suono e non lo riavvia automaticamente quando l'altro audio termina. Tendo non sa quale app, brano, podcast, audiolibro o video è in riproduzione e non memorizza né trasmette la cronologia di ascolto. Il sottofondo delicato e i rumori rosa, bianco e marrone sono generati localmente e Tendo attiva la sessione audio solo mentre produce suono."
          }
        }
      }
    },
    "tendoFocusFocusEnvironmentIsOptionalAndFreeTendoCanUseIossVariant2": {
      "comment": "Focus interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Environment is optional and free. Tendo can use iOS's generic signal that other audio is active so its own generated sound can step aside. If other audio begins, Tendo fades or stops its own sound and does not automatically restart it when the other audio ends. Tendo does not know which app, song, podcast, audiobook, or video is playing, and it does not store or transmit listening history. Soft ambient, Gentle rain, and pink, white, and brown noise are generated locally, and Tendo activates its audio session only while it is producing sound."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Ambiente di concentrazione è facoltativo e gratuito. Tendo può usare il segnale generico di iOS che indica la presenza di altro audio per farsi da parte. Se inizia altro audio, Tendo sfuma o interrompe il proprio suono e non lo riavvia automaticamente quando l'altro audio termina. Tendo non sa quale app, brano, podcast, audiolibro o video è in riproduzione e non memorizza né trasmette la cronologia di ascolto. Il sottofondo delicato, la pioggia delicata e i rumori rosa, bianco e marrone sono generati localmente e Tendo attiva la sessione audio solo mentre produce suono."
          }
        }
      }
    },
