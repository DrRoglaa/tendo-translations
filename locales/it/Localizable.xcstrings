      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calmer way to discover what Tendo can do."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modo più tranquillo di scoprire cosa può fare Tendo."
          }
        }
      }
    },
    "tendoWhatsNew131TipsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional contextual tips can be dismissed, turned off, or shown again whenever you choose."
          }
        },
        "it": {
          "stringUnit": {
