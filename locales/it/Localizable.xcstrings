    "tendoGuideTasksExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add “send the form” now; give it a time only when timing really matters."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi «invia il modulo» ora; assegna un orario solo se conta davvero."
          }
        }
      }
    },
    "tendoGuideTasksNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a task and open its details to choose the next action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un'attività e aprine i dettagli per scegliere la prossima azione."
          }
        }
      }
    },
    "tendoGuideTasksSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
