    "tendoSettingsWidgetsIntentionallyDoNotReadYourPrivateTaskDatabaseIn": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets intentionally do not read your private task database in the current version. They stay useful without requiring shared app-group storage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella versione attuale i widget, per scelta, non leggono il tuo database privato delle attività. Rimangono utili senza richiedere archiviazione condivisa nel gruppo di app."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndCompanion": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments & Companion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Momenti di soddisfazione e compagno"
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheCompanionStayQuietProgressStillReflects": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the companion stay quiet. Progress still reflects your real activity."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Momenti di soddisfazione e il compagno rimangono discreti. I progressi riflettono comunque la tua attività reale."
          }
        }
      }
    },
    "tendoSettingsWinMomentsAndTheOptionalMomentumCompanionAreLocalPresentation": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win Moments and the optional Momentum companion are local presentation features. Today's Wins and companion milestones are derived from your existing tasks, Tiny Steps, Focus history, and routines; Tendo does not create a separate XP, currency, streak, or analytics profile. Your companion choice is stored locally and changing it never changes your progress."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Momenti di soddisfazione e il compagno di Slancio facoltativo sono funzioni di presentazione locali. I Risultati di oggi e i traguardi del compagno derivano dalle tue attività, Piccoli passi, cronologia di Concentrazione e routine esistenti; Tendo non crea profili separati di punti esperienza, monete, serie o analisi. La scelta del compagno viene salvata localmente e cambiarla non modifica mai i progressi."
          }
        }
      }
    },
    "tendoSettingsWriteAReview": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a Review"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi una recensione"
          }
        }
      }
    },
    "tendoSettingsYesterday": {
      "comment": "Settings interface. Keep terminology consistent.",
      "extractionState": "manual",
      "localizations": {
