    "tendoCommonBackupsAreCreatedAndEncryptedLocallyVerifiedLocallyAndRestored": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups are created and encrypted locally, verified locally, and restored locally. They include your real Tendo data and supported preferences, but never demo/test data, Apple Calendar or Reminders data, permissions, accounts, caches, diagnostics, Watch transfer state, or Live Activity state. Tendo does not upload your backup or password to a server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup vengono creati, crittografati, verificati e ripristinati in locale. Contengono i tuoi veri dati Tendo e le preferenze supportate, ma mai dati demo o di test, dati di Calendario o Promemoria Apple, autorizzazioni, account, cache, diagnostica, stato di trasferimento di Watch o attività in tempo reale. Tendo non carica backup o password su un server."
          }
        }
      }
    },
