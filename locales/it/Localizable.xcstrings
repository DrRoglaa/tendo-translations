    "tendoMomentumTendoDerivesHomeGrowthFromYourRealTasksTinySteps": {
      "comment": "Momentum interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo derives home growth from your real tasks, Tiny Steps, Focus sessions, and routines. There is no XP, currency, daily quota, or streak to protect. Once a home detail appears, it stays. Demo data never changes your personal Companion Home."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo fa crescere la casa in base alle tue attività reali, ai Piccoli passi, alle sessioni di Concentrazione e alle routine. Non ci sono punti esperienza, monete, quote giornaliere o serie da proteggere. Quando appare un dettaglio della casa, rimane. I dati dimostrativi non cambiano mai la casa del tuo compagno personale."
          }
        }
      }
    },
    "tendoMomentumTendoDerivesHomeGrowthFromYourRealTasksTinyStepsVariant": {
      "comment": "Momentum interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo derives home growth from your real tasks, Tiny Steps, Focus sessions, and routines. There is no XP, currency, daily quota, or streak to protect. Once a home detail appears, it stays. Demo data never permanently unlocks home details."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo fa crescere la casa in base alle tue attività reali, ai Piccoli passi, alle sessioni di Concentrazione e alle routine. Non ci sono punti esperienza, monete, quote giornaliere o serie da proteggere. Quando appare un dettaglio della casa, rimane. I dati dimostrativi non sbloccano mai dettagli della casa in modo permanente."
          }
        }
      }
    },
    "tendoMomentumThatCounts": {
      "comment": "Momentum interface text. Review meaning, tone, and on-screen context.",
