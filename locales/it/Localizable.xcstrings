            "value": "Tendo considers busy time, exact Tendo tasks, your estimate, due date, energy, day load, and recent Focus history."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo considera il tempo occupato, le attività con orario preciso, la stima, la scadenza, le energie, il carico giornaliero e la cronologia recente di Concentrazione."
          }
        }
      }
    },
    "tendoTasksTendoLooksForAFewOpenWindowsAcrossTheNext": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo looks for a few open windows across the next three days. A Calendar event is created or moved only after you explicitly confirm one."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo cerca alcuni spazi liberi nei prossimi tre giorni. Un evento del Calendario viene creato o spostato solo dopo la tua conferma esplicita."
          }
        }
      }
    },
    "tendoTasksTendoLooksForRoomThatAlreadyExistsItUsesYour": {
      "comment": "Tasks interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo looks for room that already exists. It uses your Tendo plan and, if connected, Apple Calendar. Nothing is added to Apple Calendar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo cerca spazio già disponibile. Usa il tuo piano Tendo e, se connesso, Calendario Apple. Non aggiunge nulla a Calendario Apple."
          }
        }
      }
    },
    "tendoTasksTendoOnlyLooksAtYourSelectedCalendarsAfterYouChoose": {
