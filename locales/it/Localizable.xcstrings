    "tendoOnboardingCreateRoutinesNoticeTodaysWinsAndReviewProgressOverTime": {
      "comment": "Onboarding interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create routines, notice Today's Wins, and review progress over time. Choose Off, Subtle, or Companion Win Moments — without points, currency, or streak pressure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea routine, nota i Risultati di oggi e rivedi i progressi nel tempo. Scegli Momenti di soddisfazione disattivati, discreti o con compagno, senza punti, monete o pressione delle serie."
          }
        }
      }
    },
