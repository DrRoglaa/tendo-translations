    "tendoCommonDisconnectClearsTendosCalendarSelectionsAndStopsCalendarContextTo": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect clears Tendo’s calendar selections and stops Calendar Context. To revoke Apple’s permission completely, use Manage Calendar permission."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disconnessione cancella la scelta dei calendari di Tendo e interrompe il contesto del calendario. Per revocare del tutto l'autorizzazione Apple, usa Gestisci autorizzazione Calendario."
          }
        }
      }
    },
    "tendoCommonDisconnectStopsTendoFromUsingRemindersAndForgetsYourSelected": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect stops Tendo from using Reminders and forgets your selected lists. iOS may still show Full Access until you revoke the system permission in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnettendo Promemoria, Tendo smetterà di usarlo e dimenticherà gli elenchi scelti. iOS potrebbe continuare a mostrare l'accesso completo finché non revochi l'autorizzazione nelle Impostazioni."
          }
        }
      }
    },
    "tendoCommonDisconnectingStopsTendoFromReadingCalendarAndClearsItsCalendar": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting stops Tendo from reading Calendar and clears its calendar selections. iOS permission itself can only be revoked in System Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disconnessione impedisce a Tendo di leggere il Calendario e cancella le scelte. L'autorizzazione iOS si revoca solo dalle impostazioni di sistema."
          }
        }
      }
    },
