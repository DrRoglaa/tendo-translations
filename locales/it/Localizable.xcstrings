    "tendoSettingsTendoCalmFocusPlanner": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo: Calm Focus Planner"
