    "tendoGuideRescueExample": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a task that fits ten spare minutes or use I’m Stuck for a smaller step."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un'attività adatta a dieci minuti liberi o usa Sono bloccato per trovare un passo più piccolo."
          }
        }
      }
    },
    "tendoGuideRescueNextStep": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try What Fits Now from Today or I’m Stuck from Now."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Cosa fare adesso da Oggi oppure Sono bloccato da Adesso."
          }
        }
      }
    },
    "tendoGuideRescueSummary": {
      "comment": "Guide interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescue and What Fits Now help you find a workable next move when starting feels difficult."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuto e Cosa fare adesso ti aiutano a trovare una prossima mossa fattibile quando iniziare è difficile."
          }
        }
      }
    },
