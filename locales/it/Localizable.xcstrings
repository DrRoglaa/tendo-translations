    "tendoWhatsNewCalmerSettingsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings are now organized into focused pages, with clearer status and less scrolling."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Impostazioni sono ora organizzate in pagine dedicate, con stati più chiari e meno scorrimento."
          }
        }
      }
    },
    "tendoWhatsNewCalmerSettingsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calmer Settings experience"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni più tranquille"
          }
        }
      }
    },
    "tendoWhatsNewCalmerTendoDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks, Task details, Settings, and Focus Live Activities have been refined to feel cleaner and easier to scan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attività, dettagli delle attività, Impostazioni e attività in tempo reale di Concentrazione sono stati migliorati per risultare più puliti e facili da consultare."
          }
        }
      }
    },
    "tendoWhatsNewCalmerTendoTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calmer Tendo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Tendo più tranquillo"
          }
        }
      }
    },
    "tendoWhatsNewCarryForwardDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished tasks from an earlier day no longer have to become today’s backlog. Review them and choose what you actually want to carry forward."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività non completate di un giorno precedente non devono più diventare gli arretrati di oggi. Rivedile e scegli cosa vuoi davvero portare avanti."
          }
        }
      }
    },
    "tendoWhatsNewCarryForwardTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what comes with you"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli cosa portare con te"
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an optional morning reminder to start your day with intention, or an evening reflection to review your progress. Choose the times that suit you."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un promemoria mattutino facoltativo per iniziare la giornata con intenzione o una riflessione serale per rivedere i progressi. Scegli gli orari adatti a te."
          }
        }
      }
    },
    "tendoWhatsNewGentleCheckInsTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning Check-ins & Evening Reflections"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Saluti mattutini e riflessioni serali"
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityDetail": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a friendly nudge after 1, 3, or 7 days away from Tendo. Your inactivity countdown resets automatically when you return."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi un invito gentile dopo 1, 3 o 7 giorni lontano da Tendo. Il conto dell'inattività si azzera automaticamente al tuo ritorno."
          }
        }
      }
    },
    "tendoWhatsNewGentleInactivityTitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Inactivity Reminders"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria delicati dopo un'assenza"
          }
