    "tendoCommonTendoCanCreateAPasswordProtectedTendobackupFileTheBackup": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo can create a password-protected .tendobackup file. The backup is created and encrypted locally on this device. Tendo does not upload, receive, store, or have access to your backup files or backup passwords. Demo/test data, Calendar and Reminders data, system permissions, account information, caches, diagnostics, and transient state are not included. If you export a backup, you choose where the encrypted file is stored or shared using Apple's system interfaces. Tendo cannot recover a backup if the password is lost."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo può creare un file .tendobackup protetto da password. Il backup viene creato e crittografato localmente su questo dispositivo. Tendo non carica, riceve o conserva i tuoi file di backup o le relative password e non vi ha accesso. Dati dimostrativi e di prova, dati di Calendario e Promemoria, autorizzazioni di sistema, informazioni dell'account, cache, diagnostica e stato temporaneo non sono inclusi. Se esporti un backup, scegli dove salvare o condividere il file crittografato tramite le interfacce di sistema Apple. Tendo non può recuperare un backup se perdi la password."
          }
        }
      }
    },
    "tendoCommonTendoCouldntCompleteTheRestoreSafelyPleaseRestartTendoBefore": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't complete the restore safely. Please restart Tendo before making changes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo non ha potuto completare il ripristino in sicurezza. Riavvia Tendo prima di apportare modifiche."
          }
        }
      }
    },
    "tendoCommonTendoCouldntReadTheSelectedBackup": {
      "comment": "Common controls interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
