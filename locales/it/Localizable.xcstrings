    "tendoSettingsTendoWillImmediatelyStopLoadingCalendarEventsAndForgetWhich": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo will immediately stop loading calendar events and forget which calendars you selected. Your Apple Calendar data is not changed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo smetterà immediatamente di caricare gli eventi e dimenticherà i calendari selezionati. I dati di Calendario Apple non vengono modificati."
          }
        }
      }
    },
    "tendoSettingsTendoWillImmediatelyStopUsingRemindersAndForgetWhichLists": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo will immediately stop using reminders and forget which lists you selected. Apple's Full Access permission is changed separately in iOS Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo smetterà immediatamente di usare i promemoria e dimenticherà gli elenchi selezionati. L'autorizzazione di accesso completo di Apple si modifica separatamente nelle Impostazioni di iOS."
          }
        }
      }
    },
    "tendoSettingsTendoWithSiriAndShortcuts": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
