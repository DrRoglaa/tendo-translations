        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduzioni più facili da migliorare"
          }
        }
      }
    },
    "tendoWhatsNew132Subtitle": {
      "comment": "What's New interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language support is taking shape — translations and proofreading are still in progress."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il supporto multilingue sta prendendo forma: traduzioni e revisioni sono ancora in corso."
