    "tendoSettingsTendoCouldntUnlockThisBackupCheckThePasswordAndTry": {
      "comment": "Settings interface text. Review meaning, tone, and on-screen context.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo couldn't unlock this backup. Check the password and try again. If the password is correct, the file may be damaged. Your current data has not been changed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendo non ha potuto sbloccare questo backup. Controlla la password e riprova. Se la password è corretta, il file potrebbe essere danneggiato. I dati attuali non sono stati modificati."
          }
        }
      }
    },
